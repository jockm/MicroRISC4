; =============================================================================
; MiniRISC4 Assembler Listing
; ADDR    SOURCE LINE                                ; [HEX]
; =============================================================================
; ==============================================================================
; FILE: mr4src/asm/monitor.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Interactive Serial Memory Monitor for the MiniRISC4 Architecture.
;
; Commands:
;   e [<addr>]       - Examine 8 words starting at <addr> (or next 8 words if omitted)
;   c <addr> <val>   - Change word at <addr> to <val>
;   g <addr>         - Go / Execute code at <addr>
;
; Architecture & Memory Map:
;   - Direct Stride Vector Table: 0x0100 - 0x01FF (16 vectors * 16 words)
;   - Trap 0 (Reset Entry) at 0x0100 contains START_PROGRAM (<= 16 words)
;   - Application code & subroutines begin at 0x0200
; ==============================================================================

; ==============================================================================
; Architectural Control & MMIO Port Addresses (Low Memory 0x0000 - 0x000F)
; ==============================================================================
        .define FIFO_IN_ADDR    0x000A      ; Inter-core inbound stream FIFO (RO pop)
        .define FIFO_OUT_ADDR   0x000B      ; Inter-core outbound stream FIFO (WO push)
        .define MAILBOX_ADDR    0x000C      ; Cross-core trap trigger register (WO)
        .define CPUID_ADDR      0x000D      ; Hardware CPUID register (RO)
        .define UART_RX_ADDR    0x000E      ; Physical UART RX register
        .define UART_TX_ADDR    0x000F      ; Physical UART TX register

        .define TRAP_STRIDE     16          ; 16 words (32 bytes) per direct vector slot

; ------------------------------------------------------------------------------
; Multi-Core & Hardware Control Macros
; ------------------------------------------------------------------------------




; ==============================================================================
; Architectural MMIO Addresses (Optional / Parameterized)
; ==============================================================================
        .define CPUID_ADDR      0x000D      ; Hardware CPUID register (RO)
        .define UART_RX_ADDR    0x000E      ; Hardware UART RX register
        .define UART_TX_ADDR    0x000F      ; Hardware UART TX register

; ------------------------------------------------------------------------------
; MACRO: GET_CPUID dest_reg
; Reads the hardware core ID into dest_reg in 2 single-byte instructions (1 word).
; ------------------------------------------------------------------------------

; ==============================================================================
; Configurable Physical Memory Capacity
; Default: 64K words (0x10000). Override before including or via assembler CLI.
; ==============================================================================
            .define MEM_WORDS   0x10000
        .define MEM_TOP         (MEM_WORDS - 1)
        .define RSP_INIT        (MEM_WORDS - 0x0101)    ; Return Stack top
        .define ASP_INIT        (MEM_WORDS - 0x0501)    ; Argument Stack top

; ==============================================================================
; Architectural Traps and Vectors Configuration
; ==============================================================================
; TRAP_BASE is defined by the assembler (defaults to 0x0010)
        .define TRAP_RESET_ADDR (TRAP_BASE + 0)
        .define TRAP_FAULT_ADDR (TRAP_BASE + 15)

; ==============================================================================
; FILE: lib/common.inc
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Architectural Macro Definitions and System Abstractions.
;
; Table of Contents:
;   1. Program Entry & Stack Initialization (START_PROGRAM)
;   2. Core Register Manipulation & Arithmetic Macros (SWAP, LOAD16, LD0, NOT, NEG, XCHGALL)
;   3. System Scratchpad & Register Spilling (SAVEALL, LOADALL via 0x0000-0x0003)
;   4. Hardware Stack Engine (Full Descending: STPUSH, STPOP, RPUSH, RPOP, APUSH, APOP)
;   5. Register Spilling via Argument Stack (PUSHALL, POPALL via 0x0005)
;   6. Subroutine Linkage & Return (RCALL, RRET)
;   7. Byte Extraction and Modification (BYTE_GET_LO, BYTE_GET_HI, BYTE_SET_LO, BYTE_SET_HI)
;   8. Polled Serial UART Terminal I/O (PUTC, GETC via MMIO 0x000E / 0x000F)
; ==============================================================================

; ==============================================================================
; ==============================================================================
; MACRO: START_PROGRAM
; Description:
;   Standard program initialization macro executed at Trap 0 (Reset) entry (0x0100).
;   Initializes RSP, ASP, and jumps to _main.
;
; CRITICAL ARCHITECTURAL CONSTRAINT:
;   Under Direct Stride Vectoring (stride = 16 words), Trap 0 code occupies
;   addresses 0x0100 - 0x010F. Therefore, START_PROGRAM MUST NOT EXCEED
;   16 WORDS (32 bytes / 32 single-byte instruction slots). Any additional startup
;   logic must be placed after 0x0200 or inside _main.
; ==============================================================================
; Description:
;   Initializes the Return Stack Pointer (RSP at 0x0004) to 0xFEFF and the
;   Argument Stack Pointer (ASP at 0x0005) to 0xFAFF, then jumps directly
;   to the program entry point label _main via register-indirect branching.
; Inputs:
;   None (fixed entry target: _main).
; Outputs:
;   [0x0004] = 0xFEFF (Return stack initialized)
;   [0x0005] = 0xFAFF (Argument stack initialized)
; Side Effects:
;   Overwrites registers R0 and R1, then transfers control to _main.
; ==============================================================================


; ==============================================================================
; MACRO: SWAP
; Description:
;   Swaps the contents of two registers in-place using the three-step XOR algorithm.
; Inputs:
;   regA - First register (R0-R3)
;   regB - Second register (R0-R3)
; Outputs:
;   regA holds original regB; regB holds original regA.
; ==============================================================================


; ==============================================================================
; MACRO: LOAD16
; Description:
;   Loads a 16-bit constant or address label into a register using two sequential
;   PUSH8 operations (high byte followed by low byte).
; Inputs:
;   reg   - Destination register (R0-R3)
;   value - 16-bit literal, symbol, or label address
; Outputs:
;   reg = value
; ==============================================================================


; ==============================================================================
; MACRO: LD0
; Description:
;   Clears the specified register to 0x0000 in-place using XOR. Single-cycle execution.
; Inputs:
;   reg - Destination register (R0-R3)
; Outputs:
;   reg = 0x0000
; ==============================================================================


; ==============================================================================
; MACRO: NOT
; Description:
;   Performs bitwise NOT (one's complement) on a register in-place:
;     reg = ~reg (computed as reg ^ 0xFFFF).
; Inputs:
;   reg - Register to invert (R0-R3)
; Outputs:
;   reg inverted bitwise.
; ==============================================================================


; ==============================================================================
; MACRO: NEG
; Description:
;   Negates a register using two's complement arithmetic:
;     reg = -reg (computed as ~reg + 1).
; Inputs:
;   reg - Register to negate (R0-R3)
; Outputs:
;   reg = -reg
; ==============================================================================


; ==============================================================================
; MACRO: XCHGALL
; Description:
;   Exchanges all four primary registers (R0-R3) with their corresponding
;   hardware shadow counterparts (shadow_r[0]-shadow_r[3]).
; Inputs:
;   None
; Outputs:
;   R0-R3 hold previous shadow values; shadow registers hold previous R0-R3 values.
; ==============================================================================


; ==============================================================================
; MACRO: SAVEALL
; Description:
;   Saves R0-R3 to low scratchpad RAM addresses 0x0000-0x0003 in natural order:
;     [0x0000] = R0, [0x0001] = R1, [0x0002] = R2, [0x0003] = R3
; Inputs:
;   None (operates on current register file R0-R3)
; Outputs:
;   Memory locations 0x0000-0x0003 populated with register snapshots.
; ==============================================================================


; ==============================================================================
; MACRO: LOADALL
; Description:
;   Restores all four registers (R0-R3) from low scratchpad RAM addresses
;   0x0000-0x0003 via post-increment sequential loading.
; Inputs:
;   Memory locations 0x0000-0x0003 must contain valid saved register data.
; Outputs:
;   R0-R3 restored to the values read from memory.
; ==============================================================================


; ==============================================================================
; HARDWARE STACK ENGINE MACROS (Full Descending)
; ==============================================================================







; ==============================================================================
; MACRO: PUSHALL / POPALL
; Description:
;   Spills and restores all four general-purpose registers to/from the Argument Stack.
; ==============================================================================



; ==============================================================================
; SUBROUTINE LINKAGE MACROS (RCALL / RRET)
; ==============================================================================



; ==============================================================================
; BYTE EXTRACTION & MODIFICATION MACROS (Using Native AND)
; ==============================================================================





; ==============================================================================
; POLLED SERIAL UART TERMINAL I/O MACROS
; ==============================================================================


; ==============================================================================
; DIRECT STRIDE VECTOR TABLE (0x0100 - 0x01FF)
; 16 vectors, fixed 16-word stride (32 bytes per slot)
; Combinational hardware dispatch: PC <- 0x0100 + (vector << 4)
; ==============================================================================
        .org 0x0100

; --- Trap 0: Reset / Boot Entry (0x0100 - 0x010F: strictly <= 16 words) ---
        _reset_vector:
0100        ; 1. Initialize Return Stack Pointer (RSP) at [0x0004] = 0xFEFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        PUSH8   R1, >(RSP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        PUSH8   R1, <(RSP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        LD      R0, 4               ; R0 = 0x0004 (RSP scratchpad address) ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        LD      (R0), R1            ; [0x0004] = 0xFEFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100                                               ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        ; 2. Initialize Argument Stack Pointer (ASP) at [0x0005] = 0xFAFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        PUSH8   R1, >(ASP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        PUSH8   R1, <(ASP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        INC     R0                  ; R0 = 0x0005 (ASP scratchpad address) ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        LD      (R0), R1            ; [0x0005] = 0xFAFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100                                               ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        ; 3. Jump to the main function         ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        PUSH8   R0, >(_main)                   ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        PUSH8   R0, <(_main)                   ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]
0100        JMP     R0                  ; Unconditional register-indirect jump to _main ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 02 F8 00 F0]

; --- Trap 1 to Trap 14: Default Fast Returns ---
0108    .org 0x0110                 ; Trap 1: Inbound FIFO / Message Ready ; [00]
        _trap1_vector:
0110        JMP     R0                             ; [F0]

0110    .org 0x0120                 ; Trap 2: DMA / Burst Done ; [00]
        _trap2_vector:
0120        JMP     R0                             ; [F0]

0120    .org 0x0130                 ; Trap 3: Cache Miss ; [00]
        _trap3_vector:
0130        JMP     R0                             ; [F0]

0130    .org 0x0140                 ; Trap 4: Timer Strobe ; [00]
        _trap4_vector:
0140        JMP     R0                             ; [F0]

0140    .org 0x0150                 ; Trap 5       ; [00]
        _trap5_vector:
0150        JMP     R0                             ; [F0]

0150    .org 0x0160                 ; Trap 6       ; [00]
        _trap6_vector:
0160        JMP     R0                             ; [F0]

0160    .org 0x0170                 ; Trap 7       ; [00]
        _trap7_vector:
0170        JMP     R0                             ; [F0]

0170    .org 0x0180                 ; Trap 8       ; [00]
        _trap8_vector:
0180        JMP     R0                             ; [F0]

0180    .org 0x0190                 ; Trap 9       ; [00]
        _trap9_vector:
0190        JMP     R0                             ; [F0]

0190    .org 0x01A0                 ; Trap 10      ; [00]
        _trap10_vector:
01A0        JMP     R0                             ; [F0]

01A0    .org 0x01B0                 ; Trap 11      ; [00]
        _trap11_vector:
01B0        JMP     R0                             ; [F0]

01B0    .org 0x01C0                 ; Trap 12      ; [00]
        _trap12_vector:
01C0        JMP     R0                             ; [F0]

01C0    .org 0x01D0                 ; Trap 13      ; [00]
        _trap13_vector:
01D0        JMP     R0                             ; [F0]

01D0    .org 0x01E0                 ; Trap 14: Core Fault ; [00]
        _trap14_vector:
01E0        JMP     R0                             ; [F0]

; --- Trap 15: Hardware Alignment Violation / Illegal Instruction (0x01F0) ---
01E0    .org 0x01F0                                ; [00]
        _trap15_vector:
01F0        PUSH8   R0, >(_start_app)              ; [F8 02 F8 00]
01F0        PUSH8   R0, <(_start_app)              ; [F8 02 F8 00]
01F2        JMP     R0                             ; [F0]

; ==============================================================================
; SECTION 1: Monitor Application Entry & Initialization (0x0200)
; ==============================================================================
01F2    .org 0x0200                                ; [00]

        _main:
        _start_app:
0200        PUSH8   R1, >(msg_banner)              ; [F9 04 F9 91]
0200        PUSH8   R1, <(msg_banner)              ; [F9 04 F9 91]
0202        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
0202        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
0202        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

; ==============================================================================
; SECTION 2: Main Command Dispatch Loop
; ==============================================================================
        monitor_loop:
    ; Display prompt: "> "
0205        PUSH8   R1, >(msg_prompt)              ; [F9 04 F9 EF]
0205        PUSH8   R1, <(msg_prompt)              ; [F9 04 F9 EF]
0207        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
0207        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
0207        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

    ; Read interactive command line into line_buffer
020A        PUSH8   R1, >(line_buffer)             ; [F9 05 F9 3D]
020A        PUSH8   R1, <(line_buffer)             ; [F9 05 F9 3D]
020C        PUSH8   R0, >(read_line)               ; [F8 03 F8 A8 F4 00]
020C        PUSH8   R0, <(read_line)               ; [F8 03 F8 A8 F4 00]
020C        LINK    R0, R0                         ; [F8 03 F8 A8 F4 00]

    ; Skip leading spaces
020F        PUSH8   R3, >(line_buffer)             ; [FB 05 FB 3D]
020F        PUSH8   R3, <(line_buffer)             ; [FB 05 FB 3D]
0211        PUSH8   R0, >(skip_spaces)             ; [F8 04 F8 21 F4 00]
0211        PUSH8   R0, <(skip_spaces)             ; [F8 04 F8 21 F4 00]
0211        LINK    R0, R0                         ; [F8 04 F8 21 F4 00]

    ; Read command character from (R3++)
0214        LD      R1, (R3++)                     ; [47]
0214        LD      R1, R1                         ; [05 BC 00 F8 00 F8 FF A4 BC]
0214        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]
0214        PUSH8   R0, >(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
0214        PUSH8   R0, <(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
0214        AND     R1, R0                         ; [05 BC 00 F8 00 F8 FF A4 BC]
0214        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]

    ; Empty line check: if char == 0, loop
0219        XOR     R0, R0                         ; [90]
0219        SUB     R0, R1                         ; [71]
021A        PUSH8   R2, >(monitor_loop)            ; [FA 02 FA 05]
021A        PUSH8   R2, <(monitor_loop)            ; [FA 02 FA 05]
021C        JMP.Z   R2, R0                         ; [D8]

    ; Check 'e' / 'E' (Examine)
021C        PUSH8   R0, >(101)                     ; [00 F8 00 F8 65]
021C        PUSH8   R0, <(101)                     ; [00 F8 00 F8 65]
021F        SUB     R0, R1                         ; [71]
021F        PUSH8   R2, >(cmd_examine)             ; [00 FA 02 FA 6F]
021F        PUSH8   R2, <(cmd_examine)             ; [00 FA 02 FA 6F]
0222        JMP.Z   R2, R0                         ; [D8]
0222        PUSH8   R0, >(69)                      ; [00 F8 00 F8 45]
0222        PUSH8   R0, <(69)                      ; [00 F8 00 F8 45]
0225        SUB     R0, R1                         ; [71]
0225        PUSH8   R2, >(cmd_examine)             ; [00 FA 02 FA 6F]
0225        PUSH8   R2, <(cmd_examine)             ; [00 FA 02 FA 6F]
0228        JMP.Z   R2, R0                         ; [D8]

    ; Check 'c' / 'C' (Change)
0228        PUSH8   R0, >(99)                      ; [00 F8 00 F8 63]
0228        PUSH8   R0, <(99)                      ; [00 F8 00 F8 63]
022B        SUB     R0, R1                         ; [71]
022B        PUSH8   R2, >(cmd_change)              ; [00 FA 02 FA B9]
022B        PUSH8   R2, <(cmd_change)              ; [00 FA 02 FA B9]
022E        JMP.Z   R2, R0                         ; [D8]
022E        PUSH8   R0, >(67)                      ; [00 F8 00 F8 43]
022E        PUSH8   R0, <(67)                      ; [00 F8 00 F8 43]
0231        SUB     R0, R1                         ; [71]
0231        PUSH8   R2, >(cmd_change)              ; [00 FA 02 FA B9]
0231        PUSH8   R2, <(cmd_change)              ; [00 FA 02 FA B9]
0234        JMP.Z   R2, R0                         ; [D8]

    ; Check 'g' / 'G' (Go / Run)
0234        PUSH8   R0, >(103)                     ; [00 F8 00 F8 67]
0234        PUSH8   R0, <(103)                     ; [00 F8 00 F8 67]
0237        SUB     R0, R1                         ; [71]
0237        PUSH8   R2, >(cmd_go)                  ; [00 FA 02 FA 49]
0237        PUSH8   R2, <(cmd_go)                  ; [00 FA 02 FA 49]
023A        JMP.Z   R2, R0                         ; [D8]
023A        PUSH8   R0, >(71)                      ; [00 F8 00 F8 47]
023A        PUSH8   R0, <(71)                      ; [00 F8 00 F8 47]
023D        SUB     R0, R1                         ; [71]
023D        PUSH8   R2, >(cmd_go)                  ; [00 FA 02 FA 49]
023D        PUSH8   R2, <(cmd_go)                  ; [00 FA 02 FA 49]
0240        JMP.Z   R2, R0                         ; [D8]

    ; Unknown command error
0240        PUSH8   R1, >(msg_unknown)             ; [00 F9 04 F9 F3]
0240        PUSH8   R1, <(msg_unknown)             ; [00 F9 04 F9 F3]
0243        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
0243        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
0243        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]
0246        PUSH8   R2, >(monitor_loop)            ; [FA 02 FA 05]
0246        PUSH8   R2, <(monitor_loop)            ; [FA 02 FA 05]
0248        JMP     R2                             ; [F2]

; ==============================================================================
; SECTION 3: Command Implementations
; ==============================================================================

; ------------------------------------------------------------------------------
; COMMAND: 'g <addr>' (Go / Execute at target address)
; ------------------------------------------------------------------------------
0248    cmd_go:                                    ; [00]
0249        PUSH8   R0, >(skip_spaces)             ; [F8 04 F8 21 F4 00]
0249        PUSH8   R0, <(skip_spaces)             ; [F8 04 F8 21 F4 00]
0249        LINK    R0, R0                         ; [F8 04 F8 21 F4 00]
024C        PUSH8   R0, >(parse_hex)               ; [F8 04 F8 42 F4 00]
024C        PUSH8   R0, <(parse_hex)               ; [F8 04 F8 42 F4 00]
024C        LINK    R0, R0                         ; [F8 04 F8 42 F4 00]
024F        LD      R2, R1              ; R2 = target execution address ; [09]

024F        PUSH8   R1, >(msg_running)             ; [00 F9 05 F9 1E]
024F        PUSH8   R1, <(msg_running)             ; [00 F9 05 F9 1E]
0252        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
0252        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
0252        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

0255        LD      R1, R2                         ; [06]
0255        PUSH8   R0, >(print_hex16)             ; [00 F8 03 F8 3F F4 00]
0255        PUSH8   R0, <(print_hex16)             ; [00 F8 03 F8 3F F4 00]
0255        LINK    R0, R0                         ; [00 F8 03 F8 3F F4 00]

0259        PUSH8   R1, >(msg_run_tail)            ; [F9 05 F9 25]
0259        PUSH8   R1, <(msg_run_tail)            ; [F9 05 F9 25]
025B        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
025B        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
025B        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

025E        PUSH8   R0, >(.go_return)              ; [F8 02 F8 67]
025E        PUSH8   R0, <(.go_return)              ; [F8 02 F8 67]
0260        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0260        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0265        LINK    R2, R0              ; Call target ; [00 F6 00]

        .go_return:
0267        PUSH8   R1, >(msg_returned)            ; [F9 05 F9 29]
0267        PUSH8   R1, <(msg_returned)            ; [F9 05 F9 29]
0269        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
0269        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
0269        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]
026C        PUSH8   R2, >(monitor_loop)            ; [FA 02 FA 05]
026C        PUSH8   R2, <(monitor_loop)            ; [FA 02 FA 05]
026E        JMP     R2                             ; [F2]

; ------------------------------------------------------------------------------
; COMMAND: 'e [<addr>]' (Examine 8 Words)
; ------------------------------------------------------------------------------
026E    cmd_examine:                               ; [00]
026F        PUSH8   R0, >(skip_spaces)             ; [F8 04 F8 21 F4 00]
026F        PUSH8   R0, <(skip_spaces)             ; [F8 04 F8 21 F4 00]
026F        LINK    R0, R0                         ; [F8 04 F8 21 F4 00]

    ; Peek at next character in buffer at R3
0272        LD      R1, (R3)                       ; [27]
0272        LD      R1, R1                         ; [05 BC 00 F8 00 F8 FF A4 BC]
0272        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]
0272        PUSH8   R0, >(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
0272        PUSH8   R0, <(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
0272        AND     R1, R0                         ; [05 BC 00 F8 00 F8 FF A4 BC]
0272        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]

    ; Check if empty (null terminator == 0) -> continue from last address
0277        XOR     R0, R0                         ; [90]
0277        SUB     R0, R1                         ; [71]
0278        PUSH8   R2, >(.use_prev_addr)          ; [FA 02 FA 81]
0278        PUSH8   R2, <(.use_prev_addr)          ; [FA 02 FA 81]
027A        JMP.Z   R2, R0                         ; [D8]

    ; Address was typed -> parse it into R1
027A        PUSH8   R0, >(parse_hex)               ; [00 F8 04 F8 42 F4 00]
027A        PUSH8   R0, <(parse_hex)               ; [00 F8 04 F8 42 F4 00]
027A        LINK    R0, R0                         ; [00 F8 04 F8 42 F4 00]
027E        PUSH8   R2, >(.start_dump)             ; [FA 02 FA 84]
027E        PUSH8   R2, <(.start_dump)             ; [FA 02 FA 84]
0280        JMP     R2                             ; [F2]

0280    .use_prev_addr:                            ; [00]
0281        PUSH8   R2, >(dump_ptr)                ; [FA 05 FA 3B]
0281        PUSH8   R2, <(dump_ptr)                ; [FA 05 FA 3B]
0283        LD      R1, (R2)            ; Continue from where previous examine finished ; [26]

0283    .start_dump:                               ; [00]
    ; Store current dump pointer to memory
0284        PUSH8   R2, >(dump_ptr)                ; [FA 05 FA 3B]
0284        PUSH8   R2, <(dump_ptr)                ; [FA 05 FA 3B]
0286        LD      (R2), R1                       ; [39]

    ; Print address header ("0000: ")
0286        PUSH8   R0, >(print_hex16)             ; [00 F8 03 F8 3F F4 00]
0286        PUSH8   R0, <(print_hex16)             ; [00 F8 03 F8 3F F4 00]
0286        LINK    R0, R0                         ; [00 F8 03 F8 3F F4 00]
028A        PUSH8   R1, >(msg_colon)               ; [F9 04 F9 F1]
028A        PUSH8   R1, <(msg_colon)               ; [F9 04 F9 F1]
028C        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
028C        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
028C        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

    ; Initialize loop counter = 8 in memory
028F        PUSH8   R0, >(8)                       ; [F8 00 F8 08]
028F        PUSH8   R0, <(8)                       ; [F8 00 F8 08]
0291        PUSH8   R2, >(dump_cnt)                ; [FA 05 FA 3C]
0291        PUSH8   R2, <(dump_cnt)                ; [FA 05 FA 3C]
0293        LD      (R2), R0                       ; [38]

0293    .examine_loop:                             ; [00]
    ; 1. Fetch current pointer from memory and read the word
0294        PUSH8   R0, >(dump_ptr)                ; [F8 05 F8 3B]
0294        PUSH8   R0, <(dump_ptr)                ; [F8 05 F8 3B]
0296        LD      R2, (R0)            ; R2 = current memory address ; [28]
0296        LD      R1, (R2++)          ; R1 = word at address; R2 is incremented ; [46]

    ; 2. Immediately save advanced pointer back to memory
0297        LD      (R0), R2                       ; [32]

    ; 3. Print the word followed by a space
0297        PUSH8   R0, >(print_hex16)             ; [00 F8 03 F8 3F F4 00]
0297        PUSH8   R0, <(print_hex16)             ; [00 F8 03 F8 3F F4 00]
0297        LINK    R0, R0                         ; [00 F8 03 F8 3F F4 00]
029B        PUSH8   R1, >(32)                      ; [F9 00 F9 20]
029B        PUSH8   R1, <(32)                      ; [F9 00 F9 20]
029D        XCHG    R0                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        XCHG    R2                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        XCHG    R3                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D                                               ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D    ._PUTC_WAIT__M77:                          ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        LD      R2, (R0)                       ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        PUSH8   R3, >(._PUTC_SEND__M77)        ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        PUSH8   R3, <(._PUTC_SEND__M77)        ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        JMP.Z   R3, R2                         ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        PUSH8   R3, >(._PUTC_WAIT__M77)        ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        PUSH8   R3, <(._PUTC_WAIT__M77)        ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        JMP     R3                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D                                               ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D    ._PUTC_SEND__M77:                          ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        LD      (R0), R1                       ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        XCHG    R3                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        XCHG    R2                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]
029D        XCHG    R0                             ; [BC BE BF 1F 28 00 FB 02 FB A6 DE 00 FB 02 FB 9F F3 00 31 BF BE BC]

    ; 4. Decrement loop counter in memory
02A8        PUSH8   R0, >(dump_cnt)                ; [F8 05 F8 3C]
02A8        PUSH8   R0, <(dump_cnt)                ; [F8 05 F8 3C]
02AA        LD      R1, (R0)                       ; [24]
02AA        DEC     R1                             ; [CD]
02AB        LD      (R0), R1                       ; [31]

    ; 5. Check if counter == 0
02AB        XOR     R0, R0                         ; [90]
02AC        SUB     R0, R1                         ; [71]
02AC        PUSH8   R2, >(.examine_done)           ; [00 FA 02 FA B3]
02AC        PUSH8   R2, <(.examine_done)           ; [00 FA 02 FA B3]
02AF        JMP.Z   R2, R0                         ; [D8]

02AF        PUSH8   R2, >(.examine_loop)           ; [00 FA 02 FA 94]
02AF        PUSH8   R2, <(.examine_loop)           ; [00 FA 02 FA 94]
02B2        JMP     R2                             ; [F2]

02B2    .examine_done:                             ; [00]
02B3        PUSH8   R0, >(print_newline)           ; [F8 03 F8 19 F4 00]
02B3        PUSH8   R0, <(print_newline)           ; [F8 03 F8 19 F4 00]
02B3        LINK    R0, R0                         ; [F8 03 F8 19 F4 00]
02B6        PUSH8   R2, >(monitor_loop)            ; [FA 02 FA 05]
02B6        PUSH8   R2, <(monitor_loop)            ; [FA 02 FA 05]
02B8        JMP     R2                             ; [F2]

; ------------------------------------------------------------------------------
; COMMAND: 'c <addr> <val>' (Change Word)
; ------------------------------------------------------------------------------
02B8    cmd_change:                                ; [00]
02B9        PUSH8   R0, >(skip_spaces)             ; [F8 04 F8 21 F4 00]
02B9        PUSH8   R0, <(skip_spaces)             ; [F8 04 F8 21 F4 00]
02B9        LINK    R0, R0                         ; [F8 04 F8 21 F4 00]
02BC        PUSH8   R0, >(parse_hex)               ; [F8 04 F8 42 F4 00]
02BC        PUSH8   R0, <(parse_hex)               ; [F8 04 F8 42 F4 00]
02BC        LINK    R0, R0                         ; [F8 04 F8 42 F4 00]
02BF        LD      R2, R1              ; R2 = Address ; [09]

02BF        PUSH8   R0, >(skip_spaces)             ; [00 F8 04 F8 21 F4 00]
02BF        PUSH8   R0, <(skip_spaces)             ; [00 F8 04 F8 21 F4 00]
02BF        LINK    R0, R0                         ; [00 F8 04 F8 21 F4 00]
02C3        XCHG    R2                  ; shadow_r[2] = Address ; [BE]
02C3        PUSH8   R0, >(parse_hex)               ; [00 F8 04 F8 42 F4 00]
02C3        PUSH8   R0, <(parse_hex)               ; [00 F8 04 F8 42 F4 00]
02C3        LINK    R0, R0                         ; [00 F8 04 F8 42 F4 00]
02C7        XCHG    R2                  ; R2 = Address restored, shadow_r[2] = Value ; [BE]

02C7        LD      (R2), R1            ; [Address] = Value ; [39]

02C8        PUSH8   R1, >(msg_wrote)               ; [F9 05 F9 15]
02C8        PUSH8   R1, <(msg_wrote)               ; [F9 05 F9 15]
02CA        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
02CA        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
02CA        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

02CD        XCHG    R2                  ; R2 = Value, shadow_r[2] = Address ; [BE]
02CD        LD      R1, R2                         ; [06]
02CE        PUSH8   R0, >(print_hex16)             ; [F8 03 F8 3F F4 00]
02CE        PUSH8   R0, <(print_hex16)             ; [F8 03 F8 3F F4 00]
02CE        LINK    R0, R0                         ; [F8 03 F8 3F F4 00]

02D1        PUSH8   R1, >(msg_to)                  ; [F9 05 F9 19]
02D1        PUSH8   R1, <(msg_to)                  ; [F9 05 F9 19]
02D3        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
02D3        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
02D3        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

02D6        XCHG    R2                  ; R2 = Address, shadow_r[2] = Value ; [BE]
02D6        LD      R1, R2                         ; [06]
02D7        PUSH8   R0, >(print_hex16)             ; [F8 03 F8 3F F4 00]
02D7        PUSH8   R0, <(print_hex16)             ; [F8 03 F8 3F F4 00]
02D7        LINK    R0, R0                         ; [F8 03 F8 3F F4 00]

02DA        PUSH8   R1, >(msg_bracket_nl)          ; [F9 05 F9 1C]
02DA        PUSH8   R1, <(msg_bracket_nl)          ; [F9 05 F9 1C]
02DC        PUSH8   R0, >(puts)                    ; [F8 02 F8 E2 F4 00]
02DC        PUSH8   R0, <(puts)                    ; [F8 02 F8 E2 F4 00]
02DC        LINK    R0, R0                         ; [F8 02 F8 E2 F4 00]

02DF        PUSH8   R2, >(monitor_loop)            ; [FA 02 FA 05]
02DF        PUSH8   R2, <(monitor_loop)            ; [FA 02 FA 05]
02E1        JMP     R2                             ; [F2]

; ==============================================================================
; SECTION 4: String & Formatting Subroutines
; ==============================================================================

; ------------------------------------------------------------------------------
; SUBROUTINE: puts
; Inputs: R1 = Pointer to null-terminated .asciz string
; ------------------------------------------------------------------------------
02E1    puts:                                      ; [00]
02E2        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E2        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02E7        LD      R2, R1                         ; [09]

        .puts_word_loop:
02E8        LD      R3, (R2++)                     ; [4E]

    ; Slot 0 (Low Byte)
02E8        LD      R1, R3                         ; [07 BC 00 F8 00 F8 FF A4 BC]
02E8        XCHG    R0                             ; [07 BC 00 F8 00 F8 FF A4 BC]
02E8        PUSH8   R0, >(0x00FF)                  ; [07 BC 00 F8 00 F8 FF A4 BC]
02E8        PUSH8   R0, <(0x00FF)                  ; [07 BC 00 F8 00 F8 FF A4 BC]
02E8        AND     R1, R0                         ; [07 BC 00 F8 00 F8 FF A4 BC]
02E8        XCHG    R0                             ; [07 BC 00 F8 00 F8 FF A4 BC]
02ED        XOR     R0, R0                         ; [90]
02ED        SUB     R0, R1                         ; [71]
02EE        PUSH8   R0, >(.puts_done)              ; [F8 03 F8 13]
02EE        PUSH8   R0, <(.puts_done)              ; [F8 03 F8 13]
02F0        JMP.Z   R0, R1                         ; [D1]
02F0        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0                                               ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0    ._PUTC_WAIT__M113:                         ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        LD      R2, (R0)                       ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        PUSH8   R3, >(._PUTC_SEND__M113)       ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        PUSH8   R3, <(._PUTC_SEND__M113)       ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        JMP.Z   R3, R2                         ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        PUSH8   R3, >(._PUTC_WAIT__M113)       ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        PUSH8   R3, <(._PUTC_WAIT__M113)       ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        JMP     R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0                                               ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0    ._PUTC_SEND__M113:                         ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        LD      (R0), R1                       ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]
02F0        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 02 FB FA DE 00 FB 02 FB F3 F3 00 31 BF BE BC]

    ; Slot 1 (High Byte)
02FC        LD      R1, R3                         ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
02FC        SHIFT.R R1                             ; [07 B5 B5 B5 B5 B5 B5 B5 B5]
0300        XOR     R0, R0                         ; [90]
0301        SUB     R0, R1                         ; [71]
0301        PUSH8   R0, >(.puts_done)              ; [00 F8 03 F8 13]
0301        PUSH8   R0, <(.puts_done)              ; [00 F8 03 F8 13]
0304        JMP.Z   R0, R1                         ; [D1]
0304        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304                                               ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304    ._PUTC_WAIT__M118:                         ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        LD      R2, (R0)                       ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        PUSH8   R3, >(._PUTC_SEND__M118)       ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        PUSH8   R3, <(._PUTC_SEND__M118)       ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        JMP.Z   R3, R2                         ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        PUSH8   R3, >(._PUTC_WAIT__M118)       ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        PUSH8   R3, <(._PUTC_WAIT__M118)       ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        JMP     R3                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304                                               ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304    ._PUTC_SEND__M118:                         ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        LD      (R0), R1                       ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]
0304        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 03 FB 0E DE 00 FB 03 FB 07 F3 00 31 BF BE BC]

0310        PUSH8   R0, >(.puts_word_loop)         ; [F8 02 F8 E8]
0310        PUSH8   R0, <(.puts_word_loop)         ; [F8 02 F8 E8]
0312        JMP     R0                             ; [F0]

0312    .puts_done:                                ; [00]
0313        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0313        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ------------------------------------------------------------------------------
; SUBROUTINE: print_newline
; ------------------------------------------------------------------------------
        print_newline:
0319        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0319        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
031E        PUSH8   R1, >(13)                      ; [00 F9 00 F9 0D]
031E        PUSH8   R1, <(13)                      ; [00 F9 00 F9 0D]
0321        XCHG    R0                             ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321        XCHG    R2                             ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321        XCHG    R3                             ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321                                               ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321    ._PUTC_WAIT__M128:                         ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321        LD      R2, (R0)                       ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
0321        PUSH8   R3, >(._PUTC_SEND__M128)       ; [BC BE BF 1F 28 00 FB 03 FB 2A DE 00 FB 03 FB 23 F3 00 31 BF BE BC]
