04FE    msg_unknown:                               ; [00]
04FF        .asciz "Unknown command. Use 'e <addr>', 'c <addr> <val>', or 'g <addr>'\r\n" ; [55 6E 6B 6E 6F 77 6E 20 63 6F 6D 6D 61 6E 64 2E 20 55 73 65 20 27 65 20 3C 61 64 64 72 3E 27 2C 20 27 63 20 3C 61 64 64 72 3E 20 3C 76 61 6C 3E 27 2C 20 6F 72 20 27 67 20 3C 61 64 64 72 3E 27 0D 0A 00]

0520    msg_wrote:                                 ; [00]
0521        .asciz "Wrote "                        ; [57 72 6F 74 65 20 00]

0524    msg_to:                                    ; [00]
