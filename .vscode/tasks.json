{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Compile ACT4 Monitor",
        "type": "shell",
        "command": "python3 tools/act4c.py mr4src/act4/monitor.a4 -o mr4src/act4/monitor.asm",
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Assemble ASM Monitor",
        "type": "shell",
        "command": "python3 tools/mr4asm.py -I lib -l mr4src/asm/monitor.lst mr4src/asm/monitor.asm",
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Assemble ACT4 Monitor",
        "type": "shell",
        "command": "python3 tools/mr4asm.py -I lib -l mr4src/act4/monitor.lst mr4src/act4/monitor.asm",
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "ROHD: Fetch Dependencies (pub get)",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder}/hdl/rohd" },
        "command": "dart pub get",
        "problemMatcher": []
      },
      {
        "label": "ROHD: Generate SystemVerilog",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder}/hdl/rohd" },
        "command": "dart run bin/generate.dart",
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Verilog: Run Testbenches (iverilog)",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder}/hdl/verilog" },
        "command": "make test",
        "group": "test",
        "problemMatcher": []
      }
    ]
  }