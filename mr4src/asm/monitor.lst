; SUBROUTINE: print_hex16
; Inputs: R1 = 16-bit word to print
; ------------------------------------------------------------------------------
        print_hex16:
0248        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0248        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
024D        XCHG    R2                  ; Preserve caller R2 in shadow register ; [BE]
024E        LD      R2, R1              ; R2 = 16-bit word ; [09]

    ; Nibble 3 [15:12]
024E        LD      R1, R2                         ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
024E        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0253        SHIFT.R R1                             ; [B5]
0253        SHIFT.R R1                             ; [B5]
0254        SHIFT.R R1                             ; [B5]
0254        SHIFT.R R1                             ; [B5]
0255        PUSH8   R0, >(print_nibble)            ; [F8 02 F8 7D F4 00]
0255        PUSH8   R0, <(print_nibble)            ; [F8 02 F8 7D F4 00]
0255        LINK    R0, R0                         ; [F8 02 F8 7D F4 00]

    ; Nibble 2 [11:8]
0258        LD      R1, R2                         ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
0258        SHIFT.R R1                             ; [06 B5 B5 B5 B5 B5 B5 B5 B5]
025C        PUSH8   R0, >(0x000F)                  ; [00 F8 00 F8 0F]
025C        PUSH8   R0, <(0x000F)                  ; [00 F8 00 F8 0F]
025F        AND     R1, R0                         ; [A4]
025F        PUSH8   R0, >(print_nibble)            ; [00 F8 02 F8 7D F4 00]
025F        PUSH8   R0, <(print_nibble)            ; [00 F8 02 F8 7D F4 00]
025F        LINK    R0, R0                         ; [00 F8 02 F8 7D F4 00]

    ; Nibble 1 [7:4]
0263        LD      R1, R2                         ; [06 BC F8 00 F8 FF A4 BC]
0263        XCHG    R0                             ; [06 BC F8 00 F8 FF A4 BC]
0263        PUSH8   R0, >(0x00FF)                  ; [06 BC F8 00 F8 FF A4 BC]
0263        PUSH8   R0, <(0x00FF)                  ; [06 BC F8 00 F8 FF A4 BC]
0263        AND     R1, R0                         ; [06 BC F8 00 F8 FF A4 BC]
0263        XCHG    R0                             ; [06 BC F8 00 F8 FF A4 BC]
0267        SHIFT.R R1                             ; [B5]
0267        SHIFT.R R1                             ; [B5]
0268        SHIFT.R R1                             ; [B5]
0268        SHIFT.R R1                             ; [B5]
0269        PUSH8   R0, >(print_nibble)            ; [F8 02 F8 7D F4 00]
0269        PUSH8   R0, <(print_nibble)            ; [F8 02 F8 7D F4 00]
0269        LINK    R0, R0                         ; [F8 02 F8 7D F4 00]

    ; Nibble 0 [3:0]
026C        LD      R1, R2                         ; [06 BC F8 00 F8 FF A4 BC]
026C        XCHG    R0                             ; [06 BC F8 00 F8 FF A4 BC]
026C        PUSH8   R0, >(0x00FF)                  ; [06 BC F8 00 F8 FF A4 BC]
026C        PUSH8   R0, <(0x00FF)                  ; [06 BC F8 00 F8 FF A4 BC]
026C        AND     R1, R0                         ; [06 BC F8 00 F8 FF A4 BC]
026C        XCHG    R0                             ; [06 BC F8 00 F8 FF A4 BC]
0270        PUSH8   R0, >(0x000F)                  ; [F8 00 F8 0F]
0270        PUSH8   R0, <(0x000F)                  ; [F8 00 F8 0F]
0272        AND     R1, R0                         ; [A4]
0272        PUSH8   R0, >(print_nibble)            ; [00 F8 02 F8 7D F4 00]
0272        PUSH8   R0, <(print_nibble)            ; [00 F8 02 F8 7D F4 00]
0272        LINK    R0, R0                         ; [00 F8 02 F8 7D F4 00]

0276        XCHG    R2                  ; Restore caller R2 ; [BE]
0276        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0276        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ------------------------------------------------------------------------------
; SUBROUTINE: print_nibble
; Inputs: R1 = Nibble value (0-15)
; ------------------------------------------------------------------------------
027C    print_nibble:                              ; [00]
027D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
027D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; R0 = 9 - R1 (negative if R1 >= 10, i.e. 'A'-'F')
0282        PUSH8   R0, >(9)                       ; [00 F8 00 F8 09]
0282        PUSH8   R0, <(9)                       ; [00 F8 00 F8 09]
0285        SUB     R0, R1                         ; [71]
0285        PUSH8   R3, >(.hex_letter)             ; [00 FB 02 FB 9D]
0285        PUSH8   R3, <(.hex_letter)             ; [00 FB 02 FB 9D]
0288        JMP.M   R3, R0              ; Jump directly on negative result ; [EC]

    ; Digit '0'-'9': ASCII = R1 + 48
0288        PUSH8   R0, >(48)                      ; [00 F8 00 F8 30]
0288        PUSH8   R0, <(48)                      ; [00 F8 00 F8 30]
028B        ADD     R1, R0                         ; [64]
028B        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B                                               ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B    ._PUTC_WAIT__M163:                         ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        LD      R2, (R0)                       ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        PUSH8   R3, >(._PUTC_SEND__M163)       ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        PUSH8   R3, <(._PUTC_SEND__M163)       ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        JMP.Z   R3, R2                         ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        PUSH8   R3, >(._PUTC_WAIT__M163)       ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        PUSH8   R3, <(._PUTC_WAIT__M163)       ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        JMP     R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B                                               ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B    ._PUTC_SEND__M163:                         ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        LD      (R0), R1                       ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
028B        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 02 FB 95 DE 00 FB 02 FB 8E F3 00 31 BF BE BC]
0297        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0297        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        .hex_letter:
    ; Digit 'A'-'F': ASCII = R1 + 55
029D        PUSH8   R0, >(55)                      ; [F8 00 F8 37]
029D        PUSH8   R0, <(55)                      ; [F8 00 F8 37]
029F        ADD     R1, R0                         ; [64]
029F        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F                                               ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F    ._PUTC_WAIT__M170:                         ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        LD      R2, (R0)                       ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        PUSH8   R3, >(._PUTC_SEND__M170)       ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        PUSH8   R3, <(._PUTC_SEND__M170)       ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        JMP.Z   R3, R2                         ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        PUSH8   R3, >(._PUTC_WAIT__M170)       ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        PUSH8   R3, <(._PUTC_WAIT__M170)       ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        JMP     R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F                                               ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F    ._PUTC_SEND__M170:                         ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        LD      (R0), R1                       ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        XCHG    R3                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        XCHG    R2                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
029F        XCHG    R0                             ; [BC BE BF 1F 00 28 00 FB 02 FB A9 DE 00 FB 02 FB A2 F3 00 31 BF BE BC]
02AB        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
02AB        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SECTION 5: Terminal Line Input & Space Skipping
; ==============================================================================

; ------------------------------------------------------------------------------
; SUBROUTINE: read_line
; Inputs: R1 = Buffer pointer
; ------------------------------------------------------------------------------
        read_line:
02B1        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B1        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
02B6        LD      R2, R1              ; R2 = Buffer write pointer ; [09]
02B7        PUSH8   R3, >(0)                       ; [FB 00 FB 00]
02B7        PUSH8   R3, <(0)                       ; [FB 00 FB 00]

        .read_char:
02B9        XCHG    R0                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        XCHG    R2                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        LD      R0, 14              ; UART RX MMIO (0x000E) ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9                                               ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9    ._GETC_WAIT__M179:                         ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        LD      R1, (R0)                       ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        PUSH8   R2, >(._GETC_DONE__M179)       ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        PUSH8   R2, <(._GETC_DONE__M179)       ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        JMP.M   R2, R1                         ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        PUSH8   R2, >(._GETC_WAIT__M179)       ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        PUSH8   R2, <(._GETC_WAIT__M179)       ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        JMP     R2                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9                                               ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9    ._GETC_DONE__M179:                         ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        LD      R1, R1                         ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        XCHG    R0                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        PUSH8   R0, >(0x00FF)                  ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        PUSH8   R0, <(0x00FF)                  ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        AND     R1, R0                         ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        XCHG    R0                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        XCHG    R2                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]
02B9        XCHG    R0                             ; [BC BE 1E 00 24 00 FA 02 FA C2 E9 00 FA 02 FA BB F2 00 05 BC F8 00 F8 FF A4 BC BE BC]

    ; Check Carriage Return (13)
02C7        PUSH8   R0, >(13)                      ; [F8 00 F8 0D]
02C7        PUSH8   R0, <(13)                      ; [F8 00 F8 0D]
02C9        SUB     R0, R1              ; R0 = 13 - R1 ; [71]
02C9        XCHG    R1                  ; shadow_r[1] = char, R1 is free for target ; [BD]
02CA        PUSH8   R1, >(.line_done)              ; [F9 03 F9 1F]
02CA        PUSH8   R1, <(.line_done)              ; [F9 03 F9 1F]
02CC        JMP.Z   R1, R0                         ; [D4]
02CC        XCHG    R1                  ; R1 = char restored ; [BD]

    ; Check Line Feed (10)
02CD        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
02CD        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
02CF        SUB     R0, R1              ; R0 = 10 - R1 ; [71]
02CF        XCHG    R1                  ; shadow_r[1] = char ; [BD]
02D0        PUSH8   R1, >(.line_done)              ; [F9 03 F9 1F]
02D0        PUSH8   R1, <(.line_done)              ; [F9 03 F9 1F]
02D2        JMP.Z   R1, R0                         ; [D4]
02D2        XCHG    R1                  ; R1 = char restored ; [BD]

    ; Check Backspace (8)
02D3        PUSH8   R0, >(8)                       ; [F8 00 F8 08]
02D3        PUSH8   R0, <(8)                       ; [F8 00 F8 08]
02D5        SUB     R0, R1                         ; [71]
02D5        XCHG    R1                             ; [BD]
02D6        PUSH8   R1, >(.handle_bs)              ; [F9 02 F9 EF]
02D6        PUSH8   R1, <(.handle_bs)              ; [F9 02 F9 EF]
02D8        JMP.Z   R1, R0                         ; [D4]
02D8        XCHG    R1                             ; [BD]

    ; Check Backspace / DEL (127)
02D9        PUSH8   R0, >(127)                     ; [F8 00 F8 7F]
