; ------------------------------------------------------------------------------
; SUBROUTINE: print_nibble
; Inputs: R1 = Nibble value (0-15)
; ------------------------------------------------------------------------------
0373    print_nibble:                              ; [00]
0374        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0374        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0374        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
