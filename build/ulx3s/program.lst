0421        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0421        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0421        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0421        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0421        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

