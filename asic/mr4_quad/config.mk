# ==============================================================================
# FILE: asic/mr4_quad/config.mk
# OpenROAD-flow-scripts (ORFS) Hierarchical 4-Tile Chip Assembly (`mr4_quad_top`)
#
# Assembles 4x identical pre-hardened `mr4_tile` macros (`u_tile_0..u_tile_3`)
# connected purely by registered point-to-point neighbor Lean Ring links so
# chip-level Fmax stays flat relative to a single hardened tile.
#
# Prerequisite:
#   make asic-tile-flow ASIC_PLATFORM=<platform>   (produces mr4_tile LEF/LIB/GDS)
# Run:
#   make asic-quad-flow ASIC_PLATFORM=<platform>
# ==============================================================================

MR4_QUAD_DIR  := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
MR4_REPO_ROOT := $(abspath $(MR4_QUAD_DIR)/../..)

export DESIGN_NICKNAME = mr4_quad_top
export DESIGN_NAME     = mr4_quad_top
export PLATFORM       ?= nangate45

export VERILOG_FILES   = $(MR4_REPO_ROOT)/build/asic_tile/mr4_quad_top.sv
export SDC_FILE        = $(MR4_QUAD_DIR)/constraint.sdc

# Pre-hardened `mr4_tile` abstract views generated by `make asic-tile-flow`
MR4_TILE_OUT ?= $(MR4_REPO_ROOT)/build/asic/orfs/results/$(PLATFORM)/mr4_tile/base
export ADDITIONAL_LEFS += $(MR4_TILE_OUT)/mr4_tile.lef
export ADDITIONAL_LIBS += $(MR4_TILE_OUT)/mr4_tile.lib
export ADDITIONAL_GDS  += $(MR4_TILE_OUT)/6_final.gds

# Hierarchical 2x2 macro floorplan with generous routing channels for neighbor ring links
export CORE_UTILIZATION  ?= 50
export CORE_ASPECT_RATIO ?= 1
export CORE_MARGIN       ?= 10

ifeq ($(PLATFORM),asap7)
  export CLOCK_PERIOD        ?= 2000
  export MACRO_PLACE_HALO    ?= 2 2
  export MACRO_PLACE_CHANNEL ?= 8 8
else ifeq ($(PLATFORM),sky130hd)
  export CLOCK_PERIOD        ?= 20.0
  export MACRO_PLACE_HALO    ?= 10 10
  export MACRO_PLACE_CHANNEL ?= 30 30
else ifeq ($(PLATFORM),ihp-sg13g2)
  export CLOCK_PERIOD        ?= 20.0
  export MACRO_PLACE_HALO    ?= 10 10
  export MACRO_PLACE_CHANNEL ?= 30 30
else
  export CLOCK_PERIOD        ?= 10.0
  export MACRO_PLACE_HALO    ?= 10 10
  export MACRO_PLACE_CHANNEL ?= 30 30
endif
