0D34        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 5: Unsigned Relational Comparisons (_CMP_LT, _CMP_LE, _CMP_GT, _CMP_GE)
; Description:
;   Evaluates 16-bit unsigned inequalities across the entire 0x0000-0xFFFF range.
;   Because MiniRISC4 only supports JMP.M (sign bit is 1) and JMP.Z (zero) on
;   register contents, unsigned comparison must differentiate between numbers
;   with differing MSBs (where bit 15 represents the 0x8000 boundary) and numbers
;   with identical MSBs (where standard subtraction gives the correct magnitude).
;
; Inputs:
;   R1 = Left-Hand Side (LHS / A)
;   R2 = Right-Hand Side (RHS / B)
; Outputs:
;   R1 = 1 if the condition is True
;   R1 = 0 if the condition is False
; ==============================================================================

; ==============================================================================
; SUBROUTINE: _CMP_LT  (Unsigned Less-Than: A < B)
; ==============================================================================
        _CMP_LT:
0D3A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D3A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Compare MSBs (bit 15) using XOR
0D3F        XCHG    R0                             ; [BC]
0D40        LD      R0, R1                         ; [01]
0D40        XOR     R0, R2              ; If bit 15 is set, operands have opposite signs ; [92]
0D41        PUSH8   R3, >(_CMP_LT_DIFF_SIGNS)      ; [FB 0D FB 4B]
0D41        PUSH8   R3, <(_CMP_LT_DIFF_SIGNS)      ; [FB 0D FB 4B]
0D43        JMP.M   R3, R0              ; Branch if MSBs are different ; [EC]
0D43        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: MSBs are identical -> standard subtraction A - B gives correct relation
0D44        SUB     R1, R2              ; R1 = A - B ; [76]
0D44        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 0D F8 8E]
0D44        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 0D F8 8E]
0D47        JMP.M   R0, R1              ; If difference is negative, A < B -> True ; [E1]
0D47        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 0D F8 96]
0D47        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 0D F8 96]
0D4A        JMP     R0                  ; Else A >= B -> False ; [F0]

0D4A    _CMP_LT_DIFF_SIGNS:                        ; [00]
0D4B        XCHG    R0                  ; Restore R0 ; [BC]
    ; When MSBs differ: the operand with MSB=1 is in range [0x8000..0xFFFF],
    ; while the operand with MSB=0 is in range [0x0000..0x7FFF].
    ; Therefore, if LHS (R1) has bit 15 set, LHS is strictly larger -> False.
0D4B        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 0D F8 96]
0D4B        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 0D F8 96]
0D4E        JMP.M   R0, R1              ; If R1[15] == 1, A > B -> False ; [E1]
0D4E        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 0D F8 8E]
0D4E        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 0D F8 8E]
0D51        JMP     R0                  ; Else A < B -> True ; [F0]

; ==============================================================================
; SUBROUTINE: _CMP_LE  (Unsigned Less-Than-or-Equal: A <= B)
; ==============================================================================
0D51    _CMP_LE:                                   ; [00]
0D52        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D52        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Check equality (A == B)
0D57        XCHG    R0                             ; [BC]
0D58        LD      R0, R1                         ; [01]
0D58        SUB     R0, R2              ; Test difference A - B ; [72]
0D59        PUSH8   R3, >(_CMP_LE_EQUAL)           ; [FB 0D FB 65]
0D59        PUSH8   R3, <(_CMP_LE_EQUAL)           ; [FB 0D FB 65]
0D5B        JMP.Z   R3, R0              ; If A == B, branch to True ; [DC]
0D5B        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: Not equal -> evaluate A < B
0D5C        PUSH8   R0, >(_CMP_LT)                 ; [F8 0D F8 3A F4 00]
0D5C        PUSH8   R0, <(_CMP_LT)                 ; [F8 0D F8 3A F4 00]
0D5C        LINK    R0, R0                         ; [F8 0D F8 3A F4 00]
0D5F        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D5F        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _CMP_LE_EQUAL:
0D65        XCHG    R0                  ; Restore R0 ; [BC]
0D65        PUSH8   R1, >(1)                       ; [00 F9 00 F9 01]
0D65        PUSH8   R1, <(1)                       ; [00 F9 00 F9 01]
0D68        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D68        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SUBROUTINE: _CMP_GT  (Unsigned Greater-Than: A > B)
; Note: A > B is logically equivalent to B < A
; ==============================================================================
        _CMP_GT:
0D6E        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D6E        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D73        XOR     R1, R2                         ; [96 99 96]
0D73        XOR     R2, R1                         ; [96 99 96]
0D73        XOR     R1, R2                         ; [96 99 96]
0D75        PUSH8   R0, >(_CMP_LT)                 ; [F8 0D F8 3A F4 00]
0D75        PUSH8   R0, <(_CMP_LT)                 ; [F8 0D F8 3A F4 00]
0D75        LINK    R0, R0                         ; [F8 0D F8 3A F4 00]
0D78        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D78        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SUBROUTINE: _CMP_GE  (Unsigned Greater-Than-or-Equal: A >= B)
; Note: A >= B is logically equivalent to B <= A
; ==============================================================================
        _CMP_GE:
0D7E        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D7E        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D83        XOR     R1, R2                         ; [96 99 96]
0D83        XOR     R2, R1                         ; [96 99 96]
0D83        XOR     R1, R2                         ; [96 99 96]
0D85        PUSH8   R0, >(_CMP_LE)                 ; [F8 0D F8 52 F4 00]
0D85        PUSH8   R0, <(_CMP_LE)                 ; [F8 0D F8 52 F4 00]
0D85        LINK    R0, R0                         ; [F8 0D F8 52 F4 00]
0D88        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D88        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; Boolean Return Exit Points
; ==============================================================================
        _CMP_RET_TRUE:
0D8E        PUSH8   R1, >(1)                       ; [F9 00 F9 01]
0D8E        PUSH8   R1, <(1)                       ; [F9 00 F9 01]
0D90        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D90        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _CMP_RET_FALSE:
0D96        XOR     R1, R1                         ; [95]
0D96        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D96        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
