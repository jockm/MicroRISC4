// ==============================================================================
// FILE: mr4src/act4/os/os_fat32.a4
// Core 0 FAT32 Filesystem Driver (8.3 Names)
// ==============================================================================

u16 sec_buf[256];               // Shared 512-byte (256-word) sector buffer

// Mounted volume geometry (32-bit LBAs stored as hi/lo u16 pairs)
u16 fat_lba_lo     = 0;
u16 fat_lba_hi     = 0;
u16 data_lba_lo    = 0;
u16 data_lba_hi    = 0;
u16 root_clus_lo   = 0;
u16 root_clus_hi   = 0;
u16 sec_per_clus   = 0;
u16 fat_num_fats   = 0;
u16 fat_sz_lo      = 0;
u16 fat_sz_hi      = 0;
u16 fat_mounted    = 0;
u16 fat32_last_found   = 0;
u16 fat32_last_size_lo = 0;
u16 fat32_last_size_hi = 0;

type DirEntry {
    u16 attr;
    u16 size_lo;
    u16 size_hi;
    u16 name[8];                // Null-terminated "FILENAME.EXT"
};

type FileHandle {
    u16 in_use;
    u16 is_dir;
    u16 owner_core;
    u16 cur_clus_lo;
    u16 cur_clus_hi;
    u16 sec_in_clus;            // 0 .. (sec_per_clus - 1)
    u16 byte_in_sec;            // 0 .. 511
    u16 size_lo;
    u16 size_hi;
    u16 pos_lo;
    u16 pos_hi;
    u16 writable;               // 0 = read-only, 1 = write
    u16 dir_lba_lo;             // Root dir sector LBA for size sync
    u16 dir_lba_hi;
    u16 dir_off;                // Byte offset (0..480) of 32-byte entry
};

FileHandle fds[8];

// --- Little-Endian Unaligned Helpers (using ACT4 getbyte/setbyte) ---
u16 rd_u16(u16 *buf, u16 off) {
    return getbyte(buf, off) | (getbyte(buf, off + 1) << 8);
}

void wr_u16(u16 *buf, u16 off, u16 val) {
    setbyte(buf, off, val & 0x00FF);
    setbyte(buf, off + 1, val >> 8);
}

// 32-bit add: (tmp32_hi:tmp32_lo) = (a_hi:a_lo) + (b_hi:b_lo)
u16 tmp32_lo = 0;
u16 tmp32_hi = 0;

void add32(u16 a_hi, u16 a_lo, u16 b_hi, u16 b_lo) {
    tmp32_lo = a_lo + b_lo;
    tmp32_hi = a_hi + b_hi;
    if (tmp32_lo < a_lo) {
        tmp32_hi++;             // Carry into high word
    }
}

// Convert cluster number to starting LBA in (tmp32_hi:tmp32_lo)
void cluster_to_lba(u16 clus_hi, u16 clus_lo) {
    u16 c_lo = clus_lo - 2;
    u16 c_hi = clus_hi;
    u16 s = sec_per_clus;
    if (clus_lo < 2) {
        c_hi--;
    }
    // Multiply (c_hi:c_lo) by sec_per_clus (always a power of 2 in FAT32)
    while (s > 1) {
        c_hi = (c_hi << 1) | (c_lo >> 15);
        c_lo = c_lo << 1;
        s = s >> 1;
    }
    add32(data_lba_hi, data_lba_lo, c_hi, c_lo);
}

// Look up next cluster in FAT32 table -> result in (tmp32_hi:tmp32_lo)
// Returns 1 if end-of-chain (>= 0x0FFFFFF8), else 0
u16 fat32_next_cluster(u16 clus_hi, u16 clus_lo) {
    // 128 FAT32 entries per 512-byte sector
    u16 fat_sec_lo = (clus_lo >> 7) | (clus_hi << 9);
    u16 fat_sec_hi = clus_hi >> 7;
    u16 ent_off    = (clus_lo & 0x007F) << 2;

    add32(fat_lba_hi, fat_lba_lo, fat_sec_hi, fat_sec_lo);
    if (sd_read_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
        return 1;
    }

    tmp32_lo = rd_u16(sec_buf, ent_off);
    tmp32_hi = rd_u16(sec_buf, ent_off + 2) & 0x0FFF;

    if (tmp32_hi >= 0x0FFF && tmp32_lo >= 0xFFF8) {
        return 1;               // End of cluster chain
    }
    return 0;
}

// Mount FAT32 volume from MBR Partition 0 (returns 0 = OK)
u16 fat32_mount(void) {
    u16 part_lba_lo = 0;
    u16 part_lba_hi = 0;
    u16 rsvd_secs   = 0;
    u16 num_fats    = 0;
    u16 fsz_lo      = 0;
    u16 fsz_hi      = 0;
    u16 i           = 0;

    if (sd_init() != 0) {
        return 1;
    }
    // Read Sector 0 (MBR)
    if (sd_read_sector(0, 0, sec_buf) != 0) {
        return 2;
    }
    part_lba_lo = rd_u16(sec_buf, 454);
    part_lba_hi = rd_u16(sec_buf, 456);

    // Read FAT32 Volume Boot Record (BPB)
    if (sd_read_sector(part_lba_hi, part_lba_lo, sec_buf) != 0) {
        return 3;
    }

    sec_per_clus = getbyte(sec_buf, 13);
    rsvd_secs    = rd_u16(sec_buf, 14);
    num_fats     = getbyte(sec_buf, 16);
    fsz_lo       = rd_u16(sec_buf, 36);
    fsz_hi       = rd_u16(sec_buf, 38);
    root_clus_lo = rd_u16(sec_buf, 44);
    root_clus_hi = rd_u16(sec_buf, 46);

    fat_num_fats = num_fats;
    fat_sz_lo    = fsz_lo;
    fat_sz_hi    = fsz_hi;

    // fat_lba = part_lba + rsvd_secs
    add32(part_lba_hi, part_lba_lo, 0, rsvd_secs);
    fat_lba_hi = tmp32_hi;
    fat_lba_lo = tmp32_lo;

    // data_lba = fat_lba + (num_fats * fat_size_32)
    data_lba_hi = fat_lba_hi;
    data_lba_lo = fat_lba_lo;
    while (i < num_fats) {
        add32(data_lba_hi, data_lba_lo, fsz_hi, fsz_lo);
        data_lba_hi = tmp32_hi;
        data_lba_lo = tmp32_lo;
        i++;
    }

    fat_mounted = 1;
    return 0;
}

// Format 11-byte FAT 8.3 name at sec_buf[off] into "NAME.EXT\0"
void format_83_name(u16 off, u16 *dst) {
    u16 i = 0;
    u16 o = 0;
    u16 ch = 0;

    // 8-char base name (trim trailing spaces)
    while (i < 8) {
        ch = getbyte(sec_buf, off + i);
        if (ch != 32) {
            setbyte(dst, o, ch);
            o++;
        }
        i++;
    }
    // 3-char extension (only add '.' if non-blank)
    if (getbyte(sec_buf, off + 8) != 32) {
        setbyte(dst, o, 46);    // '.'
        o++;
        i = 8;
        while (i < 11) {
            ch = getbyte(sec_buf, off + i);
            if (ch != 32) {
                setbyte(dst, o, ch);
                o++;
            }
            i++;
        }
    }
    setbyte(dst, o, 0);
}

// Encode ASCII filename ("name.ext") into 11-byte space-padded uppercase FAT 8.3 name
void encode_83_name(u16 *src, u16 *dst11) {
    u16 i = 0;
    u16 o = 0;
    u16 ch = 0;

    while (i < 11) {
        setbyte(dst11, i, 32);
        i++;
    }

    i = 0;
    o = 0;
    while (true) {
        ch = getbyte(src, i);
        if (ch == 0 || ch == 46) {
            break;
        }
        if (o < 8) {
            setbyte(dst11, o, ascii_upper(ch));
            o++;
        }
        i++;
    }

    if (ch == 46) {
        i++;
        o = 8;
        while (o < 11) {
            ch = getbyte(src, i);
            if (ch == 0) {
                break;
            }
            setbyte(dst11, o, ascii_upper(ch));
            o++;
            i++;
        }
    }
}

// Open root directory ("/") into a FileHandle slot (returns fd or 0xFFFF)
u16 fat32_opendir_root(u16 owner_core) {
    u16 fd = 0;
    if (fat_mounted == 0) {
        return 0xFFFF;
    }
    while (fd < 8) {
        if (fds[fd].in_use == 0) {
            fds[fd].in_use      = 1;
            fds[fd].is_dir      = 1;
            fds[fd].owner_core  = owner_core;
            fds[fd].cur_clus_lo = root_clus_lo;
            fds[fd].cur_clus_hi = root_clus_hi;
            fds[fd].sec_in_clus = 0;
            fds[fd].byte_in_sec = 0;
            return fd;
        }
        fd++;
    }
    return 0xFFFF;
}

void fat32_close(u16 fd) {
    if (fd < 8) {
        fds[fd].in_use = 0;
    }
}

void fat32_close_owner(u16 owner_core) {
    u16 fd = 0;
    while (fd < 8) {
        if (fds[fd].in_use != 0 && fds[fd].owner_core == owner_core) {
            fds[fd].in_use = 0;
        }
        fd++;
    }
}

// Open an 8.3 file (case-insensitive) in root directory for streaming reads.
// Returns fd (0..7) or 0xFFFF on error / not found.
u16 fat32_open_root(u16 owner_core, u16 *filename) {
    u16 fd           = 0;
    u16 slot         = 0xFFFF;
    u16 off          = 0;
    u16 first        = 0;
    u16 attr         = 0;
    u16 sec_idx      = 0;
    u16 scan_clus_lo = root_clus_lo;
    u16 scan_clus_hi = root_clus_hi;
    u16 entry_name[8];

    if (fat_mounted == 0) {
        return 0xFFFF;
    }

    while (fd < 8) {
        if (fds[fd].in_use == 0) {
            slot = fd;
            break;
        }
        fd++;
    }
    if (slot == 0xFFFF) {
        return 0xFFFF;
    }

    while (true) {
        sec_idx = 0;
        while (sec_idx < sec_per_clus) {
            cluster_to_lba(scan_clus_hi, scan_clus_lo);
            add32(tmp32_hi, tmp32_lo, 0, sec_idx);
            if (sd_read_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
                return 0xFFFF;
            }
            off = 0;
            while (off < 512) {
                first = getbyte(sec_buf, off);
                attr  = getbyte(sec_buf, off + 11);
                if (first == 0x00) {
                    return 0xFFFF;
                }
                if (first != 0xE5 && attr != 0x0F && (attr & 0x08) == 0 && (attr & 0x10) == 0) {
                    format_83_name(off, entry_name);
                    if (str_eq_ci(entry_name, filename) == 1) {
                        fds[slot].in_use      = 1;
                        fds[slot].is_dir      = 0;
                        fds[slot].owner_core  = owner_core;
                        fds[slot].cur_clus_lo = rd_u16(sec_buf, off + 26);
                        fds[slot].cur_clus_hi = rd_u16(sec_buf, off + 20);
                        fds[slot].sec_in_clus = 0;
                        fds[slot].byte_in_sec = 0;
                        fds[slot].size_lo     = rd_u16(sec_buf, off + 28);
                        fds[slot].size_hi     = rd_u16(sec_buf, off + 30);
                        fds[slot].pos_lo      = 0;
                        fds[slot].pos_hi      = 0;
                        fds[slot].writable    = 0;
                        return slot;
                    }
                }
                off = off + 32;
            }
            sec_idx++;
        }
        if (fat32_next_cluster(scan_clus_hi, scan_clus_lo) != 0) {
            return 0xFFFF;
        }
        scan_clus_hi = tmp32_hi;
        scan_clus_lo = tmp32_lo;
    }
    return 0xFFFF;
}

// Read up to max_bytes from an open file fd into packed dst_buf.
// Returns exact byte count read (0 on EOF or error).
u16 fat32_read_bytes(u16 fd, u16 *dst_buf, u16 max_bytes) {
    u16 out_idx = 0;
    u16 boff    = 0;
    u16 b       = 0;
    u16 p_lo    = 0;
    u16 p_hi    = 0;
    u16 s_lo    = 0;
    u16 s_hi    = 0;

    if (fd >= 8 || fds[fd].in_use == 0 || fds[fd].is_dir != 0 || max_bytes == 0) {
        return 0;
    }

    p_lo = fds[fd].pos_lo;
    p_hi = fds[fd].pos_hi;
    s_lo = fds[fd].size_lo;
    s_hi = fds[fd].size_hi;

    while (out_idx < max_bytes) {
        if (p_hi > s_hi || (p_hi == s_hi && p_lo >= s_lo)) {
            break;
        }
        if (fds[fd].cur_clus_hi == 0 && fds[fd].cur_clus_lo < 2) {
            break;
        }

        cluster_to_lba(fds[fd].cur_clus_hi, fds[fd].cur_clus_lo);
        add32(tmp32_hi, tmp32_lo, 0, fds[fd].sec_in_clus);
        if (sd_read_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
            break;
        }

        boff = fds[fd].byte_in_sec;
        while (boff < 512 && out_idx < max_bytes) {
            if (p_hi > s_hi || (p_hi == s_hi && p_lo >= s_lo)) {
                break;
            }
            b = getbyte(sec_buf, boff);
            setbyte(dst_buf, out_idx, b);
            out_idx++;
            boff++;
            p_lo++;
            if (p_lo == 0) {
                p_hi++;
            }
        }

        fds[fd].byte_in_sec = boff;
        if (boff >= 512) {
            fds[fd].byte_in_sec = 0;
            fds[fd].sec_in_clus++;
            if (fds[fd].sec_in_clus >= sec_per_clus) {
                fds[fd].sec_in_clus = 0;
                if (fat32_next_cluster(fds[fd].cur_clus_hi, fds[fd].cur_clus_lo) != 0) {
                    fds[fd].cur_clus_hi = 0;
                    fds[fd].cur_clus_lo = 0;
                    break;
                }
                fds[fd].cur_clus_hi = tmp32_hi;
                fds[fd].cur_clus_lo = tmp32_lo;
            }
        }
    }

    fds[fd].pos_lo = p_lo;
    fds[fd].pos_hi = p_hi;

    // Zero-pad upper byte of final word if an odd number of bytes was read
    if ((out_idx & 0x0001) != 0) {
        setbyte(dst_buf, out_idx, 0);
    }
    return out_idx;
}

// Read next valid 8.3 directory entry into *out (0 = OK, 1 = EOF)
u16 fat32_readdir(u16 fd, DirEntry *out) {
    u16 off   = 0;
    u16 first = 0;
    u16 attr  = 0;

    if (fd >= 8 || fds[fd].in_use == 0) {
        return 1;
    }

    while (true) {
        cluster_to_lba(fds[fd].cur_clus_hi, fds[fd].cur_clus_lo);
        add32(tmp32_hi, tmp32_lo, 0, fds[fd].sec_in_clus);
        if (sd_read_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
            return 1;
        }

        off = fds[fd].byte_in_sec;
        while (off < 512) {
            first = getbyte(sec_buf, off);
            attr  = getbyte(sec_buf, off + 11);
            off = off + 32;

            if (first == 0x00) {
                return 1;       // End of directory
            }
            // Skip deleted (0xE5), LFN (0x0F), and volume labels (0x08)
            if (first != 0xE5 && attr != 0x0F && (attr & 0x08) == 0) {
                fds[fd].byte_in_sec = off;
                out->attr    = attr;
                out->size_lo = rd_u16(sec_buf, off - 4);
                out->size_hi = rd_u16(sec_buf, off - 2);
                format_83_name(off - 32, out->name);
                return 0;
            }
        }

        // Advance to next sector / cluster
        fds[fd].byte_in_sec = 0;
        fds[fd].sec_in_clus++;
        if (fds[fd].sec_in_clus >= sec_per_clus) {
            fds[fd].sec_in_clus = 0;
            if (fat32_next_cluster(fds[fd].cur_clus_hi, fds[fd].cur_clus_lo) != 0) {
                return 1;
            }
            fds[fd].cur_clus_hi = tmp32_hi;
            fds[fd].cur_clus_lo = tmp32_lo;
        }
    }
    return 1;
}

// Find an 8.3 file (case-insensitive) in root dir and read up to max_words
// packed 16-bit words into dst_buf. Returns word count (>0) or 0 on error.
u16 fat32_read_file_root(u16 *filename, u16 *dst_buf, u16 max_words) {
    u16 off        = 0;
    u16 first      = 0;
    u16 attr       = 0;
    u16 clus_lo    = 0;
    u16 clus_hi    = 0;
    u16 size_lo    = 0;
    u16 size_hi    = 0;
    u16 total_wds  = 0;
    u16 words_read = 0;
    u16 sec_idx    = 0;
    u16 w_idx      = 0;
    u16 found      = 0;
    u16 scan_clus_lo = root_clus_lo;
    u16 scan_clus_hi = root_clus_hi;
    u16 entry_name[8];

    fat32_last_found   = 0;
    fat32_last_size_lo = 0;
    fat32_last_size_hi = 0;

    if (fat_mounted == 0) {
        return 0;
    }

    while (found == 0) {
        sec_idx = 0;
        while (sec_idx < sec_per_clus && found == 0) {
            cluster_to_lba(scan_clus_hi, scan_clus_lo);
            add32(tmp32_hi, tmp32_lo, 0, sec_idx);
            if (sd_read_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
                return 0;
            }
            off = 0;
            while (off < 512 && found == 0) {
                first = getbyte(sec_buf, off);
                attr  = getbyte(sec_buf, off + 11);
                if (first == 0x00) {
                    return 0;
                }
                if (first != 0xE5 && attr != 0x0F && (attr & 0x08) == 0 && (attr & 0x10) == 0) {
                    format_83_name(off, entry_name);
                    if (str_eq_ci(entry_name, filename) == 1) {
                        clus_lo = rd_u16(sec_buf, off + 26);
                        clus_hi = rd_u16(sec_buf, off + 20);
                        size_lo = rd_u16(sec_buf, off + 28);
                        size_hi = rd_u16(sec_buf, off + 30);
                        found = 1;
                    }
                }
                off = off + 32;
            }
            sec_idx++;
        }
        if (found == 0) {
            if (fat32_next_cluster(scan_clus_hi, scan_clus_lo) != 0) {
                return 0;
            }
            scan_clus_hi = tmp32_hi;
            scan_clus_lo = tmp32_lo;
        }
    }

    fat32_last_found   = 1;
    fat32_last_size_lo = size_lo;
    fat32_last_size_hi = size_hi;

    if (size_hi != 0) {
        total_wds = max_words;
    } else {
        total_wds = (size_lo + 1) >> 1;
        if (total_wds > max_words) {
            total_wds = max_words;
        }
    }

    while (words_read < total_wds) {
        if (clus_hi == 0 && clus_lo < 2) {
            break;
        }
        sec_idx = 0;
        while (sec_idx < sec_per_clus && words_read < total_wds) {
            cluster_to_lba(clus_hi, clus_lo);
            add32(tmp32_hi, tmp32_lo, 0, sec_idx);
            if (sd_read_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
                return 0;
            }
            w_idx = 0;
            while (w_idx < 256 && words_read < total_wds) {
                dst_buf[words_read] = sec_buf[w_idx];
                words_read++;
                w_idx++;
            }
            sec_idx++;
        }
        if (words_read < total_wds) {
            if (fat32_next_cluster(clus_hi, clus_lo) != 0) {
                break;
            }
            clus_hi = tmp32_hi;
            clus_lo = tmp32_lo;
        }
    }

    return words_read;
}

// Free an entire FAT32 cluster chain starting at (clus_hi:clus_lo) across all FAT copies
u16 fat32_free_chain(u16 clus_hi, u16 clus_lo) {
    u16 fat_sec_lo = 0;
    u16 fat_sec_hi = 0;
    u16 ent_off    = 0;
    u16 next_lo    = 0;
    u16 next_hi    = 0;
    u16 hi_rsvd    = 0;
    u16 cur_lba_lo = 0;
    u16 cur_lba_hi = 0;
    u16 f_idx      = 0;

    while (clus_hi != 0 || clus_lo >= 2) {
        fat_sec_lo = (clus_lo >> 7) | (clus_hi << 9);
        fat_sec_hi = clus_hi >> 7;
        ent_off    = (clus_lo & 0x007F) << 2;

        add32(fat_lba_hi, fat_lba_lo, fat_sec_hi, fat_sec_lo);
        cur_lba_hi = tmp32_hi;
        cur_lba_lo = tmp32_lo;
        if (sd_read_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
            return 1;
        }

        next_lo = rd_u16(sec_buf, ent_off);
        hi_rsvd = rd_u16(sec_buf, ent_off + 2);
        next_hi = hi_rsvd & 0x0FFF;

        // Zero cluster pointer bits while preserving top 4 reserved bits
        wr_u16(sec_buf, ent_off, 0);
        wr_u16(sec_buf, ent_off + 2, hi_rsvd & 0xF000);

        // Write updated FAT sector to every FAT copy
        f_idx = 0;
        while (f_idx < fat_num_fats) {
            if (sd_write_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
                return 1;
            }
            add32(cur_lba_hi, cur_lba_lo, fat_sz_hi, fat_sz_lo);
            cur_lba_hi = tmp32_hi;
            cur_lba_lo = tmp32_lo;
            f_idx++;
        }

        if ((next_hi >= 0x0FFF && next_lo >= 0xFFF8) || (next_hi == 0 && next_lo < 2)) {
            return 0;
        }
        clus_hi = next_hi;
        clus_lo = next_lo;
    }
    return 0;
}

// Delete an 8.3 file (case-insensitive) from root directory and free its clusters.
// Returns 0 = OK, 1 = I/O or not mounted, 2 = not found.
u16 fat32_unlink_root(u16 *filename) {
    u16 off          = 0;
    u16 first        = 0;
    u16 attr         = 0;
    u16 clus_lo      = 0;
    u16 clus_hi      = 0;
    u16 sec_idx      = 0;
    u16 dir_lba_lo   = 0;
    u16 dir_lba_hi   = 0;
    u16 scan_clus_lo = root_clus_lo;
    u16 scan_clus_hi = root_clus_hi;
    u16 entry_name[8];

    if (fat_mounted == 0) {
        return 1;
    }

    while (true) {
        sec_idx = 0;
        while (sec_idx < sec_per_clus) {
            cluster_to_lba(scan_clus_hi, scan_clus_lo);
            add32(tmp32_hi, tmp32_lo, 0, sec_idx);
            dir_lba_hi = tmp32_hi;
            dir_lba_lo = tmp32_lo;
            if (sd_read_sector(dir_lba_hi, dir_lba_lo, sec_buf) != 0) {
                return 1;
            }
            off = 0;
            while (off < 512) {
                first = getbyte(sec_buf, off);
                attr  = getbyte(sec_buf, off + 11);
                if (first == 0x00) {
                    return 2;
                }
                if (first != 0xE5 && attr != 0x0F && (attr & 0x08) == 0 && (attr & 0x10) == 0) {
                    format_83_name(off, entry_name);
                    if (str_eq_ci(entry_name, filename) == 1) {
                        clus_lo = rd_u16(sec_buf, off + 26);
                        clus_hi = rd_u16(sec_buf, off + 20);
                        setbyte(sec_buf, off, 0xE5);
                        if (sd_write_sector(dir_lba_hi, dir_lba_lo, sec_buf) != 0) {
                            return 1;
                        }
                        if (clus_hi != 0 || clus_lo >= 2) {
                            if (fat32_free_chain(clus_hi, clus_lo) != 0) {
                                return 1;
                            }
                        }
                        return 0;
                    }
                }
                off = off + 32;
            }
            sec_idx++;
        }
        if (fat32_next_cluster(scan_clus_hi, scan_clus_lo) != 0) {
            return 2;
        }
        scan_clus_hi = tmp32_hi;
        scan_clus_lo = tmp32_lo;
    }
    return 2;
}

// Write a 28-bit FAT32 entry value for (clus_hi:clus_lo) across all FAT copies
u16 fat32_set_entry(u16 clus_hi, u16 clus_lo, u16 val_hi, u16 val_lo) {
    u16 fat_sec_lo = (clus_lo >> 7) | (clus_hi << 9);
    u16 fat_sec_hi = clus_hi >> 7;
    u16 ent_off    = (clus_lo & 0x007F) << 2;
    u16 hi_rsvd    = 0;
    u16 cur_lba_lo = 0;
    u16 cur_lba_hi = 0;
    u16 f_idx      = 0;

    add32(fat_lba_hi, fat_lba_lo, fat_sec_hi, fat_sec_lo);
    cur_lba_hi = tmp32_hi;
    cur_lba_lo = tmp32_lo;
    if (sd_read_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
        return 1;
    }

    hi_rsvd = rd_u16(sec_buf, ent_off + 2) & 0xF000;
    wr_u16(sec_buf, ent_off, val_lo);
    wr_u16(sec_buf, ent_off + 2, hi_rsvd | (val_hi & 0x0FFF));

    while (f_idx < fat_num_fats) {
        if (sd_write_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
            return 1;
        }
        add32(cur_lba_hi, cur_lba_lo, fat_sz_hi, fat_sz_lo);
        cur_lba_hi = tmp32_hi;
        cur_lba_lo = tmp32_lo;
        f_idx++;
    }
    return 0;
}

// Allocate a free FAT32 cluster, mark EOC across all FAT copies, zero its sectors.
// Result returned in (tmp32_hi:tmp32_lo). Returns 0 = OK, 1 = full/error.
u16 fat32_alloc_cluster(void) {
    u16 sec        = 0;
    u16 max_sec    = fat_sz_lo;
    u16 e          = 0;
    u16 ent_off    = 0;
    u16 lo         = 0;
    u16 hi         = 0;
    u16 hi_rsvd    = 0;
    u16 alloc_lo   = 0;
    u16 alloc_hi   = 0;
    u16 cur_lba_lo = 0;
    u16 cur_lba_hi = 0;
    u16 f_idx      = 0;
    u16 s_idx      = 0;
    u16 w_idx      = 0;

    if (fat_sz_hi != 0) {
        max_sec = 0xFFFF;
    }

    while (sec < max_sec) {
        add32(fat_lba_hi, fat_lba_lo, 0, sec);
        cur_lba_hi = tmp32_hi;
        cur_lba_lo = tmp32_lo;
        if (sd_read_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
            return 1;
        }

        e = 0;
        if (sec == 0) {
            e = 2;              // Clusters 0 and 1 are reserved
        }
        while (e < 128) {
            ent_off = e << 2;
            lo = rd_u16(sec_buf, ent_off);
            hi = rd_u16(sec_buf, ent_off + 2);
            if (lo == 0 && (hi & 0x0FFF) == 0) {
                alloc_lo = (sec << 7) | e;
                alloc_hi = sec >> 9;

                // Mark EOC (0x0FFFFFFF) in sec_buf and write to every FAT copy
                hi_rsvd = hi & 0xF000;
                wr_u16(sec_buf, ent_off, 0xFFFF);
                wr_u16(sec_buf, ent_off + 2, hi_rsvd | 0x0FFF);

                f_idx = 0;
                while (f_idx < fat_num_fats) {
                    if (sd_write_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
                        return 1;
                    }
                    add32(cur_lba_hi, cur_lba_lo, fat_sz_hi, fat_sz_lo);
                    cur_lba_hi = tmp32_hi;
                    cur_lba_lo = tmp32_lo;
                    f_idx++;
                }

                // Zero all sectors in the newly allocated cluster
                w_idx = 0;
                while (w_idx < 256) {
                    sec_buf[w_idx] = 0;
                    w_idx++;
                }
                s_idx = 0;
                while (s_idx < sec_per_clus) {
                    cluster_to_lba(alloc_hi, alloc_lo);
                    add32(tmp32_hi, tmp32_lo, 0, s_idx);
                    if (sd_write_sector(tmp32_hi, tmp32_lo, sec_buf) != 0) {
                        return 1;
                    }
                    s_idx++;
                }

                tmp32_hi = alloc_hi;
                tmp32_lo = alloc_lo;
                return 0;
            }
            e++;
        }
        sec++;
    }
    return 1;
}

// Sync open writable FileHandle's size back to its root directory entry on disk
u16 fat32_sync_dir_size(u16 fd) {
    u16 off = fds[fd].dir_off;
    if (sd_read_sector(fds[fd].dir_lba_hi, fds[fd].dir_lba_lo, sec_buf) != 0) {
        return 1;
    }
    wr_u16(sec_buf, off + 28, fds[fd].size_lo);
    wr_u16(sec_buf, off + 30, fds[fd].size_hi);
    return sd_write_sector(fds[fd].dir_lba_hi, fds[fd].dir_lba_lo, sec_buf);
}

// Create/truncate an 8.3 file in root directory and open it for writing.
// Returns fd (0..7) or 0xFFFF on error.
u16 fat32_open_write_root(u16 owner_core, u16 *filename) {
    u16 fd           = 0;
    u16 slot         = 0xFFFF;
    u16 err          = 0;
    u16 off          = 0;
    u16 first        = 0;
    u16 sec_idx      = 0;
    u16 dir_lba_lo   = 0;
    u16 dir_lba_hi   = 0;
    u16 dir_off      = 0;
    u16 found_slot   = 0;
    u16 new_clus_lo  = 0;
    u16 new_clus_hi  = 0;
    u16 scan_clus_lo = root_clus_lo;
    u16 scan_clus_hi = root_clus_hi;
    u16 i            = 0;
    u16 name11[6];

    if (fat_mounted == 0) {
        return 0xFFFF;
    }

    while (fd < 8) {
        if (fds[fd].in_use == 0) {
            slot = fd;
            break;
        }
        fd++;
    }
    if (slot == 0xFFFF) {
        return 0xFFFF;
    }

    // Remove existing file of same name (frees its clusters & leaves 0xE5 slot)
    err = fat32_unlink_root(filename);
    if (err == 1) {
        return 0xFFFF;
    }

    // Find first free (0x00) or deleted (0xE5) directory entry in root dir
    while (found_slot == 0) {
        sec_idx = 0;
        while (sec_idx < sec_per_clus && found_slot == 0) {
            cluster_to_lba(scan_clus_hi, scan_clus_lo);
            add32(tmp32_hi, tmp32_lo, 0, sec_idx);
            dir_lba_hi = tmp32_hi;
            dir_lba_lo = tmp32_lo;
            if (sd_read_sector(dir_lba_hi, dir_lba_lo, sec_buf) != 0) {
                return 0xFFFF;
            }
            off = 0;
            while (off < 512) {
                first = getbyte(sec_buf, off);
                if (first == 0x00 || first == 0xE5) {
                    dir_off = off;
                    found_slot = 1;
                    break;
                }
                off = off + 32;
            }
            sec_idx++;
        }
        if (found_slot == 0) {
            if (fat32_next_cluster(scan_clus_hi, scan_clus_lo) != 0) {
                // Extend root directory by allocating a new cluster
                if (fat32_alloc_cluster() != 0) {
                    return 0xFFFF;
                }
                new_clus_hi = tmp32_hi;
                new_clus_lo = tmp32_lo;
                if (fat32_set_entry(scan_clus_hi, scan_clus_lo, new_clus_hi, new_clus_lo) != 0) {
                    return 0xFFFF;
                }
                scan_clus_hi = new_clus_hi;
                scan_clus_lo = new_clus_lo;
            } else {
                scan_clus_hi = tmp32_hi;
                scan_clus_lo = tmp32_lo;
            }
        }
    }

    // Allocate initial data cluster for the file
    if (fat32_alloc_cluster() != 0) {
        return 0xFFFF;
    }
    new_clus_hi = tmp32_hi;
    new_clus_lo = tmp32_lo;

    // Populate the 32-byte directory entry on disk
    encode_83_name(filename, name11);
    if (sd_read_sector(dir_lba_hi, dir_lba_lo, sec_buf) != 0) {
        return 0xFFFF;
    }
    i = 0;
    while (i < 32) {
        setbyte(sec_buf, dir_off + i, 0);
        i++;
    }
    i = 0;
    while (i < 11) {
        setbyte(sec_buf, dir_off + i, getbyte(name11, i));
        i++;
    }
    setbyte(sec_buf, dir_off + 11, 0x20);       // ATTR_ARCHIVE
    wr_u16(sec_buf, dir_off + 20, new_clus_hi); // FstClusHI
    wr_u16(sec_buf, dir_off + 26, new_clus_lo); // FstClusLO
    if (sd_write_sector(dir_lba_hi, dir_lba_lo, sec_buf) != 0) {
        return 0xFFFF;
    }

    fds[slot].in_use      = 1;
    fds[slot].is_dir      = 0;
    fds[slot].owner_core  = owner_core;
    fds[slot].cur_clus_lo = new_clus_lo;
    fds[slot].cur_clus_hi = new_clus_hi;
    fds[slot].sec_in_clus = 0;
    fds[slot].byte_in_sec = 0;
    fds[slot].size_lo     = 0;
    fds[slot].size_hi     = 0;
    fds[slot].pos_lo      = 0;
    fds[slot].pos_hi      = 0;
    fds[slot].writable    = 1;
    fds[slot].dir_lba_lo  = dir_lba_lo;
    fds[slot].dir_lba_hi  = dir_lba_hi;
    fds[slot].dir_off     = dir_off;
    return slot;
}

// Write byte_count bytes from packed src_buf to an open writable fd.
// Returns exact bytes written (0 on error).
u16 fat32_write_bytes(u16 fd, u16 *src_buf, u16 byte_count) {
    u16 written    = 0;
    u16 boff       = 0;
    u16 b          = 0;
    u16 cur_lba_lo = 0;
    u16 cur_lba_hi = 0;
    u16 old_c_lo   = 0;
    u16 old_c_hi   = 0;
    u16 new_c_lo   = 0;
    u16 new_c_hi   = 0;
    u16 p_lo       = 0;
    u16 p_hi       = 0;

    if (fd >= 8 || fds[fd].in_use == 0 || fds[fd].is_dir != 0 || fds[fd].writable == 0 || byte_count == 0) {
        return 0;
    }

    p_lo = fds[fd].pos_lo;
    p_hi = fds[fd].pos_hi;

    while (written < byte_count) {
        cluster_to_lba(fds[fd].cur_clus_hi, fds[fd].cur_clus_lo);
        add32(tmp32_hi, tmp32_lo, 0, fds[fd].sec_in_clus);
        cur_lba_hi = tmp32_hi;
        cur_lba_lo = tmp32_lo;
        if (sd_read_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
            break;
        }

        boff = fds[fd].byte_in_sec;
        while (boff < 512 && written < byte_count) {
            b = getbyte(src_buf, written);
            setbyte(sec_buf, boff, b);
            boff++;
            written++;
            p_lo++;
            if (p_lo == 0) {
                p_hi++;
            }
        }

        if (sd_write_sector(cur_lba_hi, cur_lba_lo, sec_buf) != 0) {
            break;
        }

        fds[fd].byte_in_sec = boff;
        if (boff >= 512) {
            fds[fd].byte_in_sec = 0;
            fds[fd].sec_in_clus++;
            if (fds[fd].sec_in_clus >= sec_per_clus) {
                fds[fd].sec_in_clus = 0;
                old_c_hi = fds[fd].cur_clus_hi;
                old_c_lo = fds[fd].cur_clus_lo;
                if (fat32_alloc_cluster() != 0) {
                    break;
                }
                new_c_hi = tmp32_hi;
                new_c_lo = tmp32_lo;
                if (fat32_set_entry(old_c_hi, old_c_lo, new_c_hi, new_c_lo) != 0) {
                    break;
                }
                fds[fd].cur_clus_hi = new_c_hi;
                fds[fd].cur_clus_lo = new_c_lo;
            }
        }
    }

    fds[fd].pos_lo = p_lo;
    fds[fd].pos_hi = p_hi;
    if (p_hi > fds[fd].size_hi || (p_hi == fds[fd].size_hi && p_lo > fds[fd].size_lo)) {
        fds[fd].size_lo = p_lo;
        fds[fd].size_hi = p_hi;
    }

    fat32_sync_dir_size(fd);
    return written;
}
