// ==============================================================================
// FILE: mr4src/act4/os/os_shell.a4
// Non-Blocking Line Editor & Shell Commands
// ==============================================================================

const u16 LINE_MAX   = 64;
const u16 LINE_WORDS = LINE_MAX >> 1;
const u16 HIST_MAX   = 4;
const u16 HIST_TOTAL = HIST_MAX * LINE_WORDS;

u16 sh_line[LINE_WORDS]; // 64 bytes packed
u16 sh_len = 0;

u16 sh_hist[HIST_TOTAL]; // 4-entry command history ring
u16 sh_hist_count = 0;
u16 sh_hist_next  = 0;
u16 sh_hist_nav   = 0;
u16 sh_esc_state  = 0;

u16 sh_cmd[8];          // 16-byte command token
u16 sh_arg[16];         // 32-byte first argument token
u16 sh_arg_idx  = 0;    // Byte offset in sh_line where first arg starts
u16 sh_rest_idx = 0;    // Byte offset in sh_line after first arg
DirEntry sh_ent;

u16 sh_script_fd = 0xFFFF;  // Active FAT32 FD for do/@ script (0xFFFF = idle)
u16 sh_sc_buf[LINE_WORDS];  // 64-byte read-ahead buffer for script runner
u16 sh_script_args[LINE_WORDS];
u16 sh_sc_expand[LINE_WORDS];
u16 sh_sc_pos    = 0;
u16 sh_sc_len    = 0;
u16 sh_sc_expand_len = 0;

void shell_prompt(void) {
    uart_puts("mr4:");
    if (getbyte(cwd_path, 0) == 0) {
        uart_putc(47);
    } else {
        uart_puts(cwd_path);
    }
    uart_puts("> ");
}

// Split sh_line into sh_cmd and sh_arg (separated by space)
void shell_tokenize(void) {
    u16 i = 0;
    u16 j = 0;
    u16 ch = 0;

    setbyte(sh_cmd, 0, 0);
    setbyte(sh_arg, 0, 0);

    // Skip leading spaces
    while (getbyte(sh_line, i) == 32) {
        i++;
    }

    // Copy command token
    while (j < 15) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(sh_cmd, j, ch);
        i++;
        j++;
    }
    setbyte(sh_cmd, j, 0);

    // Skip spaces before arg
    while (getbyte(sh_line, i) == 32) {
        i++;
    }
    sh_arg_idx = i;

    // Copy argument token
    j = 0;
    while (j < 31) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(sh_arg, j, ch);
        i++;
        j++;
    }
    setbyte(sh_arg, j, 0);

    // Skip spaces before remaining line payload (e.g. for "write <file> <text>")
    while (getbyte(sh_line, i) == 32) {
        i++;
    }
    sh_rest_idx = i;
}

void shell_cmd_ls(void) {
    u16 fd = fat32_opendir(0, sh_arg);
    if (fd == 0xFFFF) {
        if (fat_mounted == 0) {
            uart_puts("SD/FAT32 not mounted\r\n");
        } else {
            uart_puts("Directory not found: ");
            uart_puts(sh_arg);
            uart_nl();
        }
        return;
    }
    while (fat32_readdir(fd, &sh_ent) == 0) {
        if ((sh_ent.attr & 0x0010) != 0) {
            uart_puts("<DIR>  ");
        } else {
            uart_puts("       ");
        }
        uart_puts(sh_ent.name);
        uart_nl();
    }
    fat32_close(fd);
}

void shell_cmd_pwd(void) {
    uart_puts(cwd_path);
    uart_nl();
}

void shell_cmd_cd(void) {
    u16 err = 0;
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_chdir(sh_arg);
    if (err == 0) {
        proc_save_cwd(0);
    } else {
        uart_puts("Directory not found: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_mkdir(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: mkdir <dir>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_mkdir(sh_arg);
    if (err == 0) {
        uart_puts("Created ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Already exists: ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to mkdir: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_rmdir(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: rmdir <dir>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_rmdir(sh_arg);
    if (err == 0) {
        uart_puts("Removed dir ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Directory not empty: ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 4) {
        uart_puts("Cannot remove current dir: ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 2) {
        uart_puts("Directory not found: ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to rmdir: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_cat(void) {
    u16 fd     = 0xFFFF;
    u16 rem_lo = 0;
    u16 rem_hi = 0;
    u16 chunk  = 0;
    u16 i      = 0;
    u16 ch     = 0;
    u16 prev   = 0;
    u16 wrote  = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: cat <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }

    fd = fat32_open(0, sh_arg);
    if (fd == 0xFFFF) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }

    rem_lo = fds[fd].size_lo;
    rem_hi = fds[fd].size_hi;
    while (rem_hi != 0 || rem_lo != 0) {
        if (fat32_read_next_sector(fd) != 0) {
            break;
        }
        chunk = 512;
        if (rem_hi == 0 && rem_lo < 512) {
            chunk = rem_lo;
        }
        i = 0;
        while (i < chunk) {
            ch = getbyte(sec_buf, i);
            if (ch == 10 && prev != 13) {
                uart_putc(13);
            }
            uart_putc(ch);
            prev = ch;
            wrote = 1;
            i++;
        }
        if (rem_lo < chunk) {
            rem_hi--;
        }
        rem_lo = rem_lo - chunk;
    }
    fat32_close(fd);
    if (wrote != 0 && prev != 10) {
        uart_nl();
    }
}

void shell_cmd_rm(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: rm <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_unlink(sh_arg);
    if (err == 0) {
        uart_puts("Removed ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Is a directory (use rmdir): ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to remove: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

// Copy second argument token from sh_line[sh_rest_idx..] into dst (max_bytes-1 chars).
// Returns length copied (0 if missing).
u16 shell_get_arg2(u16 *dst, u16 max_bytes) {
    u16 i  = sh_rest_idx;
    u16 j  = 0;
    u16 ch = 0;
    while (j < (max_bytes - 1)) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(dst, j, ch);
        i++;
        j++;
    }
    setbyte(dst, j, 0);
    return j;
}

void shell_cmd_write_mode(u16 append_mode) {
    u16 fd = 0;
    u16 i  = sh_rest_idx;
    u16 o  = 0;
    u16 ch = 0;

    if (getbyte(sh_arg, 0) == 0) {
        if (append_mode != 0) {
            uart_puts("Usage: append <file> <text>\r\n");
        } else {
            uart_puts("Usage: write <file> <text>\r\n");
        }
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }

    while (o < 62) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        setbyte(sys_buf, o, ch);
        o++;
        i++;
    }
    setbyte(sys_buf, o, 10);        // append '\n'
    o++;

    if (append_mode != 0) {
        fd = fat32_open_append(0, sh_arg);
    } else {
        fd = fat32_open_write(0, sh_arg);
    }
    if (fd == 0xFFFF) {
        uart_puts("Failed to open: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (fat32_write_bytes(fd, sys_buf, o) != o) {
        fat32_close(fd);
        uart_puts("Write error: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    fat32_close(fd);
    if (append_mode != 0) {
        uart_puts("Appended ");
    } else {
        uart_puts("Wrote ");
    }
    uart_puts(sh_arg);
    uart_nl();
}

void shell_cmd_mv(void) {
    u16 dst[16];
    u16 err = 0;

    if (getbyte(sh_arg, 0) == 0 || shell_get_arg2(dst, 32) == 0) {
        uart_puts("Usage: mv <src> <dst>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_rename(sh_arg, dst);
    if (err == 0) {
        uart_puts("Moved ");
        uart_puts(sh_arg);
        uart_puts(" -> ");
        uart_puts(dst);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Destination exists: ");
        uart_puts(dst);
        uart_nl();
    } else {
        uart_puts("Failed to move: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_cp(void) {
    u16 dst[16];
    u16 err = 0;

    if (getbyte(sh_arg, 0) == 0 || shell_get_arg2(dst, 32) == 0) {
        uart_puts("Usage: cp <src> <dst>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_copy(sh_arg, dst, sys_buf, SYS_BUF_WORDS << 1);
    if (err == 0) {
        uart_puts("Copied ");
        uart_puts(sh_arg);
        uart_puts(" -> ");
        uart_puts(dst);
        uart_nl();
    } else if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to copy: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_df(void) {
    u16 free_kb = 0;
    u16 tot     = 0;

    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    if (fat32_df() != 0) {
        uart_puts("df failed\r\n");
        return;
    }
    tot = df_used_lo + df_free_lo;
    if (sec_per_clus == 1) {
        free_kb = df_free_lo >> 1;
    } else {
        free_kb = df_free_lo * (sec_per_clus >> 1);
    }
    uart_puts("Clusters: ");
    uart_put_dec16(df_used_lo);
    uart_puts(" used, ");
    uart_put_dec16(df_free_lo);
    uart_puts(" free (");
    uart_put_dec16(tot);
    uart_puts(" total, ");
    uart_put_dec16(free_kb);
    uart_puts(" KB free)\r\n");
}

void shell_cmd_stat(void) {
    u16 err  = 0;
    u16 c_lo = 0;
    u16 c_hi = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: stat <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_stat(sh_arg, &sh_ent);
    if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (err != 0) {
        uart_puts("stat failed\r\n");
        return;
    }
    c_lo = tmp32_lo;
    c_hi = tmp32_hi;
    uart_puts(sh_ent.name);
    uart_puts("  size=");
    if (sh_ent.size_hi != 0) {
        uart_puts("0x");
        uart_put_hex16(sh_ent.size_hi);
        uart_put_hex16(sh_ent.size_lo);
    } else {
        uart_put_dec16(sh_ent.size_lo);
    }
    uart_puts(" bytes  attr=0x");
    uart_put_hex16(sh_ent.attr);
    uart_puts("  clus=0x");
    if (c_hi != 0) {
        uart_put_hex16(c_hi);
    }
    uart_put_hex16(c_lo);
    uart_nl();
}

void shell_cmd_echo(void) {
    u16 i  = sh_arg_idx;
    u16 ch = 0;
    while (true) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        uart_putc(ch);
        i++;
    }
    uart_nl();
}

void shell_cmd_clear(void) {
    uart_putc(27);
    uart_puts("[2J");
    uart_putc(27);
    uart_puts("[H");
}

// Build candidate path: prefix + name + ext into dst (max 31 chars)
void shell_build_path(u16 *dst, u16 *prefix, u16 *name, u16 *ext) {
    u16 o  = 0;
    u16 i  = 0;
    u16 ch = 0;

    while (o < 31) {
        ch = getbyte(prefix, i);
        if (ch == 0) {
            break;
        }
        setbyte(dst, o, ch);
        o++;
        i++;
    }
    i = 0;
    while (o < 31) {
        ch = getbyte(name, i);
        if (ch == 0) {
            break;
        }
        setbyte(dst, o, ch);
        o++;
        i++;
    }
    i = 0;
    while (o < 31) {
        ch = getbyte(ext, i);
        if (ch == 0) {
            break;
        }
        setbyte(dst, o, ch);
        o++;
        i++;
    }
    setbyte(dst, o, 0);
}

// Resolve executable name for `!`, `run`, and `&`:
//   1. Exact name in CWD (or explicit path)
//   2. <name>.PRG (if no '.')
//   3. /BIN/<name>[.PRG] (if no '/')
//   4. /<name>[.PRG] (if no '/')
u16 shell_resolve_exec_path(u16 *name, u16 *out) {
    u16 i         = 0;
    u16 ch        = 0;
    u16 has_slash = 0;
    u16 has_dot   = 0;
    u16 *ext      = "";

    while (true) {
        ch = getbyte(name, i);
        if (ch == 0) {
            break;
        }
        if (ch == 47) {
            has_slash = 1;
        } else if (ch == 46) {
            has_dot = 1;
        }
        i++;
    }
    if (has_dot == 0) {
        ext = ".PRG";
    }

    // 1. Exact path / name
    if (fat32_stat(name, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
        str_copy(out, name, 32);
        return 1;
    }
    // 2. Append .PRG in CWD / explicit dir
    if (has_dot == 0) {
        shell_build_path(out, "", name, ".PRG");
        if (fat32_stat(out, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
            return 1;
        }
    }
    // 3 & 4. Search /BIN/ then / for bare program names
    if (has_slash == 0) {
        shell_build_path(out, "/BIN/", name, ext);
        if (fat32_stat(out, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
            return 1;
        }
        shell_build_path(out, "/", name, ext);
        if (fat32_stat(out, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
            return 1;
        }
    }
    str_copy(out, name, 32);
    return 0;
}

void shell_script_close(void) {
    if (sh_script_fd != 0xFFFF) {
        fat32_close(sh_script_fd);
        sh_script_fd = 0xFFFF;
    }
    sh_sc_pos = 0;
    sh_sc_len = 0;
    setbyte(sh_script_args, 0, 0);
}

// Resolve script path for `do` and `@`:
//   - If a path containing '/' is provided, use it directly.
//   - Otherwise look for /BIN/<name>.DO (or /BIN/<name> if '.' present),
//     falling back to <name> / <name>.DO in CWD.
u16 shell_resolve_script_path(u16 *name, u16 *out) {
    u16 i         = 0;
    u16 ch        = 0;
    u16 has_slash = 0;
    u16 has_dot   = 0;
    u16 *ext      = "";

    while (true) {
        ch = getbyte(name, i);
        if (ch == 0) {
            break;
        }
        if (ch == 47) {
            has_slash = 1;
        } else if (ch == 46) {
            has_dot = 1;
        }
        i++;
    }
    if (has_dot == 0) {
        ext = ".DO";
    }

    if (has_slash != 0) {
        str_copy(out, name, 32);
        if (fat32_stat(name, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
            return 1;
        }
        return 0;
    }

    shell_build_path(out, "/BIN/", name, ext);
    if (fat32_stat(out, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
        return 1;
    }
    if (fat32_stat(name, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
        str_copy(out, name, 32);
        return 1;
    }
    if (has_dot == 0) {
        shell_build_path(out, "", name, ".DO");
        if (fat32_stat(out, &sh_ent) == 0 && (sh_ent.attr & ATTR_DIRECTORY) == 0) {
            return 1;
        }
    }
    str_copy(out, name, 32);
    return 0;
}

void shell_cmd_do(u16 *path_arg, u16 arg_off) {
    u16 sc_path[16];
    u16 i  = 0;
    u16 ch = 0;

    if (sh_script_fd != 0xFFFF) {
        uart_puts("Script already running\r\n");
        return;
    }
    if (getbyte(path_arg, 0) == 0) {
        uart_puts("Usage: do <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    shell_resolve_script_path(path_arg, sc_path);
    sh_script_fd = fat32_open(0, sc_path);
    if (sh_script_fd == 0xFFFF) {
        uart_puts("Script not found: ");
        uart_puts(path_arg);
        uart_nl();
        return;
    }
    setbyte(sh_script_args, 0, 0);
    while ((arg_off + i) < (LINE_MAX - 1)) {
        ch = getbyte(sh_line, arg_off + i);
        setbyte(sh_script_args, i, ch);
        if (ch == 0) {
            break;
        }
        i++;
    }
    setbyte(sh_script_args, i, 0);
    sh_sc_pos = 0;
    sh_sc_len = 0;
}

void shell_cmd_run(u16 foreground, u16 arg_off) {
    u16 pid  = 0;
    u16 mode = 0;
    u16 exec_path[16];

    if (getbyte(sh_arg, 0) == 0) {
        if (foreground != 0) {
            uart_puts("Usage: ! <file> [args]\r\n");
        } else {
            uart_puts("Usage: run <file> [args]\r\n");
        }
        return;
    }
    if (foreground != 0) {
        mode = 2;
    }
    shell_resolve_exec_path(sh_arg, exec_path);
    pid = proc_spawn_from_file(0, exec_path, sh_line, arg_off, mode);
    if (pid == 0) {
        if (proc_last_err == SPAWN_ERR_CORE) {
            uart_puts("No free worker core\r\n");
        } else {
            uart_puts("Failed to load file: ");
            uart_puts(sh_arg);
            uart_nl();
        }
    } else if (foreground == 0) {
        uart_puts("Spawned PID ");
        uart_putc(pid + 48);
        uart_puts(" (");
        uart_put_hex16(proc_last_words);
        uart_puts(" words)\r\n");
    }
}

void shell_cmd_fg(void) {
    u16 pid = 0;
    u16 err = 0;
    u16 i   = 0;
    u16 j   = 0;
    u16 ch  = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: fg [--fgoutput] <pid>\r\n");
        return;
    }
    if (str_eq(sh_arg, "--fgoutput") == 1) {
        i = sh_rest_idx;
        j = 0;
        while (j < 15) {
            ch = getbyte(sh_line, i);
            if (ch == 0 || ch == 32) {
                break;
            }
            setbyte(sh_arg, j, ch);
            i++;
            j++;
        }
        setbyte(sh_arg, j, 0);
        if (j == 0) {
            uart_puts("Usage: fg --fgoutput <pid>\r\n");
            return;
        }
        pid = parse_u16(sh_arg);
        err = proc_set_fg_output(pid);
        if (err == 0) {
            uart_puts("Console output enabled for PID ");
            uart_putc(pid + 48);
            uart_nl();
        } else {
            uart_puts("fg failed\r\n");
        }
        return;
    }

    pid = parse_u16(sh_arg);
    err = proc_set_fg(pid);
    if (err != 0) {
        uart_puts("fg failed\r\n");
    }
}

void shell_cmd_bg(void) {
    u16 pid = 0;
    u16 err = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: bg <pid>\r\n");
        return;
    }
    pid = parse_u16(sh_arg);
    err = proc_set_bg(pid);
    if (err == 0) {
        uart_puts("Backgrounded PID ");
        uart_putc(pid + 48);
        uart_nl();
    } else {
        uart_puts("bg failed\r\n");
    }
}

void shell_exec(void) {
    u16 pid = 0;
    u16 err = 0;
    u16 i   = 0;
    u16 ch  = 0;
    u16 arg_off = 0;

    shell_tokenize();
    if (getbyte(sh_cmd, 0) == 0) {
        return;
    }

    ch = getbyte(sh_cmd, 0);
    if (ch == 64) {
        // Support "@ <file>" and "@<file>" (alias for "do")
        if (getbyte(sh_cmd, 1) != 0) {
            i = 0;
            while (getbyte(sh_line, i) == 32) {
                i++;
            }
            i++;                        // Skip '@'
            pid = 0;
            while (pid < 31) {
                ch = getbyte(sh_line, i);
                if (ch == 0 || ch == 32) {
                    break;
                }
                setbyte(sh_arg, pid, ch);
                i++;
                pid++;
            }
            setbyte(sh_arg, pid, 0);
            arg_off = sh_arg_idx;
        } else {
            arg_off = sh_rest_idx;
        }
        shell_cmd_do(sh_arg, arg_off);
        return;
    }
    if (ch == 33 || ch == 38) {
        // Support "! APP [args]", "!APP [args]" (fg) and "& APP [args]", "&APP [args]" (bg)
        pid = 0;
        if (ch == 33) {
            pid = 1;
        }
        if (getbyte(sh_cmd, 1) != 0) {
            i = 1;
            while (i < 16) {
                ch = getbyte(sh_cmd, i);
                setbyte(sh_arg, i - 1, ch);
                if (ch == 0) {
                    break;
                }
                i++;
            }
            setbyte(sh_arg, 15, 0);
            shell_cmd_run(pid, sh_arg_idx);
        } else {
            shell_cmd_run(pid, sh_rest_idx);
        }
        return;
    }

    if (str_eq(sh_cmd, "help") == 1) {
        uart_puts("Commands: ps, ! <file> [args], run/& <file> [args], do/@ <file> [args] ($1, $2, ...), fg [--fgoutput] <pid>, bg <pid>, kill <pid>, pwd, cd [dir], ls [dir], mkdir <dir>, rmdir <dir>, cat <file>, stat <path>, write/append <file> <text>, cp/mv <src> <dst>, rm <file>, df, echo <text>, clear\r\n");
    } else if (str_eq(sh_cmd, "do") == 1) {
        shell_cmd_do(sh_arg, sh_rest_idx);
    } else if (str_eq(sh_cmd, "ps") == 1) {
        proc_print_ps();
    } else if (str_eq(sh_cmd, "fg") == 1) {
        shell_cmd_fg();
    } else if (str_eq(sh_cmd, "bg") == 1) {
        shell_cmd_bg();
    } else if (str_eq(sh_cmd, "kill") == 1) {
        pid = parse_u16(sh_arg);
        err = proc_kill(pid);
        if (err == 0) {
            uart_puts("Killed PID ");
            uart_putc(pid + 48);
            uart_nl();
        } else {
            uart_puts("kill failed\r\n");
        }
    } else if (str_eq(sh_cmd, "pwd") == 1) {
        shell_cmd_pwd();
    } else if (str_eq(sh_cmd, "cd") == 1) {
        shell_cmd_cd();
    } else if (str_eq(sh_cmd, "ls") == 1) {
        shell_cmd_ls();
    } else if (str_eq(sh_cmd, "mkdir") == 1) {
        shell_cmd_mkdir();
    } else if (str_eq(sh_cmd, "rmdir") == 1) {
        shell_cmd_rmdir();
    } else if (str_eq(sh_cmd, "run") == 1) {
        shell_cmd_run(0, sh_rest_idx);
    } else if (str_eq(sh_cmd, "cat") == 1) {
        shell_cmd_cat();
    } else if (str_eq(sh_cmd, "rm") == 1) {
        shell_cmd_rm();
    } else if (str_eq(sh_cmd, "write") == 1) {
        shell_cmd_write_mode(0);
    } else if (str_eq(sh_cmd, "append") == 1) {
        shell_cmd_write_mode(1);
    } else if (str_eq(sh_cmd, "mv") == 1) {
        shell_cmd_mv();
    } else if (str_eq(sh_cmd, "cp") == 1) {
        shell_cmd_cp();
    } else if (str_eq(sh_cmd, "df") == 1) {
        shell_cmd_df();
    } else if (str_eq(sh_cmd, "stat") == 1) {
        shell_cmd_stat();
    } else if (str_eq(sh_cmd, "echo") == 1) {
        shell_cmd_echo();
    } else if (str_eq(sh_cmd, "clear") == 1) {
        shell_cmd_clear();
    } else {
        uart_puts("Unknown command: ");
        uart_puts(sh_cmd);
        uart_nl();
    }
}

void shell_hist_push(void) {
    if (sh_len == 0) {
        return;
    }
    str_copy(&sh_hist[sh_hist_next * LINE_WORDS], sh_line, LINE_MAX);
    sh_hist_next++;
    if (sh_hist_next >= HIST_MAX) {
        sh_hist_next = 0;
    }
    if (sh_hist_count < HIST_MAX) {
        sh_hist_count++;
    }
    sh_hist_nav = 0;
}

void shell_redraw_line(u16 *new_str) {
    u16 i  = 0;
    u16 ch = 0;

    while (sh_len > 0) {
        sh_len--;
        uart_putc(8);
        uart_putc(32);
        uart_putc(8);
    }
    if (new_str == 0) {
        setbyte(sh_line, 0, 0);
        return;
    }
    while (i < (LINE_MAX - 1)) {
        ch = getbyte(new_str, i);
        if (ch == 0) {
            break;
        }
        setbyte(sh_line, i, ch);
        uart_putc(ch);
        i++;
    }
    setbyte(sh_line, i, 0);
    sh_len = i;
}

void shell_hist_load(u16 nav_back) {
    u16 slot = sh_hist_next + HIST_MAX - nav_back;
    if (slot >= HIST_MAX) {
        slot = slot - HIST_MAX;
    }
    shell_redraw_line(&sh_hist[slot * LINE_WORDS]);
}

u16 shell_script_getc(void) {
    u16 ch = 0;
    if (sh_sc_pos >= sh_sc_len) {
        sh_sc_len = fat32_read_bytes(sh_script_fd, sh_sc_buf, LINE_MAX);
        sh_sc_pos = 0;
        if (sh_sc_len == 0) {
            return 0xFFFF;
        }
    }
    ch = getbyte(sh_sc_buf, sh_sc_pos);
    sh_sc_pos++;
    return ch;
}

// Read next non-empty, non-comment command line from active script into sh_line.
// Returns 1 if a command line is ready, 0 on EOF.
u16 shell_script_read_line(void) {
    u16 ch = 0;
    u16 i  = 0;

    while (true) {
        sh_len = 0;
        while (true) {
            ch = shell_script_getc();
            if (ch == 0xFFFF || ch == 10) {
                break;
            }
            if (ch == 13) {
                continue;
            }
            if (sh_len < (LINE_MAX - 1)) {
                setbyte(sh_line, sh_len, ch);
                sh_len++;
            }
        }
        setbyte(sh_line, sh_len, 0);
        if (sh_len == 0 && ch == 0xFFFF) {
            return 0;
        }
        // Skip leading whitespace and ignore empty or '#' comment lines
        i = 0;
        while (i < sh_len) {
            ch = getbyte(sh_line, i);
            if (ch != 32 && ch != 9) {
                break;
            }
            i++;
        }
        if (i < sh_len && getbyte(sh_line, i) != 35) {
            return 1;
        }
    }
    return 0;
}

u16 shell_script_append_char(u16 ch) {
    if (sh_sc_expand_len >= (LINE_MAX - 1)) {
        return 0;
    }
    setbyte(sh_sc_expand, sh_sc_expand_len, ch);
    sh_sc_expand_len++;
    return 1;
}

u16 shell_script_append_arg(u16 arg_num) {
    u16 i = 0;
    u16 current = 1;
    u16 ch = 0;

    while (current < arg_num && getbyte(sh_script_args, i) != 0) {
        while (getbyte(sh_script_args, i) != 0 && getbyte(sh_script_args, i) != 32) {
            i++;
        }
        while (getbyte(sh_script_args, i) == 32) {
            i++;
        }
        current++;
    }
    if (current != arg_num) {
        return 1;
    }
    while (true) {
        ch = getbyte(sh_script_args, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        if (shell_script_append_char(ch) == 0) {
            return 0;
        }
        i++;
    }
    return 1;
}

u16 shell_script_expand_line(void) {
    u16 i = 0;
    u16 ch = 0;
    u16 next = 0;
    u16 arg_num = 0;
    u16 digit_start = 0;
    u16 digit = 0;

    sh_sc_expand_len = 0;
    while (true) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        next = getbyte(sh_line, i + 1);
        if (ch == 36 && next >= 48 && next <= 57) {
            i++;
            digit_start = i;
            arg_num = 0;
            while (true) {
                digit = getbyte(sh_line, i);
                if (digit < 48 || digit > 57) {
                    break;
                }
                if (arg_num < 64) {
                    arg_num = (arg_num * 10) + digit - 48;
                    if (arg_num > 63) {
                        arg_num = 64;
                    }
                }
                i++;
            }
            if (arg_num == 0) {
                if (shell_script_append_char(36) == 0) {
                    return 0;
                }
                while (digit_start < i) {
                    if (shell_script_append_char(getbyte(sh_line, digit_start)) == 0) {
                        return 0;
                    }
                    digit_start++;
                }
            } else if (shell_script_append_arg(arg_num) == 0) {
                return 0;
            }
            continue;
        }
        if (shell_script_append_char(ch) == 0) {
            return 0;
        }
        i++;
    }
    setbyte(sh_sc_expand, sh_sc_expand_len, 0);
    i = 0;
    while (i < sh_sc_expand_len) {
        setbyte(sh_line, i, getbyte(sh_sc_expand, i));
        i++;
    }
    setbyte(sh_line, i, 0);
    sh_len = sh_sc_expand_len;
    return 1;
}

// Execute one pending command from an active script whenever no fg worker is running.
void shell_script_step(void) {
    if (sh_script_fd == 0xFFFF || fg_pid != 0) {
        return;
    }
    if (shell_script_read_line() == 0) {
        shell_script_close();
        sh_len = 0;
        shell_prompt();
        return;
    }
    if (shell_script_expand_line() == 0) {
        uart_puts("Script expansion too long\r\n");
        sh_len = 0;
        return;
    }
    shell_exec();
    sh_len = 0;
}

void shell_poll(void) {
    u16 ch  = uart_poll_getc();
    u16 pid = 0;
    if (ch == 0xFFFF) {
        return;
    }

    if (fg_pid != 0) {
        if (ch == 26) {                 // Ctrl-Z: detach foreground to background
            pid = fg_pid;
            proc_set_bg(pid);
            uart_puts("\r\n[Backgrounded PID ");
            uart_putc(pid + 48);
            uart_puts("]\r\n");
            if (sh_script_fd == 0xFFFF) {
                shell_prompt();
            }
        } else if (ch == 3) {           // Ctrl-C: kill foreground worker (+ abort script)
            pid = fg_pid;
            proc_kill(pid);
            shell_script_close();
            uart_puts("\r\n^C Killed PID ");
            uart_putc(pid + 48);
            uart_nl();
            shell_prompt();
        } else {
            fg_rx_push(ch);
        }
        return;
    }

    if (sh_script_fd != 0xFFFF) {
        if (ch == 3) {                  // Ctrl-C: abort active script
            shell_script_close();
            uart_puts("\r\n^C Script aborted\r\n");
            shell_prompt();
        }
        return;
    }

    // ANSI escape sequence handling for Up (ESC [ A) / Down (ESC [ B) history
    if (sh_esc_state == 1) {
        if (ch == 91) {                 // '['
            sh_esc_state = 2;
        } else {
            sh_esc_state = 0;
        }
        return;
    }
    if (sh_esc_state == 2) {
        sh_esc_state = 0;
        if (ch == 65) {                 // Up arrow -> older history entry
            if (sh_hist_nav < sh_hist_count) {
                sh_hist_nav++;
                shell_hist_load(sh_hist_nav);
            }
        } else if (ch == 66) {          // Down arrow -> newer entry or blank line
            if (sh_hist_nav > 1) {
                sh_hist_nav--;
                shell_hist_load(sh_hist_nav);
            } else if (sh_hist_nav == 1) {
                sh_hist_nav = 0;
                shell_redraw_line(0);
            }
        }
        return;
    }
    if (ch == 27) {                     // ESC
        sh_esc_state = 1;
        return;
    }

    if (ch == 13 || ch == 10) {
        setbyte(sh_line, sh_len, 0);
        shell_hist_push();
        uart_nl();
        shell_exec();
        sh_len = 0;
        if (fg_pid == 0 && sh_script_fd == 0xFFFF) {
            shell_prompt();
        }
    } else if (ch == 8 || ch == 127) {
        sh_hist_nav = 0;
        if (sh_len > 0) {
            sh_len--;
            uart_putc(8);
            uart_putc(32);
            uart_putc(8);
        }
    } else if (ch >= 32 && ch < 127 && sh_len < (LINE_MAX - 1)) {
        sh_hist_nav = 0;
        setbyte(sh_line, sh_len, ch);
        sh_len++;
        uart_putc(ch);
    }
}
