0534    msg_returned:                              ; [00]
0535        .asciz "\r\n[Program returned to monitor]\r\n" ; [0D 0A 5B 50 72 6F 67 72 61 6D 20 72 65 74 75 72 6E 65 64 20 74 6F 20 6D 6F 6E 69 74 6F 72 5D 0D 0A 00]

        next_examine_addr:
0546        .word 0x0000                           ; [00 00]

        dump_ptr:
0547        .word 0x0000                           ; [00 00]

        dump_cnt:
0548        .word 0x0000                           ; [00 00]

        line_buffer:
0549        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
0551        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
0559        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
0561        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]

; ==============================================================================
; Runtime Library Inclusion at the Bottom
; ==============================================================================
; ==============================================================================
; FILE: lib/M4R_LIB.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Math & Relational Runtime Subroutine Library for MiniRISC4.
;   Provides 16-bit unsigned multiplication (MULT), restoring integer division (DIV),
;   modulo/remainder (MOD), and unsigned relational comparisons (_CMP_*).
;
; Table of Contents:
;   1. SUBROUTINE: MULT        - 16-bit unsigned binary multiplication
;   2. HELPER:     DIVMOD_CORE - 16-bit binary restoring division engine
;   3. SUBROUTINE: DIV         - 16-bit unsigned integer division
;   4. SUBROUTINE: MOD         - 16-bit unsigned integer remainder / modulo
;   5. RELATIONAL: _CMP_LT     - Unsigned Less-Than comparison (<)
;   6. RELATIONAL: _CMP_LE     - Unsigned Less-Than-or-Equal comparison (<=)
;   7. RELATIONAL: _CMP_GT     - Unsigned Greater-Than comparison (>)
;   8. RELATIONAL: _CMP_GE     - Unsigned Greater-Than-or-Equal comparison (>=)
;
; Calling Conventions & Stack Rules:
;   - Argument Stack (ASP @ 0x0005, Base 0xFAFF):
;       Math routines (MULT, DIV, MOD) receive operands on the Argument Stack.
;       Binary operands (A op B):
;         Top of Stack (first popped)  : Operand B (RHS / Multiplier / Divisor)
;         Second on Stack (next popped): Operand A (LHS / Multiplicand / Dividend)
;       Result is pushed back onto the Argument Stack and returned in R1.
;   - Return Stack (RSP @ 0x0004, Base 0xFEFF):
;       All routines preserve caller return linkage on the Return Stack via
;       RPUSH R0 upon entry, returning via RRET (RPOP R0; JMP R0).
;   - Comparison Helpers (_CMP_*):
;       Operands passed in primary registers: R1 = LHS (A), R2 = RHS (B).
;       Boolean result returned in R1 (1 = True, 0 = False).
;   - Register-Indirect Branching:
;       All branches (JMP, JMP.Z, JMP.M, LINK) are strictly register-indirect.
;       Target addresses are pre-loaded into registers via LOAD16 prior to branching.
; ==============================================================================


; ==============================================================================
; SECTION 1: 16-Bit Binary Multiplication (MULT)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MULT
; Description:
;   Performs 16-bit unsigned multiplication: Product = A * B (modulo 65536).
;   Uses the classic shift-and-add binary multiplication algorithm with an
;   explicit 16-step iteration counter.
;
; Algorithm:
;   1. Pop Multiplier (B) into R2 and Multiplicand (A) into R1 from ASP.
;   2. Clear product accumulator (R3 = 0).
;   3. For each of the 16 bits:
;      a. Test LSB of Multiplier by rotating right (ROT.R R2) into bit 15 (sign bit).
;      b. If bit 15 is 1, jump to _MULT_ADD to add Multiplicand to Accumulator.
;      c. Restore Multiplier bit alignment (ROT.L R2), shift Multiplier right by 1,
;         and shift Multiplicand left by 1.
;      d. Decrement loop counter. Exit early if Multiplier reaches 0.
;   4. Return 16-bit product in R1 and push onto ASP.
;
; Stack Layout:
;   Entry: [ASP]   = Multiplier (B)
;          [ASP+1] = Multiplicand (A)
;   Exit:  [ASP]   = Product (A * B & 0xFFFF)
;
; Registers:
;   R1 = Multiplicand (A) -> Product output
;   R2 = Multiplier (B)
;   R3 = Product Accumulator (caller R3 preserved in shadow_r[3])
;   shadow_r[0] = 16-step loop counter
; ==============================================================================
        MULT:
0569        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0569        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]

    ; Pop operands from Argument Stack (0x0005)
056F        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
056F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0575        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0575        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]

    ; Free R3 to act as product accumulator; preserve caller R3 in hardware shadow
057B        XCHG    R3                  ; shadow_r[3] = caller R3 ; [BF]
057B        XOR     R3, R3                         ; [9F]

    ; Initialize 16-iteration loop counter in shadow_r[0]
057C        XCHG    R0                  ; shadow_r[0] = caller R0 ; [BC]
057C        PUSH8   R0, >(16)                      ; [00 F8 00 F8 10]
057C        PUSH8   R0, <(16)                      ; [00 F8 00 F8 10]
057F        XCHG    R0                  ; R0 restored; shadow_r[0] = 16 ; [BC]

057F    _MULT_LOOP:                                ; [00]
    ; Optimization: check if remaining Multiplier bits are zero -> exit early
0580        PUSH8   R0, >(_MULT_DONE)              ; [F8 05 F8 94]
0580        PUSH8   R0, <(_MULT_DONE)              ; [F8 05 F8 94]
0582        JMP.Z   R0, R2              ; If R2 == 0, multiplication complete ; [D2]

    ; Test LSB (bit 0) of Multiplier: rotate right shifts bit 0 into bit 15 (sign bit)
0582        ROT.R   R2                             ; [C6]
0583        PUSH8   R0, >(_MULT_ADD)               ; [F8 05 F8 8A]
0583        PUSH8   R0, <(_MULT_ADD)               ; [F8 05 F8 8A]
0585        JMP.M   R0, R2              ; If bit 15 is 1 (negative), bit 0 was set -> add ; [E2]

    ; Bit 0 was 0: no addition, proceed with bit shifts
0585        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0586        SHIFT.R R2                  ; Multiplier >>= 1 (logical right shift) ; [B6]
0586        SHIFT.L R1                  ; Multiplicand <<= 1 (logical left shift) ; [B1]
0587        PUSH8   R0, >(_MULT_DEC)               ; [F8 05 F8 8C]
0587        PUSH8   R0, <(_MULT_DEC)               ; [F8 05 F8 8C]
0589        JMP     R0                  ; Decrement iteration counter ; [F0]

0589    _MULT_ADD:                                 ; [00]
058A        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
058A        ADD     R3, R1              ; Accumulator += Multiplicand ; [6D]
058B        SHIFT.R R2                  ; Multiplier >>= 1 ; [B6]
058B        SHIFT.L R1                  ; Multiplicand <<= 1 ; [B1]

        _MULT_DEC:
058C        XCHG    R0                  ; Access loop counter from shadow_r[0] ; [BC]
058C        DEC     R0                  ; counter-- ; [CC]
058D        PUSH8   R1, >(_MULT_DONE_CTR)          ; [F9 05 F9 93]
058D        PUSH8   R1, <(_MULT_DONE_CTR)          ; [F9 05 F9 93]
058F        JMP.Z   R1, R0              ; If counter == 0, loop finished ; [D4]
058F        XCHG    R0                  ; Save updated counter back to shadow_r[0] ; [BC]

0590        PUSH8   R0, >(_MULT_LOOP)              ; [F8 05 F8 80]
0590        PUSH8   R0, <(_MULT_LOOP)              ; [F8 05 F8 80]
0592        JMP     R0                             ; [F0]

0592    _MULT_DONE_CTR:                            ; [00]
0593        XCHG    R0                  ; Restore shadow_r[0] / caller R0 ; [BC]

0593    _MULT_DONE:                                ; [00]
0594        LD      R1, R3              ; R1 = Final 16-bit Product ; [07]
0594        XCHG    R3                  ; Restore caller R3 from shadow_r[3] ; [BF]
0595        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0595        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
059B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
059B        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]


; ==============================================================================
; SECTION 2: 16-Bit Restoring Division Engine (DIVMOD_CORE)
; ==============================================================================

; ==============================================================================
; HELPER: DIVMOD_CORE
; Description:
;   Core 16-bit unsigned restoring division routine.
;   Computes both quotient and remainder simultaneously using shift-and-subtract.
;
; Inputs:
;   R1 = Dividend (N)
;   R2 = Divisor (D)
; Outputs:
;   R1 = Quotient (N / D)
;   R3 = Remainder (N % D)
;
; Special Cases:
;   Division by Zero: If D == 0, returns Quotient = 0xFFFF, Remainder = Dividend (N).
;
; Registers:
;   R1 = Dividend (shifts left; quotient bits shifted into LSB) -> returns Quotient
;   R2 = Divisor (preserved in shadow_r[2] during loop)
;   R3 = Remainder accumulator -> returns Remainder
;   shadow_r[0] = 16-iteration loop counter
; ==============================================================================
        DIVMOD_CORE:
05A2        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05A2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]

    ; Check for divide-by-zero condition (Divisor R2 == 0)
05A8        PUSH8   R0, >(_DIV_ZERO)               ; [F8 05 F8 D5]
05A8        PUSH8   R0, <(_DIV_ZERO)               ; [F8 05 F8 D5]
05AA        JMP.Z   R0, R2              ; If R2 == 0, branch to error handler ; [D2]

05AA        XOR     R3, R3                         ; [9F]

    ; Preserve Divisor in shadow_r[2] so R2 is available for branch scratch
05AB        XCHG    R2                             ; [BE]

    ; Initialize 16-bit loop counter in shadow_r[0]
05AB        XCHG    R0                             ; [BC]
05AC        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
05AC        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
05AE        XCHG    R0                             ; [BC]

05AE    _DIV_BIT_LOOP:                             ; [00]
05AF        SHIFT.L R3                  ; Remainder <<= 1 ; [B3]

    ; Shift MSB of Dividend into LSB of Remainder
05AF        PUSH8   R2, >(_DIV_CARRY_IN)           ; [00 FA 05 FA B6]
05AF        PUSH8   R2, <(_DIV_CARRY_IN)           ; [00 FA 05 FA B6]
05B2        JMP.M   R2, R1              ; Test bit 15 (MSB) of Dividend ; [E9]

05B2        PUSH8   R2, >(_DIV_SHIFT_CONT)         ; [00 FA 05 FA B7]
05B2        PUSH8   R2, <(_DIV_SHIFT_CONT)         ; [00 FA 05 FA B7]
05B5        JMP     R2                             ; [F2]

05B5    _DIV_CARRY_IN:                             ; [00]
05B6        INC     R3                  ; Remainder |= 1 (MSB shifted out of Dividend was 1) ; [CB]

05B6    _DIV_SHIFT_CONT:                           ; [00]
05B7        SHIFT.L R1                  ; Dividend <<= 1 (shifts quotient bit into LSB) ; [B1]

    ; Compare current Remainder (R3) with Divisor (held in shadow_r[2])
05B7        XCHG    R2                  ; R2 = Divisor, shadow_r[2] = scratch ; [BE]
05B8        XCHG    R0                  ; R0 = loop counter, shadow_r[0] = scratch ; [BC]
05B8        XCHG    R0                  ; Restore R0 ; [BC]

    ; Compute test trial subtraction: difference = Remainder - Divisor
05B9        XCHG    R0                             ; [BC]
05B9        LD      R0, R3                         ; [03]
05BA        SUB     R0, R2              ; R0 = Remainder - Divisor ; [72]
05BA        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Check if trial subtraction produced a negative result
05BB        XCHG    R0                  ; R0 = difference ; [BC]
05BB        PUSH8   R2, >(_DIV_NO_SUB)             ; [00 FA 05 FA C4]
05BB        PUSH8   R2, <(_DIV_NO_SUB)             ; [00 FA 05 FA C4]
05BE        JMP.M   R2, R0              ; If negative, cannot subtract -> skip ; [E8]
05BE        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Successful subtraction: Remainder gets difference, Quotient LSB = 1
05BF        XCHG    R0                             ; [BC]
05BF        LD      R3, R0              ; Remainder = difference (subtraction committed) ; [0C]
05C0        XCHG    R0                             ; [BC]
05C0        INC     R1                  ; Quotient LSB = 1 ; [C9]

05C1        PUSH8   R2, >(_DIV_DEC_LOOP)           ; [FA 05 FA C5]
05C1        PUSH8   R2, <(_DIV_DEC_LOOP)           ; [FA 05 FA C5]
05C3        JMP     R2                             ; [F2]

05C3    _DIV_NO_SUB:                               ; [00]
05C4        XCHG    R0                  ; Restore R0 ; [BC]

05C4    _DIV_DEC_LOOP:                             ; [00]
05C5        XCHG    R2                  ; Restore Divisor back into shadow_r[2] ; [BE]
05C5        XCHG    R0                  ; Access loop counter ; [BC]
05C6        DEC     R0                  ; counter-- ; [CC]
05C6        PUSH8   R2, >(_DIV_EXIT)               ; [00 FA 05 FA CD]
05C6        PUSH8   R2, <(_DIV_EXIT)               ; [00 FA 05 FA CD]
05C9        JMP.Z   R2, R0              ; If counter == 0, division complete ; [D8]
05C9        XCHG    R0                  ; Save counter back to shadow_r[0] ; [BC]

05CA        PUSH8   R0, >(_DIV_BIT_LOOP)           ; [F8 05 F8 AF]
05CA        PUSH8   R0, <(_DIV_BIT_LOOP)           ; [F8 05 F8 AF]
05CC        JMP     R0                             ; [F0]

05CC    _DIV_EXIT:                                 ; [00]
05CD        XCHG    R0                  ; Restore original R0 ; [BC]
05CD        XCHG    R2                  ; Restore original R2 (Divisor) ; [BE]
05CE        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05CE        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

        _DIV_ZERO:
    ; Divide by zero: Remainder = original Dividend, Quotient = 0xFFFF
05D5        LD      R3, R1              ; Remainder = Dividend ; [0D]
05D5        XOR     R1, R1                         ; [95]
05D6        DEC     R1                  ; R1 = 0xFFFF (standard unsigned error quotient) ; [CD]
05D6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05D6        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]


; ==============================================================================
; SECTION 3: 16-Bit Unsigned Integer Division (DIV)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: DIV
; Description:
;   16-bit unsigned integer division: Quotient = Dividend / Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Quotient (N / D)
; Register : R1 = Quotient
; ==============================================================================
05DD    DIV:                                       ; [00]
05DE        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05DE        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
05E4        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05E4        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
05EA        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05EA        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
05F0        PUSH8   R0, >(DIVMOD_CORE)             ; [F8 05 F8 A2 F4 00]
05F0        PUSH8   R0, <(DIVMOD_CORE)             ; [F8 05 F8 A2 F4 00]
05F0        LINK    R0, R0                         ; [F8 05 F8 A2 F4 00]
05F3        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F3        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
05F9        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
05F9        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]


; ==============================================================================
; SECTION 4: 16-Bit Unsigned Integer Modulo (MOD)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MOD
; Description:
;   16-bit unsigned integer remainder: Remainder = Dividend % Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Remainder (N % D)
; Register : R1 = Remainder
; ==============================================================================
        MOD:
0600        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0600        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0606        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
0606        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE BC]
060C        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
060C        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE BC]
0612        PUSH8   R0, >(DIVMOD_CORE)             ; [F8 05 F8 A2 F4 00]
0612        PUSH8   R0, <(DIVMOD_CORE)             ; [F8 05 F8 A2 F4 00]
0612        LINK    R0, R0                         ; [F8 05 F8 A2 F4 00]
0615        LD      R1, R3              ; Move Remainder to return register R1 ; [07]
0615        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
0615        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE BC]
061B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
061B        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]


; ==============================================================================
; SECTION 5: Unsigned Relational Comparisons (_CMP_LT, _CMP_LE, _CMP_GT, _CMP_GE)
; Description:
;   Evaluates 16-bit unsigned inequalities across the entire 0x0000-0xFFFF range.
;   Because MiniRISC4 only supports JMP.M (sign bit is 1) and JMP.Z (zero) on
;   register contents, unsigned comparison must differentiate between numbers
;   with differing MSBs (where bit 15 represents the 0x8000 boundary) and numbers
;   with identical MSBs (where standard subtraction gives the correct magnitude).
;
; Inputs:
;   R1 = Left-Hand Side (LHS / A)
;   R2 = Right-Hand Side (RHS / B)
; Outputs:
;   R1 = 1 if the condition is True
;   R1 = 0 if the condition is False
; ==============================================================================

; ==============================================================================
; SUBROUTINE: _CMP_LT  (Unsigned Less-Than: A < B)
; ==============================================================================
0622    _CMP_LT:                                   ; [00]
0623        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0623        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]

    ; Step 1: Compare MSBs (bit 15) using XOR
0629        XCHG    R0                             ; [BC]
0629        LD      R0, R1                         ; [01]
062A        XOR     R0, R2              ; If bit 15 is set, operands have opposite signs ; [92]
062A        PUSH8   R3, >(_CMP_LT_DIFF_SIGNS)      ; [00 FB 06 FB 35]
062A        PUSH8   R3, <(_CMP_LT_DIFF_SIGNS)      ; [00 FB 06 FB 35]
062D        JMP.M   R3, R0              ; Branch if MSBs are different ; [EC]
062D        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: MSBs are identical -> standard subtraction A - B gives correct relation
062E        SUB     R1, R2              ; R1 = A - B ; [76]
062E        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 06 F8 7F]
062E        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 06 F8 7F]
0631        JMP.M   R0, R1              ; If difference is negative, A < B -> True ; [E1]
0631        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 06 F8 88]
0631        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 06 F8 88]
0634        JMP     R0                  ; Else A >= B -> False ; [F0]

0634    _CMP_LT_DIFF_SIGNS:                        ; [00]
0635        XCHG    R0                  ; Restore R0 ; [BC]
    ; When MSBs differ: the operand with MSB=1 is in range [0x8000..0xFFFF],
    ; while the operand with MSB=0 is in range [0x0000..0x7FFF].
    ; Therefore, if LHS (R1) has bit 15 set, LHS is strictly larger -> False.
0635        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 06 F8 88]
0635        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 06 F8 88]
0638        JMP.M   R0, R1              ; If R1[15] == 1, A > B -> False ; [E1]
0638        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 06 F8 7F]
0638        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 06 F8 7F]
063B        JMP     R0                  ; Else A < B -> True ; [F0]

; ==============================================================================
; SUBROUTINE: _CMP_LE  (Unsigned Less-Than-or-Equal: A <= B)
; ==============================================================================
063B    _CMP_LE:                                   ; [00]
063C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
063C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]

    ; Step 1: Check equality (A == B)
0642        XCHG    R0                             ; [BC]
0642        LD      R0, R1                         ; [01]
0643        SUB     R0, R2              ; Test difference A - B ; [72]
0643        PUSH8   R3, >(_CMP_LE_EQUAL)           ; [00 FB 06 FB 51]
0643        PUSH8   R3, <(_CMP_LE_EQUAL)           ; [00 FB 06 FB 51]
0646        JMP.Z   R3, R0              ; If A == B, branch to True ; [DC]
0646        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: Not equal -> evaluate A < B
0647        PUSH8   R0, >(_CMP_LT)                 ; [F8 06 F8 23 F4 00]
0647        PUSH8   R0, <(_CMP_LT)                 ; [F8 06 F8 23 F4 00]
0647        LINK    R0, R0                         ; [F8 06 F8 23 F4 00]
064A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
064A        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

        _CMP_LE_EQUAL:
0651        XCHG    R0                  ; Restore R0 ; [BC]
0651        PUSH8   R1, >(1)                       ; [00 F9 00 F9 01]
0651        PUSH8   R1, <(1)                       ; [00 F9 00 F9 01]
0654        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0654        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

; ==============================================================================
; SUBROUTINE: _CMP_GT  (Unsigned Greater-Than: A > B)
; Note: A > B is logically equivalent to B < A
; ==============================================================================
        _CMP_GT:
065B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
065B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0661        XOR     R1, R2                         ; [96 99 96]
0661        XOR     R2, R1                         ; [96 99 96]
0661        XOR     R1, R2                         ; [96 99 96]
0662        PUSH8   R0, >(_CMP_LT)                 ; [00 F8 06 F8 23 F4 00]
0662        PUSH8   R0, <(_CMP_LT)                 ; [00 F8 06 F8 23 F4 00]
0662        LINK    R0, R0                         ; [00 F8 06 F8 23 F4 00]
0666        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0666        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

; ==============================================================================
; SUBROUTINE: _CMP_GE  (Unsigned Greater-Than-or-Equal: A >= B)
; Note: A >= B is logically equivalent to B <= A
; ==============================================================================
        _CMP_GE:
066D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
066D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0673        XOR     R1, R2                         ; [96 99 96]
0673        XOR     R2, R1                         ; [96 99 96]
0673        XOR     R1, R2                         ; [96 99 96]
0674        PUSH8   R0, >(_CMP_LE)                 ; [00 F8 06 F8 3C F4 00]
0674        PUSH8   R0, <(_CMP_LE)                 ; [00 F8 06 F8 3C F4 00]
0674        LINK    R0, R0                         ; [00 F8 06 F8 3C F4 00]
0678        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0678        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

; ==============================================================================
; Boolean Return Exit Points
; ==============================================================================
        _CMP_RET_TRUE:
067F        PUSH8   R1, >(1)                       ; [F9 00 F9 01]
067F        PUSH8   R1, <(1)                       ; [F9 00 F9 01]
0681        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0681        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

        _CMP_RET_FALSE:
0688        XOR     R1, R1                         ; [95]
0688        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0688        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
