; SUBROUTINE: skip_spaces
; Inputs/Outputs: R3 = pointer into buffer
; ------------------------------------------------------------------------------
        skip_spaces:
0421        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0421        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0421        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
