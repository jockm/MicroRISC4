}

u16 sys_read(u16 fd, u16 *dst_buf, u16 max_words, u16 *out_words) {
    _sys_p1 = dst_buf;
    _sys_p2 = max_words;
    _sys_p3 = fd;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LOAD16  R0, __sys_p3
        LD      R3, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x20
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    _sys_w = out_words;
    _sys_w[0] = _sys_r2;
    return _sys_r1;
}

u16 sys_ps(u16 idx, ProcEntry *out_proc) {
    _sys_p1 = out_proc;
    _sys_p2 = 10;
    _sys_p3 = idx;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LOAD16  R0, __sys_p3
        LD      R3, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x22
        LOAD16  R0, __sys_r1
