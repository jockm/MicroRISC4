// ==============================================================================
// FILE: mr4src/act4/os/os_main.a4
// Core 0 OS Kernel Entry, Trap 1 Handler & Syscall Dispatcher
// ==============================================================================

import "os_uart.a4";
import "os_sd.a4";
import "os_fat32.a4";
import "os_proc.a4";
import "os_shell.a4";

// Syscall IDs matching worker_stub.asm 3-class wire framing
// Class A: Scalar (0x00..0x0F)
const u16 SYS_EXIT      = 0x01;
const u16 SYS_PUTC      = 0x02;
const u16 SYS_GETC      = 0x03;
const u16 SYS_KILL      = 0x04;
const u16 SYS_CLOSE     = 0x05;

// Class B: Buffer Out (0x10..0x1F)
const u16 SYS_WRITE_CON = 0x10;
const u16 SYS_SPAWN     = 0x11;
const u16 SYS_OPEN      = 0x12;
const u16 SYS_WRITE     = 0x13;
const u16 SYS_OPENDIR   = 0x14;
const u16 SYS_UNLINK    = 0x15;
const u16 SYS_MKDIR     = 0x16;
const u16 SYS_RMDIR     = 0x17;
const u16 SYS_CHDIR     = 0x18;

// Class C: Buffer In (0x20..0x2F)
const u16 SYS_READ      = 0x20;
const u16 SYS_READDIR   = 0x21;
const u16 SYS_PS        = 0x22;
const u16 SYS_GETARGS   = 0x23;

// Error Codes
const u16 ERR_OK        = 0x0000;
const u16 ERR_EMPTY     = 0x0001;
const u16 ERR_IO        = 0x0002;
const u16 ERR_EOF       = 0x0003;
const u16 ERR_UNKNOWN   = 0xFFFF;

const u16 SYS_BUF_WORDS = 64;

u16 msg_pending = 0;
u16 sys_buf[SYS_BUF_WORDS];
DirEntry sys_ent;

// -----------------------------------------------------------------------------
// Trap 1 ISR (0x0110): Zero-spill flag setter
// Preserves R1 & R2 via hardware shadow registers so main/shell is undisturbed.
// -----------------------------------------------------------------------------
void on_msg_ready(void) @ trap(1) {
    msg_pending++;
}
// Drain remaining words of an unhandled syscall so FIFO stays aligned
void drain_fifo(u16 count) {
    u16 dummy = 0;
    while (count > 0) {
        dummy = fifo_in;
        count--;
    }
}

// Read a Class B NUL-terminated packed string payload from fifo_in into sys_buf
void read_fifo_str(u16 wlen) {
    u16 i = 0;
    u16 w = 0;
    while (i < wlen) {
        w = fifo_in;
        if (i < (SYS_BUF_WORDS - 1)) {
            sys_buf[i] = w;
        }
        i++;
    }
    if (wlen == 0) {
        sys_buf[0] = 0;
    }
    sys_buf[SYS_BUF_WORDS - 1] = 0;
}

void handle_syscall(void) {
    u16 hdr   = fifo_in;
    u16 len   = fifo_in;
    u16 pid   = hdr >> 8;
    u16 id    = hdr & 0x00FF;
    u16 arg1  = 0;
    u16 arg2  = 0;
    u16 extra = 0;
    u16 wlen  = 0;
    u16 i     = 0;
    u16 ch    = 0;
    u16 fd    = 0;

    // Direct all FIFO replies and FAT32 relative paths to the requesting worker core
    fifo_sel = pid;
    proc_use_cwd(pid);

    if (id == SYS_EXIT) {
        arg1 = fifo_in;
        if (proc_mark_exited(pid, arg1) != 0) {
            shell_prompt();
        }
        return;                         // No reply expected
    }

    if (id == SYS_PUTC) {
        arg1 = fifo_in;
        arg2 = fifo_in;
        if (pid < MAX_CORES && proc_con_out[pid] != 0) {
            uart_putc(arg1);
        }
        fifo_out = ERR_OK;
        fifo_out = 0;
        return;
    }

    if (id == SYS_GETC) {
        arg1 = fifo_in;
        arg2 = fifo_in;
        if (pid != fg_pid) {
            fifo_out = ERR_EMPTY;
            fifo_out = 0;
        } else {
            ch = fg_rx_pop();
            if (ch == 0xFFFF) {
                fifo_out = ERR_EMPTY;
                fifo_out = 0;
            } else {
                fifo_out = ERR_OK;
                fifo_out = ch;
            }
        }
        return;
    }

    if (id == SYS_KILL) {
        arg1 = fifo_in;
        arg2 = fifo_in;
        fifo_out = proc_kill(arg1);
        fifo_out = 0;
        return;
    }

    if (id == SYS_CLOSE) {
        arg1 = fifo_in;
        arg2 = fifo_in;
        fat32_close(arg1);
        fifo_out = ERR_OK;
        fifo_out = 0;
        return;
    }

    if (id == SYS_WRITE_CON) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        if (pid < MAX_CORES && proc_con_out[pid] != 0) {
            uart_puts(sys_buf);
        }
        fifo_out = ERR_OK;
        fifo_out = wlen;
        return;
    }

    if (id == SYS_SPAWN) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        // Split optional "PATH ARGS..." at first space
        i = 0;
        arg1 = 0;
        while (i < ((SYS_BUF_WORDS << 1) - 2)) {
            ch = getbyte(sys_buf, i);
            if (ch == 0) {
                break;
            }
            if (ch == 32) {
                setbyte(sys_buf, i, 0);
                i++;
                while (getbyte(sys_buf, i) == 32) {
                    i++;
                }
                arg1 = i;
                break;
            }
            i++;
        }
        ch = 0;
        if (pid < MAX_CORES && proc_con_out[pid] != 0) {
            ch = 1;                     // Child inherits console output from parent
        }
        if (arg1 != 0) {
            arg2 = proc_spawn_from_file(pid, sys_buf, sys_buf, arg1, ch);
        } else {
            arg2 = proc_spawn_from_file(pid, sys_buf, 0, 0, ch);
        }
        fifo_sel = pid;
        if (arg2 == 0) {
            fifo_out = ERR_IO;
            fifo_out = 0;
        } else {
            fifo_out = ERR_OK;
            fifo_out = arg2;
        }
        return;
    }

    if (id == SYS_OPEN) {
        extra = fifo_in;                // mode: 0 = read, non-zero = create/write
        wlen  = fifo_in;
        read_fifo_str(wlen);
        if (extra == 0) {
            fd = fat32_open(pid, sys_buf);
        } else {
            fd = fat32_open_write(pid, sys_buf);
        }
        if (fd == 0xFFFF) {
            fifo_out = ERR_IO;
            fifo_out = 0;
        } else {
            fifo_out = ERR_OK;
            fifo_out = fd;
        }
        return;
    }

    if (id == SYS_WRITE) {
        extra = fifo_in;                // (byte_len << 4) | (fd & 0x0F)
        wlen  = fifo_in;
        i = 0;
        while (i < wlen) {
            arg1 = fifo_in;
            if (i < SYS_BUF_WORDS) {
                sys_buf[i] = arg1;
            }
            i++;
        }
        fd   = extra & 0x000F;
        arg2 = extra >> 4;
        if (arg2 == 0 || arg2 > (wlen << 1)) {
            arg2 = wlen << 1;
        }
        if (arg2 > (SYS_BUF_WORDS << 1)) {
            arg2 = SYS_BUF_WORDS << 1;
        }
        arg1 = fat32_write_bytes(fd, sys_buf, arg2);
        if (arg1 == 0 && arg2 > 0) {
            fifo_out = ERR_IO;
            fifo_out = 0;
        } else {
            fifo_out = ERR_OK;
            fifo_out = arg1;
        }
        return;
    }

    if (id == SYS_OPENDIR) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        fd = fat32_opendir(pid, sys_buf);
        if (fd == 0xFFFF) {
            fifo_out = ERR_IO;
            fifo_out = 0;
        } else {
            fifo_out = ERR_OK;
            fifo_out = fd;
        }
        return;
    }

    if (id == SYS_UNLINK) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        arg2 = fat32_unlink(sys_buf);
        if (arg2 == 0) {
            fifo_out = ERR_OK;
        } else {
            fifo_out = ERR_IO;
        }
        fifo_out = arg2;
        return;
    }

    if (id == SYS_MKDIR) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        arg2 = fat32_mkdir(sys_buf);
        if (arg2 == 0) {
            fifo_out = ERR_OK;
        } else {
            fifo_out = ERR_IO;
        }
        fifo_out = arg2;
        return;
    }

    if (id == SYS_RMDIR) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        arg2 = fat32_rmdir(sys_buf);
        if (arg2 == 0) {
            fifo_out = ERR_OK;
        } else {
            fifo_out = ERR_IO;
        }
        fifo_out = arg2;
        return;
    }

    if (id == SYS_CHDIR) {
        extra = fifo_in;
        wlen  = fifo_in;
        read_fifo_str(wlen);
        arg2 = fat32_chdir_clus(sys_buf);
        if (arg2 == 0) {
            proc_save_cwd(pid);
            fifo_out = ERR_OK;
        } else {
            fifo_out = ERR_IO;
        }
        fifo_out = arg2;
        return;
    }

    if (id == SYS_READ) {
        extra = fifo_in;                // fd
        wlen  = fifo_in;                // max_words
        if (wlen > 64) {
            wlen = 64;
        }
        arg1 = fat32_read_bytes(extra, sys_buf, wlen << 1);
        if (arg1 == 0) {
            fifo_out = ERR_EOF;
            fifo_out = 0;
        } else {
            arg2 = (arg1 + 1) >> 1;     // word count
            fifo_out = ERR_OK;
            fifo_out = arg2;
            i = 0;
            while (i < arg2) {
                fifo_out = sys_buf[i];
                i++;
            }
        }
        return;
    }

    if (id == SYS_READDIR) {
        extra = fifo_in;                // dir_fd
        wlen  = fifo_in;                // max_words (11)
        if (fat32_readdir(extra, &sys_ent) != 0) {
            fifo_out = ERR_EOF;
            fifo_out = 0;
        } else {
            fifo_out = ERR_OK;
            fifo_out = 11;
            fifo_out = sys_ent.attr;
            fifo_out = sys_ent.size_lo;
            fifo_out = sys_ent.size_hi;
            i = 0;
            while (i < 8) {
                fifo_out = sys_ent.name[i];
                i++;
            }
        }
        return;
    }

    if (id == SYS_PS) {
        extra = fifo_in;                // pid index (0..MAX_CORES-1)
        wlen  = fifo_in;                // max_words (10)
        if (extra >= MAX_CORES) {
            fifo_out = ERR_EOF;
            fifo_out = 0;
        } else {
            fifo_out = ERR_OK;
            fifo_out = 10;
            fifo_out = procs[extra].state;
            fifo_out = procs[extra].exit_code;
            i = 0;
            while (i < 8) {
                fifo_out = procs[extra].name[i];
                i++;
            }
        }
        return;
    }

    if (id == SYS_GETARGS) {
        extra = fifo_in;
        wlen  = fifo_in;                // max_words
        if (pid >= MAX_CORES || wlen == 0) {
            fifo_out = ERR_IO;
            fifo_out = 0;
            return;
        }
        if (wlen > PROC_ARG_WORDS) {
            wlen = PROC_ARG_WORDS;
        }
        arg1 = pid * PROC_ARG_WORDS;
        i = 0;
        while (i < wlen) {
            arg2 = proc_args[arg1 + i];
            if ((arg2 & 0x00FF) == 0 || (arg2 >> 8) == 0) {
                i++;
                break;
            }
            i++;
        }
        fifo_out = ERR_OK;
        fifo_out = i;
        extra = 0;
        while (extra < i) {
            arg2 = proc_args[arg1 + extra];
            if ((extra + 1) == i && (arg2 & 0x00FF) != 0 && (arg2 >> 8) != 0) {
                arg2 = arg2 & 0x00FF;   // Guarantee NUL termination on truncation
            }
            fifo_out = arg2;
            extra++;
        }
        return;
    }

    // Unknown syscall: drain payload and return error
    drain_fifo(len);
    fifo_out = ERR_UNKNOWN;
    fifo_out = 0;
}

void main(void) {
    proc_init();

    uart_puts("\r\nMiniRISC4 OS v0.1 (Core 0)\r\n");
    if (fat32_mount() == 0) {
        proc_cwd_init_all();
        uart_puts("FAT32 mounted OK\r\n");
    } else {
        uart_puts("FAT32 mount skipped/failed\r\n");
    }
    shell_prompt();

    while (true) {
        if (msg_pending != 0) {
            msg_pending--;
            handle_syscall();
            proc_use_cwd(0);
        }
        shell_poll();
    }
}
