// ==============================================================================
// FILE: mr4src/act4/os/os_proc.a4
// Core 0 Process Table, Console Ownership & Worker Core Control
// ==============================================================================

// Hardware Lean Ring NoC MMIO (0x0020 - 0x002A; matches NocRouterNi & mr4sim.py)
u16 noc_tx_data   @ 0x0020;
u16 noc_dst_core  @ 0x0021;
u16 noc_rx_data   @ 0x0022;
u16 noc_stat      @ 0x0023;
u16 noc_mbox_send @ 0x0025;
u16 noc_mbox_data @ 0x0026;
u16 noc_mbox_src  @ 0x0027;
u16 noc_info      @ 0x002A;

const u16 MAX_CORES      = 4;       // Core 0 = OS, Cores 1..3 = Workers
const u16 PROC_FREE      = 0;
const u16 PROC_LOAD      = 1;
const u16 PROC_RUN       = 2;

const u16 CMD_LOAD_MAGIC = 0x4C44;  // "LD" header expected by worker_stub.asm
const u16 CMD_SYS_GRANT  = 0x474F;  // "GO" grant token allowing 1 worker syscall
const u16 MBOX_KILL_CMD  = 0xDEAD;  // Priority doorbell -> worker Hardware Trap 14
const u16 APP_LOAD_ADDR  = 0x0400;
const u16 APP_MAX_WORDS  = 0xF600;  // Up to ~126 KB (fits below ASP = 0xFAFF)

const u16 NOC_STAT_RX_NE = 0x0001;
const u16 NOC_STAT_TX_RDY = 0x0004;
const u16 NOC_STAT_MBOX_V = 0x0010;

const u16 FG_RX_CAP      = 16;      // Power-of-2 ring buffer for fg SYS_GETC
const u16 FG_RX_MASK     = FG_RX_CAP - 1;

const u16 PROC_ARG_WORDS = 32;      // 64-byte packed command-line arg per core
const u16 PROC_ARG_TOTAL = MAX_CORES * PROC_ARG_WORDS;

const u16 SPAWN_OK       = 0;
const u16 SPAWN_ERR_FILE = 1;
const u16 SPAWN_ERR_CORE = 2;

type ProcEntry {
    u16 state;
    u16 exit_code;
    u16 name[8];                    // 16-byte packed .asciz name
};

ProcEntry procs[MAX_CORES];
u16 proc_con_out[MAX_CORES];        // 1 = allowed to write to UART console
u16 proc_args[PROC_ARG_TOTAL];      // Per-core packed NUL-terminated argument string
u16 proc_cwd_hi[MAX_CORES];         // Per-core CWD cluster high word
u16 proc_cwd_lo[MAX_CORES];         // Per-core CWD cluster low word
DirEntry stat_cache[MAX_CORES];     // Per-core SYS_STAT result cache
u16 fg_pid = 0;                     // 0 = Core 0 shell owns UART RX, else worker PID
u16 proc_last_words = 0;            // Word count of last streamed binary
u16 proc_last_err   = 0;            // Last spawn error (SPAWN_*)
u16 noc_req_mask    = 0;            // Bitmask (1 << pid) of pending worker doorbells
u16 noc_rr_cursor   = 1;            // Round-robin worker arbitration cursor

// Drain all pending hardware MBOX doorbells into noc_req_mask so Core 0's 1-entry
// MBOX sink is always non-blocking (prevents ring head-of-line stalls).
void noc_drain_mbox(void) {
    u16 src = 0;
    u16 mv  = 0;
    while ((noc_stat & NOC_STAT_MBOX_V) != 0) {
        src = noc_mbox_src;
        mv  = noc_mbox_data;
        if (src > 0 && src < MAX_CORES && procs[src].state != PROC_FREE) {
            noc_req_mask = noc_req_mask | (1 << src);
        }
    }
}

// Blocking pop from Core 0's shared 16-word RX FIFO (keeps draining MBOX while waiting)
u16 noc_rx_word(void) {
    while (true) {
        noc_drain_mbox();
        if ((noc_stat & NOC_STAT_RX_NE) != 0) {
            return noc_rx_data;
        }
    }
}

// Blocking push to noc_dst_core's RX FIFO (honors hardware tx_ready backpressure)
void noc_tx_word(u16 w) {
    while ((noc_stat & NOC_STAT_TX_RDY) == 0) {
        noc_drain_mbox();
    }
    noc_tx_data = w;
}

// Blocking send of 1-word priority doorbell/MBOX to target core (triggers Trap 14)
void noc_send_mbox(u16 dst, u16 val) {
    noc_dst_core = dst;
    while ((noc_stat & NOC_STAT_TX_RDY) == 0) {
        noc_drain_mbox();
    }
    noc_mbox_send = val;
}

u16 fg_rx_buf[FG_RX_CAP];
u16 fg_rx_head = 0;
u16 fg_rx_tail = 0;

void fg_rx_clear(void) {
    fg_rx_head = 0;
    fg_rx_tail = 0;
}

void fg_rx_push(u16 ch) {
    u16 next = (fg_rx_head + 1) & FG_RX_MASK;
    if (next != fg_rx_tail) {
        fg_rx_buf[fg_rx_head] = ch;
        fg_rx_head = next;
    }
}

// Returns next queued key for fg_pid, or 0xFFFF if empty
u16 fg_rx_pop(void) {
    u16 ch = 0;
    if (fg_rx_head == fg_rx_tail) {
        return 0xFFFF;
    }
    ch = fg_rx_buf[fg_rx_tail];
    fg_rx_tail = (fg_rx_tail + 1) & FG_RX_MASK;
    return ch;
}

void proc_init(void) {
    u16 i = 0;
    procs[0].state = PROC_RUN;
    proc_con_out[0] = 1;
    proc_args[0] = 0;
    proc_cwd_hi[0] = 0;
    proc_cwd_lo[0] = 0;
    str_copy(procs[0].name, "os_kernel", 16);
    fg_pid = 0;
    fg_rx_clear();

    i = 1;
    while (i < MAX_CORES) {
        procs[i].state = PROC_FREE;
        procs[i].exit_code = 0;
        proc_con_out[i] = 0;
        proc_args[i * PROC_ARG_WORDS] = 0;
        proc_cwd_hi[i] = 0;
        proc_cwd_lo[i] = 0;
        setbyte(procs[i].name, 0, 0);
        i++;
    }
}

// Initialize all cores' CWD clusters to root_clus after fat32_mount()
void proc_cwd_init_all(void) {
    u16 i = 0;
    while (i < MAX_CORES) {
        proc_cwd_hi[i] = root_clus_hi;
        proc_cwd_lo[i] = root_clus_lo;
        i++;
    }
}

// Bind FAT32 active CWD globals to `pid`'s CWD cluster
void proc_use_cwd(u16 pid) {
    if (pid < MAX_CORES && (proc_cwd_hi[pid] != 0 || proc_cwd_lo[pid] >= 2)) {
        cwd_clus_hi = proc_cwd_hi[pid];
        cwd_clus_lo = proc_cwd_lo[pid];
    } else {
        cwd_clus_hi = root_clus_hi;
        cwd_clus_lo = root_clus_lo;
    }
}

// Save FAT32 active CWD globals back into `pid`'s CWD slot
void proc_save_cwd(u16 pid) {
    if (pid < MAX_CORES) {
        proc_cwd_hi[pid] = cwd_clus_hi;
        proc_cwd_lo[pid] = cwd_clus_lo;
    }
}

// Return 1 if any running core (including Core 0) currently has (clus_hi:clus_lo) as its CWD
u16 proc_is_cwd_in_use(u16 clus_hi, u16 clus_lo) {
    u16 i = 0;
    while (i < MAX_CORES) {
        if (procs[i].state != PROC_FREE && proc_cwd_hi[i] == clus_hi && proc_cwd_lo[i] == clus_lo) {
            return 1;
        }
        i++;
    }
    return 0;
}

// Copy NUL-terminated packed string from src starting at byte offset `src_off`
// into proc_args for `pid` (word-aligned at byte 0).
void proc_set_args_from(u16 pid, u16 *src, u16 src_off) {
    u16 *dst    = &proc_args[pid * PROC_ARG_WORDS];
    u16 max_len = (PROC_ARG_WORDS << 1) - 1;
    u16 i       = 0;
    u16 ch      = 0;

    if (pid >= MAX_CORES) {
        return;
    }
    if (src == 0) {
        dst[0] = 0;
        return;
    }
    while (i < max_len) {
        ch = getbyte(src, src_off + i);
        setbyte(dst, i, ch);
        if (ch == 0) {
            // Ensure upper byte of last word is zeroed if NUL landed on even byte
            if ((i & 0x0001) == 0) {
                setbyte(dst, i + 1, 0);
            }
            return;
        }
        i++;
    }
    setbyte(dst, max_len, 0);
}

void proc_clear_worker_con_out(void) {
    u16 i = 1;
    while (i < MAX_CORES) {
        proc_con_out[i] = 0;
        i++;
    }
}

// Attach running worker PID to foreground (exclusive output + keyboard input)
// Returns 0 = OK, 1 = invalid PID, 2 = not running
u16 proc_set_fg(u16 pid) {
    if (pid == 0 || pid >= MAX_CORES) {
        return 1;
    }
    if (procs[pid].state != PROC_RUN) {
        return 2;
    }
    proc_clear_worker_con_out();
    proc_con_out[pid] = 1;
    fg_pid = pid;
    fg_rx_clear();
    return 0;
}

// Enable console output for running worker PID without disturbing other cores
// or taking keyboard input away from the Core 0 shell (--fgoutput).
u16 proc_set_fg_output(u16 pid) {
    if (pid == 0 || pid >= MAX_CORES) {
        return 1;
    }
    if (procs[pid].state != PROC_RUN) {
        return 2;
    }
    proc_con_out[pid] = 1;
    return 0;
}

// Move running worker PID to background (mute output; release input if fg)
u16 proc_set_bg(u16 pid) {
    if (pid == 0 || pid >= MAX_CORES) {
        return 1;
    }
    if (procs[pid].state != PROC_RUN) {
        return 2;
    }
    proc_con_out[pid] = 0;
    if (fg_pid == pid) {
        fg_pid = 0;
        fg_rx_clear();
    }
    return 0;
}

// Find first FREE worker core (returns 0 if none available)
u16 proc_alloc_core(void) {
    u16 i = 1;
    while (i < MAX_CORES) {
        if (procs[i].state == PROC_FREE) {
            return i;
        }
        i++;
    }
    return 0;
}

// Reclaim a worker core after SYS_EXIT or crash.
// Returns 1 if the exited worker was the active fg_pid (caller should reprint prompt).
u16 proc_mark_exited(u16 pid, u16 code) {
    u16 was_fg = 0;
    if (pid == 0 || pid >= MAX_CORES) {
        return 0;
    }
    proc_con_out[pid] = 0;
    proc_args[pid * PROC_ARG_WORDS] = 0;
    proc_cwd_hi[pid] = root_clus_hi;
    proc_cwd_lo[pid] = root_clus_lo;
    if (fg_pid == pid) {
        fg_pid = 0;
        fg_rx_clear();
        was_fg = 1;
    }
    procs[pid].exit_code = code;
    fat32_close_owner(pid);
    procs[pid].state = PROC_FREE;
    return was_fg;
}

// Force-kill a running worker core via Hardware Lean Ring Doorbell (Trap 14)
u16 proc_kill(u16 pid) {
    u16 bit = 0;
    if (pid == 0 || pid >= MAX_CORES) {
        return 1;                   // ERR_INVALID_PID
    }
    if (procs[pid].state == PROC_FREE) {
        return 2;                   // ERR_NOT_RUNNING
    }
    bit = 1 << pid;
    noc_req_mask = noc_req_mask & (bit ^ 0xFFFF);
    noc_send_mbox(pid, MBOX_KILL_CMD);
    proc_con_out[pid] = 0;
    proc_args[pid * PROC_ARG_WORDS] = 0;
    proc_cwd_hi[pid] = root_clus_hi;
    proc_cwd_lo[pid] = root_clus_lo;
    if (fg_pid == pid) {
        fg_pid = 0;
        fg_rx_clear();
    }
    procs[pid].exit_code = 0xFFFF;
    fat32_close_owner(pid);
    procs[pid].state = PROC_FREE;
    return 0;
}

// Stream a FAT32 binary directly sector-by-sector into a free worker core and launch it.
// Inherits CWD from parent_pid. arg_src / arg_off specify optional command-line args.
// con_mode: 0 = background (muted), 1 = inherit output only, 2 = exclusive foreground.
// Returns allocated PID (1..MAX_CORES-1) on success, or 0 on error (see proc_last_err).
u16 proc_spawn_from_file(u16 parent_pid, u16 *path, u16 *arg_src, u16 arg_off, u16 con_mode) {
    u16 fd         = 0xFFFF;
    u16 pid        = 0;
    u16 sz_lo      = 0;
    u16 sz_hi      = 0;
    u16 word_count = 0;
    u16 sent       = 0;
    u16 w_idx      = 0;

    proc_last_words = 0;
    proc_last_err   = SPAWN_ERR_FILE;

    fd = fat32_open(0, path);
    if (fd == 0xFFFF) {
        return 0;
    }

    sz_lo = fds[fd].size_lo;
    sz_hi = fds[fd].size_hi;
    if ((sz_hi == 0 && sz_lo == 0) || sz_hi > 1) {
        fat32_close(fd);
        return 0;
    }
    word_count = (sz_lo >> 1) + (sz_lo & 0x0001);
    if (sz_hi == 1) {
        if (word_count > (APP_MAX_WORDS - 0x8000)) {
            fat32_close(fd);
            return 0;
        }
        word_count = word_count + 0x8000;
    }

    pid = proc_alloc_core();
    if (pid == 0) {
        fat32_close(fd);
        proc_last_err = SPAWN_ERR_CORE;
        return 0;
    }

    procs[pid].state = PROC_LOAD;
    str_copy(procs[pid].name, path, 16);
    proc_set_args_from(pid, arg_src, arg_off);
    if (parent_pid < MAX_CORES && (proc_cwd_hi[parent_pid] != 0 || proc_cwd_lo[parent_pid] >= 2)) {
        proc_cwd_hi[pid] = proc_cwd_hi[parent_pid];
        proc_cwd_lo[pid] = proc_cwd_lo[parent_pid];
    } else {
        proc_cwd_hi[pid] = root_clus_hi;
        proc_cwd_lo[pid] = root_clus_lo;
    }

    if (con_mode == 2) {
        proc_clear_worker_con_out();
        proc_con_out[pid] = 1;
        fg_pid = pid;
        fg_rx_clear();
    } else if (con_mode == 1) {
        proc_con_out[pid] = 1;
    } else {
        proc_con_out[pid] = 0;
    }

    // Select target worker core and stream Load Packet over Lean Ring with tx_ready flow control
    noc_dst_core = pid;
    noc_tx_word(CMD_LOAD_MAGIC);
    noc_tx_word(APP_LOAD_ADDR);
    noc_tx_word(word_count);
    noc_tx_word(APP_LOAD_ADDR);

    while (sent < word_count) {
        if (fat32_read_next_sector(fd) != 0) {
            // Pad remaining words on unexpected EOF so worker loader stays framed
            while (sent < word_count) {
                noc_tx_word(0);
                sent++;
            }
            break;
        }
        w_idx = 0;
        while (w_idx < 256 && sent < word_count) {
            noc_tx_word(sec_buf[w_idx]);
            w_idx++;
            sent++;
        }
    }

    fat32_close(fd);
    procs[pid].state = PROC_RUN;
    proc_last_words  = word_count;
    proc_last_err    = SPAWN_OK;
    return pid;
}

void proc_print_ps(void) {
    u16 i = 0;
    uart_puts("PID  STATE  NAME\r\n");
    while (i < MAX_CORES) {
        uart_putc(i + 48);
        uart_puts("    ");
        if (procs[i].state == PROC_FREE) {
            uart_puts("FREE   -\r\n");
        } else if (procs[i].state == PROC_LOAD) {
            uart_puts("LOAD   ");
            uart_puts(procs[i].name);
            uart_nl();
        } else {
            uart_puts("RUN    ");
            uart_puts(procs[i].name);
            if (i > 0) {
                if (i == fg_pid) {
                    uart_puts("  [FG]");
                } else if (proc_con_out[i] != 0) {
                    uart_puts("  [OUT]");
                }
            }
            uart_nl();
        }
        i++;
    }
}
