// ==============================================================================
// FILE: mr4src/act4/os/os_shell.a4
// Non-Blocking Line Editor & Shell Commands
// ==============================================================================

const u16 LINE_MAX   = 64;
const u16 LINE_WORDS = LINE_MAX >> 1;
u16 sh_line[LINE_WORDS]; // 64 bytes packed
u16 sh_len = 0;

u16 sh_cmd[8];          // 16-byte command token
u16 sh_arg[16];         // 32-byte first argument token
u16 sh_arg_idx  = 0;    // Byte offset in sh_line where first arg starts
u16 sh_rest_idx = 0;    // Byte offset in sh_line after first arg
DirEntry sh_ent;

void shell_prompt(void) {
    uart_puts("mr4> ");
}

// Split sh_line into sh_cmd and sh_arg (separated by space)
void shell_tokenize(void) {
    u16 i = 0;
    u16 j = 0;
    u16 ch = 0;

    setbyte(sh_cmd, 0, 0);
    setbyte(sh_arg, 0, 0);

    // Skip leading spaces
    while (getbyte(sh_line, i) == 32) {
        i++;
    }

    // Copy command token
    while (j < 15) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(sh_cmd, j, ch);
        i++;
        j++;
    }
    setbyte(sh_cmd, j, 0);

    // Skip spaces before arg
    while (getbyte(sh_line, i) == 32) {
        i++;
    }
    sh_arg_idx = i;

    // Copy argument token
    j = 0;
    while (j < 31) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(sh_arg, j, ch);
        i++;
        j++;
    }
    setbyte(sh_arg, j, 0);

    // Skip spaces before remaining line payload (e.g. for "write <file> <text>")
    while (getbyte(sh_line, i) == 32) {
        i++;
    }
    sh_rest_idx = i;
}

void shell_cmd_ls(void) {
    u16 fd = fat32_opendir(0, sh_arg);
    if (fd == 0xFFFF) {
        if (fat_mounted == 0) {
            uart_puts("SD/FAT32 not mounted\r\n");
        } else {
            uart_puts("Directory not found: ");
            uart_puts(sh_arg);
            uart_nl();
        }
        return;
    }
    while (fat32_readdir(fd, &sh_ent) == 0) {
        if ((sh_ent.attr & 0x0010) != 0) {
            uart_puts("<DIR>  ");
        } else {
            uart_puts("       ");
        }
        uart_puts(sh_ent.name);
        uart_nl();
    }
    fat32_close(fd);
}

void shell_cmd_pwd(void) {
    uart_puts(cwd_path);
    uart_nl();
}

void shell_cmd_cd(void) {
    u16 err = 0;
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_chdir(sh_arg);
    if (err == 0) {
        proc_save_cwd(0);
    } else {
        uart_puts("Directory not found: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_mkdir(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: mkdir <dir>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_mkdir(sh_arg);
    if (err == 0) {
        uart_puts("Created ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Already exists: ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to mkdir: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_rmdir(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: rmdir <dir>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_rmdir(sh_arg);
    if (err == 0) {
        uart_puts("Removed dir ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Directory not empty: ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 4) {
        uart_puts("Cannot remove current dir: ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 2) {
        uart_puts("Directory not found: ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to rmdir: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_cat(void) {
    u16 fd     = 0xFFFF;
    u16 rem_lo = 0;
    u16 rem_hi = 0;
    u16 chunk  = 0;
    u16 i      = 0;
    u16 ch     = 0;
    u16 prev   = 0;
    u16 wrote  = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: cat <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }

    fd = fat32_open(0, sh_arg);
    if (fd == 0xFFFF) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }

    rem_lo = fds[fd].size_lo;
    rem_hi = fds[fd].size_hi;
    while (rem_hi != 0 || rem_lo != 0) {
        if (fat32_read_next_sector(fd) != 0) {
            break;
        }
        chunk = 512;
        if (rem_hi == 0 && rem_lo < 512) {
            chunk = rem_lo;
        }
        i = 0;
        while (i < chunk) {
            ch = getbyte(sec_buf, i);
            if (ch == 10 && prev != 13) {
                uart_putc(13);
            }
            uart_putc(ch);
            prev = ch;
            wrote = 1;
            i++;
        }
        if (rem_lo < chunk) {
            rem_hi--;
        }
        rem_lo = rem_lo - chunk;
    }
    fat32_close(fd);
    if (wrote != 0 && prev != 10) {
        uart_nl();
    }
}

void shell_cmd_rm(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: rm <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_unlink(sh_arg);
    if (err == 0) {
        uart_puts("Removed ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 3) {
        uart_puts("Is a directory (use rmdir): ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to remove: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_write(void) {
    u16 fd = 0;
    u16 i  = sh_rest_idx;
    u16 o  = 0;
    u16 ch = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: write <file> <text>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }

    while (o < 62) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        setbyte(sys_buf, o, ch);
        o++;
        i++;
    }
    setbyte(sys_buf, o, 10);        // append '\n'
    o++;

    fd = fat32_open_write(0, sh_arg);
    if (fd == 0xFFFF) {
        uart_puts("Failed to create: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (fat32_write_bytes(fd, sys_buf, o) != o) {
        fat32_close(fd);
        uart_puts("Write error: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    fat32_close(fd);
    uart_puts("Wrote ");
    uart_puts(sh_arg);
    uart_nl();
}

void shell_cmd_stat(void) {
    u16 err  = 0;
    u16 c_lo = 0;
    u16 c_hi = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: stat <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_stat(sh_arg, &sh_ent);
    if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (err != 0) {
        uart_puts("stat failed\r\n");
        return;
    }
    c_lo = tmp32_lo;
    c_hi = tmp32_hi;
    uart_puts(sh_ent.name);
    uart_puts("  size=");
    if (sh_ent.size_hi != 0) {
        uart_puts("0x");
        uart_put_hex16(sh_ent.size_hi);
        uart_put_hex16(sh_ent.size_lo);
    } else {
        uart_put_dec16(sh_ent.size_lo);
    }
    uart_puts(" bytes  attr=0x");
    uart_put_hex16(sh_ent.attr);
    uart_puts("  clus=0x");
    if (c_hi != 0) {
        uart_put_hex16(c_hi);
    }
    uart_put_hex16(c_lo);
    uart_nl();
}

void shell_cmd_echo(void) {
    u16 i  = sh_arg_idx;
    u16 ch = 0;
    while (true) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        uart_putc(ch);
        i++;
    }
    uart_nl();
}

void shell_cmd_clear(void) {
    uart_putc(27);
    uart_puts("[2J");
    uart_putc(27);
    uart_puts("[H");
}

void shell_cmd_run(u16 foreground, u16 arg_off) {
    u16 pid  = 0;
    u16 mode = 0;

    if (getbyte(sh_arg, 0) == 0) {
        if (foreground != 0) {
            uart_puts("Usage: ! <file> [args]\r\n");
        } else {
            uart_puts("Usage: run <file> [args]\r\n");
        }
        return;
    }
    if (foreground != 0) {
        mode = 2;
    }
    pid = proc_spawn_from_file(0, sh_arg, sh_line, arg_off, mode);
    if (pid == 0) {
        if (proc_last_err == SPAWN_ERR_CORE) {
            uart_puts("No free worker core\r\n");
        } else {
            uart_puts("Failed to load file: ");
            uart_puts(sh_arg);
            uart_nl();
        }
    } else if (foreground == 0) {
        uart_puts("Spawned PID ");
        uart_putc(pid + 48);
        uart_puts(" (");
        uart_put_hex16(proc_last_words);
        uart_puts(" words)\r\n");
    }
}

void shell_cmd_fg(void) {
    u16 pid = 0;
    u16 err = 0;
    u16 i   = 0;
    u16 j   = 0;
    u16 ch  = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: fg [--fgoutput] <pid>\r\n");
        return;
    }
    if (str_eq(sh_arg, "--fgoutput") == 1) {
        i = sh_rest_idx;
        j = 0;
        while (j < 15) {
            ch = getbyte(sh_line, i);
            if (ch == 0 || ch == 32) {
                break;
            }
            setbyte(sh_arg, j, ch);
            i++;
            j++;
        }
        setbyte(sh_arg, j, 0);
        if (j == 0) {
            uart_puts("Usage: fg --fgoutput <pid>\r\n");
            return;
        }
        pid = parse_u16(sh_arg);
        err = proc_set_fg_output(pid);
        if (err == 0) {
            uart_puts("Console output enabled for PID ");
            uart_putc(pid + 48);
            uart_nl();
        } else {
            uart_puts("fg failed\r\n");
        }
        return;
    }

    pid = parse_u16(sh_arg);
    err = proc_set_fg(pid);
    if (err != 0) {
        uart_puts("fg failed\r\n");
    }
}

void shell_cmd_bg(void) {
    u16 pid = 0;
    u16 err = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: bg <pid>\r\n");
        return;
    }
    pid = parse_u16(sh_arg);
    err = proc_set_bg(pid);
    if (err == 0) {
        uart_puts("Backgrounded PID ");
        uart_putc(pid + 48);
        uart_nl();
    } else {
        uart_puts("bg failed\r\n");
    }
}

void shell_exec(void) {
    u16 pid = 0;
    u16 err = 0;
    u16 i   = 0;
    u16 ch  = 0;

    shell_tokenize();
    if (getbyte(sh_cmd, 0) == 0) {
        return;
    }

    if (getbyte(sh_cmd, 0) == 33) {
        // Support both "! APP.BIN [args]" and "!APP.BIN [args]"
        if (getbyte(sh_cmd, 1) != 0) {
            i = 1;
            while (i < 16) {
                ch = getbyte(sh_cmd, i);
                setbyte(sh_arg, i - 1, ch);
                if (ch == 0) {
                    break;
                }
                i++;
            }
            setbyte(sh_arg, 15, 0);
            shell_cmd_run(1, sh_arg_idx);
        } else {
            shell_cmd_run(1, sh_rest_idx);
        }
        return;
    }

    if (str_eq(sh_cmd, "help") == 1) {
        uart_puts("Commands: ps, ! <file> [args], run <file> [args], fg [--fgoutput] <pid>, bg <pid>, kill <pid>, pwd, cd [dir], ls [dir], mkdir <dir>, rmdir <dir>, cat <file>, stat <path>, write <file> <text>, rm <file>, echo <text>, clear\r\n");
    } else if (str_eq(sh_cmd, "ps") == 1) {
        proc_print_ps();
    } else if (str_eq(sh_cmd, "fg") == 1) {
        shell_cmd_fg();
    } else if (str_eq(sh_cmd, "bg") == 1) {
        shell_cmd_bg();
    } else if (str_eq(sh_cmd, "kill") == 1) {
        pid = parse_u16(sh_arg);
        err = proc_kill(pid);
        if (err == 0) {
            uart_puts("Killed PID ");
            uart_putc(pid + 48);
            uart_nl();
        } else {
            uart_puts("kill failed\r\n");
        }
    } else if (str_eq(sh_cmd, "pwd") == 1) {
        shell_cmd_pwd();
    } else if (str_eq(sh_cmd, "cd") == 1) {
        shell_cmd_cd();
    } else if (str_eq(sh_cmd, "ls") == 1) {
        shell_cmd_ls();
    } else if (str_eq(sh_cmd, "mkdir") == 1) {
        shell_cmd_mkdir();
    } else if (str_eq(sh_cmd, "rmdir") == 1) {
        shell_cmd_rmdir();
    } else if (str_eq(sh_cmd, "run") == 1) {
        shell_cmd_run(0, sh_rest_idx);
    } else if (str_eq(sh_cmd, "cat") == 1) {
        shell_cmd_cat();
    } else if (str_eq(sh_cmd, "rm") == 1) {
        shell_cmd_rm();
    } else if (str_eq(sh_cmd, "write") == 1) {
        shell_cmd_write();
    } else if (str_eq(sh_cmd, "stat") == 1) {
        shell_cmd_stat();
    } else if (str_eq(sh_cmd, "echo") == 1) {
        shell_cmd_echo();
    } else if (str_eq(sh_cmd, "clear") == 1) {
        shell_cmd_clear();
    } else {
        uart_puts("Unknown command: ");
        uart_puts(sh_cmd);
        uart_nl();
    }
}

void shell_poll(void) {
    u16 ch  = uart_poll_getc();
    u16 pid = 0;
    if (ch == 0xFFFF) {
        return;
    }

    if (fg_pid != 0) {
        if (ch == 26) {                 // Ctrl-Z: detach foreground to background
            pid = fg_pid;
            proc_set_bg(pid);
            uart_puts("\r\n[Backgrounded PID ");
            uart_putc(pid + 48);
            uart_puts("]\r\n");
            shell_prompt();
        } else if (ch == 3) {           // Ctrl-C: kill foreground worker
            pid = fg_pid;
            proc_kill(pid);
            uart_puts("\r\n^C Killed PID ");
            uart_putc(pid + 48);
            uart_nl();
            shell_prompt();
        } else {
            fg_rx_push(ch);
        }
        return;
    }

    if (ch == 13 || ch == 10) {
        setbyte(sh_line, sh_len, 0);
        uart_nl();
        shell_exec();
        sh_len = 0;
        if (fg_pid == 0) {
            shell_prompt();
        }
    } else if (ch == 8 || ch == 127) {
        if (sh_len > 0) {
            sh_len--;
            uart_putc(8);
            uart_putc(32);
            uart_putc(8);
        }
    } else if (sh_len < (LINE_MAX - 1)) {
        setbyte(sh_line, sh_len, ch);
        sh_len++;
        uart_putc(ch);
    }
}
