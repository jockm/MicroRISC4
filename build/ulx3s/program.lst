; ------------------------------------------------------------------------------
0378    print_nibble:                              ; [00]
0379        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0379        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
