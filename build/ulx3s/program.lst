0641        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0646        XOR     R1, R2                         ; [96 99 96]
0646        XOR     R2, R1                         ; [96 99 96]
0646        XOR     R1, R2                         ; [96 99 96]
0648        PUSH8   R0, >(_CMP_LT)                 ; [F8 06 F8 0D F4 00]
0648        PUSH8   R0, <(_CMP_LT)                 ; [F8 06 F8 0D F4 00]
0648        LINK    R0, R0                         ; [F8 06 F8 0D F4 00]
064B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
064B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
064B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
064B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
064B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
064B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
