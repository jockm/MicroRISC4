; =============================================================================
; MiniRISC4 Assembler Listing
; ADDR    SOURCE LINE                                ; [HEX]
; =============================================================================
; ==============================================================================
; FILE: mr4src/asm/monitor.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Interactive Serial Memory Monitor for the MiniRISC4 Architecture.
;
; Commands:
;   e [<addr>]       - Examine 8 words starting at <addr> (or next 8 words if omitted)
;   c <addr> <val>   - Change word at <addr> to <val>
;   g <addr>         - Go / Execute code at <addr>
;
; Table of Contents:
;   1. Program Entry & Stack Setup (_start)
;   2. Main Command Dispatch Loop (monitor_loop)
;   3. Command Implementations (cmd_go, cmd_examine, cmd_change)
;   4. String & Formatting Subroutines (puts, print_newline, print_hex16, print_nibble)
;   5. Terminal Line Input & Space Skipping (read_line, skip_spaces)
;   6. Hexadecimal Parsing Subroutine (parse_hex)
;   7. Static Banners, Prompts, Messages & Buffers
; ==============================================================================

; ==============================================================================
; FILE: lib/common.inc
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Architectural Macro Definitions and System Abstractions.
;
; Table of Contents:
;   1. Program Entry & Stack Initialization (START_PROGRAM)
;   2. Core Register Manipulation & Arithmetic Macros (SWAP, LOAD16, LD0, NOT, NEG, XCHGALL)
;   3. System Scratchpad & Register Spilling (SAVEALL, LOADALL via 0x0000-0x0003)
;   4. Hardware Stack Engine (Full Descending: STPUSH, STPOP, RPUSH, RPOP, APUSH, APOP)
;   5. Register Spilling via Argument Stack (PUSHALL, POPALL via 0x0005)
;   6. Subroutine Linkage & Return (RCALL, RRET)
;   7. Byte Extraction and Modification (BYTE_GET_LO, BYTE_GET_HI, BYTE_SET_LO, BYTE_SET_HI)
;   8. Polled Serial UART Terminal I/O (PUTC, GETC via MMIO 0x000E / 0x000F)
; ==============================================================================

; ==============================================================================
; MACRO: START_PROGRAM
; Description:
;   Initializes the Return Stack Pointer (RSP at 0x0004) to 0xFEFF and the
;   Argument Stack Pointer (ASP at 0x0005) to 0xFAFF, then jumps directly
;   to the program entry point label _main via register-indirect branching.
; Inputs:
;   None (fixed entry target: _main).
; Outputs:
;   [0x0004] = 0xFEFF (Return stack initialized)
;   [0x0005] = 0xFAFF (Argument stack initialized)
; Side Effects:
;   Overwrites registers R0 and R1, then transfers control to _main.
; ==============================================================================


; ==============================================================================
; MACRO: SWAP
; Description:
;   Swaps the contents of two registers in-place using the three-step XOR algorithm.
; Inputs:
;   regA - First register (R0-R3)
;   regB - Second register (R0-R3)
; Outputs:
;   regA holds original regB; regB holds original regA.
; ==============================================================================


; ==============================================================================
; MACRO: LOAD16
; Description:
;   Loads a 16-bit constant or address label into a register using two sequential
;   PUSH8 operations (high byte followed by low byte).
; Inputs:
;   reg   - Destination register (R0-R3)
;   value - 16-bit literal, symbol, or label address
; Outputs:
;   reg = value
; ==============================================================================


; ==============================================================================
; MACRO: LD0
; Description:
;   Clears the specified register to 0x0000 in-place using XOR. Single-cycle execution.
; Inputs:
;   reg - Destination register (R0-R3)
; Outputs:
;   reg = 0x0000
; ==============================================================================


; ==============================================================================
; MACRO: NOT
; Description:
;   Performs bitwise NOT (one's complement) on a register in-place:
;     reg = ~reg (computed as reg ^ 0xFFFF).
; Inputs:
;   reg - Register to invert (R0-R3)
; Outputs:
;   reg inverted bitwise.
; ==============================================================================


; ==============================================================================
; MACRO: NEG
; Description:
;   Negates a register using two's complement arithmetic:
;     reg = -reg (computed as ~reg + 1).
; Inputs:
;   reg - Register to negate (R0-R3)
; Outputs:
;   reg = -reg
; ==============================================================================


; ==============================================================================
; MACRO: XCHGALL
; Description:
;   Exchanges all four primary registers (R0-R3) with their corresponding
;   hardware shadow counterparts (shadow_r[0]-shadow_r[3]).
; Inputs:
;   None
; Outputs:
;   R0-R3 hold previous shadow values; shadow registers hold previous R0-R3 values.
; ==============================================================================


; ==============================================================================
; MACRO: SAVEALL
; Description:
;   Saves R0-R3 to low scratchpad RAM addresses 0x0000-0x0003 in natural order:
;     [0x0000] = R0, [0x0001] = R1, [0x0002] = R2, [0x0003] = R3
; Inputs:
;   None (operates on current register file R0-R3)
; Outputs:
;   Memory locations 0x0000-0x0003 populated with register snapshots.
; ==============================================================================


; ==============================================================================
; MACRO: LOADALL
; Description:
;   Restores all four registers (R0-R3) from low scratchpad RAM addresses
;   0x0000-0x0003 via post-increment sequential loading.
; Inputs:
;   Memory locations 0x0000-0x0003 must contain valid saved register data.
; Outputs:
;   R0-R3 restored to the values read from memory.
; ==============================================================================


; ==============================================================================
; HARDWARE STACK ENGINE MACROS (Full Descending)
; ==============================================================================







; ==============================================================================
; MACRO: PUSHALL / POPALL
; Description:
;   Spills and restores all four general-purpose registers to/from the Argument Stack.
; ==============================================================================



; ==============================================================================
; SUBROUTINE LINKAGE MACROS (RCALL / RRET)
; ==============================================================================



; ==============================================================================
; BYTE EXTRACTION & MODIFICATION MACROS (Using Native AND)
; ==============================================================================





; ==============================================================================
; POLLED SERIAL UART TERMINAL I/O MACROS
; ==============================================================================


        .org 0x0100

; ==============================================================================
; SECTION 1: Program Entry & Stack Initialization
; ==============================================================================
        _start:
0100        ; 1. Initialize Return Stack Pointer (RSP) at [0x0004] = 0xFEFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        PUSH8   R1, >(0xFEFF)                  ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        PUSH8   R1, <(0xFEFF)                  ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        LD      R0, 4               ; R0 = 0x0004 (RSP scratchpad address) ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        LD      (R0), R1            ; [0x0004] = 0xFEFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100                                               ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        ; 2. Initialize Argument Stack Pointer (ASP) at [0x0005] = 0xFAFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        PUSH8   R1, >(0xFAFF)                  ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        PUSH8   R1, <(0xFAFF)                  ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        INC     R0                  ; R0 = 0x0005 (ASP scratchpad address) ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        LD      (R0), R1            ; [0x0005] = 0xFAFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100                                               ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        ; 3. Jump to the main function         ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        PUSH8   R0, >(_main)                   ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        PUSH8   R0, <(_main)                   ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
0100        JMP     R0                  ; Unconditional register-indirect jump to _main ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 01 F8 09 F0]
    
0108    _main:                                     ; [00]
    ; 3. Print startup banner
0109        PUSH8   R1, >(msg_banner)              ; [F9 03 F9 9A]
0109        PUSH8   R1, <(msg_banner)              ; [F9 03 F9 9A]
010B        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
010B        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
010B        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]

; ==============================================================================
; SECTION 2: Main Command Dispatch Loop
; ==============================================================================
        monitor_loop:
    ; Display prompt: "> "
010E        PUSH8   R1, >(msg_prompt)              ; [F9 03 F9 F8]
010E        PUSH8   R1, <(msg_prompt)              ; [F9 03 F9 F8]
0110        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
0110        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
0110        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]

    ; Read interactive command line into line_buffer
0113        PUSH8   R1, >(line_buffer)             ; [F9 04 F9 46]
0113        PUSH8   R1, <(line_buffer)             ; [F9 04 F9 46]
0115        PUSH8   R0, >(read_line)               ; [F8 02 F8 B1 F4 00]
0115        PUSH8   R0, <(read_line)               ; [F8 02 F8 B1 F4 00]
0115        LINK    R0, R0                         ; [F8 02 F8 B1 F4 00]

    ; Skip leading spaces
0118        PUSH8   R3, >(line_buffer)             ; [FB 04 FB 46]
0118        PUSH8   R3, <(line_buffer)             ; [FB 04 FB 46]
011A        PUSH8   R0, >(skip_spaces)             ; [F8 03 F8 2A F4 00]
011A        PUSH8   R0, <(skip_spaces)             ; [F8 03 F8 2A F4 00]
011A        LINK    R0, R0                         ; [F8 03 F8 2A F4 00]

    ; Read command character from (R3++)
011D        LD      R1, (R3++)                     ; [47]
011D        LD      R1, R1                         ; [05 BC 00 F8 00 F8 FF A4 BC]
011D        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]
011D        PUSH8   R0, >(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
011D        PUSH8   R0, <(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
011D        AND     R1, R0                         ; [05 BC 00 F8 00 F8 FF A4 BC]
011D        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]

    ; Empty line check: if char == 0, loop
0122        XOR     R0, R0                         ; [90]
0122        SUB     R0, R1                         ; [71]
0123        PUSH8   R2, >(monitor_loop)            ; [FA 01 FA 0E]
0123        PUSH8   R2, <(monitor_loop)            ; [FA 01 FA 0E]
0125        JMP.Z   R2, R0                         ; [D8]

    ; Check 'e' / 'E' (Examine)
0125        PUSH8   R0, >(101)                     ; [00 F8 00 F8 65]
0125        PUSH8   R0, <(101)                     ; [00 F8 00 F8 65]
0128        SUB     R0, R1                         ; [71]
0128        PUSH8   R2, >(cmd_examine)             ; [00 FA 01 FA 78]
0128        PUSH8   R2, <(cmd_examine)             ; [00 FA 01 FA 78]
012B        JMP.Z   R2, R0                         ; [D8]
012B        PUSH8   R0, >(69)                      ; [00 F8 00 F8 45]
012B        PUSH8   R0, <(69)                      ; [00 F8 00 F8 45]
012E        SUB     R0, R1                         ; [71]
012E        PUSH8   R2, >(cmd_examine)             ; [00 FA 01 FA 78]
012E        PUSH8   R2, <(cmd_examine)             ; [00 FA 01 FA 78]
0131        JMP.Z   R2, R0                         ; [D8]

    ; Check 'c' / 'C' (Change)
0131        PUSH8   R0, >(99)                      ; [00 F8 00 F8 63]
0131        PUSH8   R0, <(99)                      ; [00 F8 00 F8 63]
0134        SUB     R0, R1                         ; [71]
0134        PUSH8   R2, >(cmd_change)              ; [00 FA 01 FA C2]
0134        PUSH8   R2, <(cmd_change)              ; [00 FA 01 FA C2]
0137        JMP.Z   R2, R0                         ; [D8]
0137        PUSH8   R0, >(67)                      ; [00 F8 00 F8 43]
0137        PUSH8   R0, <(67)                      ; [00 F8 00 F8 43]
013A        SUB     R0, R1                         ; [71]
013A        PUSH8   R2, >(cmd_change)              ; [00 FA 01 FA C2]
013A        PUSH8   R2, <(cmd_change)              ; [00 FA 01 FA C2]
013D        JMP.Z   R2, R0                         ; [D8]

    ; Check 'g' / 'G' (Go / Run)
013D        PUSH8   R0, >(103)                     ; [00 F8 00 F8 67]
013D        PUSH8   R0, <(103)                     ; [00 F8 00 F8 67]
0140        SUB     R0, R1                         ; [71]
0140        PUSH8   R2, >(cmd_go)                  ; [00 FA 01 FA 52]
0140        PUSH8   R2, <(cmd_go)                  ; [00 FA 01 FA 52]
0143        JMP.Z   R2, R0                         ; [D8]
0143        PUSH8   R0, >(71)                      ; [00 F8 00 F8 47]
0143        PUSH8   R0, <(71)                      ; [00 F8 00 F8 47]
0146        SUB     R0, R1                         ; [71]
0146        PUSH8   R2, >(cmd_go)                  ; [00 FA 01 FA 52]
0146        PUSH8   R2, <(cmd_go)                  ; [00 FA 01 FA 52]
0149        JMP.Z   R2, R0                         ; [D8]

    ; Unknown command error
0149        PUSH8   R1, >(msg_unknown)             ; [00 F9 03 F9 FC]
0149        PUSH8   R1, <(msg_unknown)             ; [00 F9 03 F9 FC]
014C        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
014C        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
014C        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]
014F        PUSH8   R2, >(monitor_loop)            ; [FA 01 FA 0E]
014F        PUSH8   R2, <(monitor_loop)            ; [FA 01 FA 0E]
0151        JMP     R2                             ; [F2]

; ==============================================================================
; SECTION 3: Command Implementations
; ==============================================================================

; ------------------------------------------------------------------------------
; COMMAND: 'g <addr>' (Go / Execute at target address)
; ------------------------------------------------------------------------------
0151    cmd_go:                                    ; [00]
0152        PUSH8   R0, >(skip_spaces)             ; [F8 03 F8 2A F4 00]
0152        PUSH8   R0, <(skip_spaces)             ; [F8 03 F8 2A F4 00]
0152        LINK    R0, R0                         ; [F8 03 F8 2A F4 00]
0155        PUSH8   R0, >(parse_hex)               ; [F8 03 F8 4B F4 00]
0155        PUSH8   R0, <(parse_hex)               ; [F8 03 F8 4B F4 00]
0155        LINK    R0, R0                         ; [F8 03 F8 4B F4 00]
0158        LD      R2, R1              ; R2 = target execution address ; [09]

0158        PUSH8   R1, >(msg_running)             ; [00 F9 04 F9 27]
0158        PUSH8   R1, <(msg_running)             ; [00 F9 04 F9 27]
015B        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
015B        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
015B        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]

015E        LD      R1, R2                         ; [06]
015E        PUSH8   R0, >(print_hex16)             ; [00 F8 02 F8 48 F4 00]
015E        PUSH8   R0, <(print_hex16)             ; [00 F8 02 F8 48 F4 00]
015E        LINK    R0, R0                         ; [00 F8 02 F8 48 F4 00]

0162        PUSH8   R1, >(msg_run_tail)            ; [F9 04 F9 2E]
0162        PUSH8   R1, <(msg_run_tail)            ; [F9 04 F9 2E]
0164        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
0164        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
0164        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]

0167        PUSH8   R0, >(.go_return)              ; [F8 01 F8 70]
0167        PUSH8   R0, <(.go_return)              ; [F8 01 F8 70]
0169        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0169        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
016E        LINK    R2, R0              ; Call target ; [00 F6 00]

        .go_return:
0170        PUSH8   R1, >(msg_returned)            ; [F9 04 F9 32]
0170        PUSH8   R1, <(msg_returned)            ; [F9 04 F9 32]
0172        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
0172        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
0172        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]
0175        PUSH8   R2, >(monitor_loop)            ; [FA 01 FA 0E]
0175        PUSH8   R2, <(monitor_loop)            ; [FA 01 FA 0E]
0177        JMP     R2                             ; [F2]


; ------------------------------------------------------------------------------
; COMMAND: 'e [<addr>]' (Examine 8 Words)
; ------------------------------------------------------------------------------
0177    cmd_examine:                               ; [00]
0178        PUSH8   R0, >(skip_spaces)             ; [F8 03 F8 2A F4 00]
0178        PUSH8   R0, <(skip_spaces)             ; [F8 03 F8 2A F4 00]
0178        LINK    R0, R0                         ; [F8 03 F8 2A F4 00]

    ; Peek at next character in buffer at R3
017B        LD      R1, (R3)                       ; [27]
017B        LD      R1, R1                         ; [05 BC 00 F8 00 F8 FF A4 BC]
017B        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]
017B        PUSH8   R0, >(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
017B        PUSH8   R0, <(0x00FF)                  ; [05 BC 00 F8 00 F8 FF A4 BC]
017B        AND     R1, R0                         ; [05 BC 00 F8 00 F8 FF A4 BC]
017B        XCHG    R0                             ; [05 BC 00 F8 00 F8 FF A4 BC]

    ; Check if empty (null terminator == 0) -> continue from last address
0180        XOR     R0, R0                         ; [90]
0180        SUB     R0, R1                         ; [71]
0181        PUSH8   R2, >(.use_prev_addr)          ; [FA 01 FA 8A]
0181        PUSH8   R2, <(.use_prev_addr)          ; [FA 01 FA 8A]
0183        JMP.Z   R2, R0                         ; [D8]

    ; Address was typed -> parse it into R1
0183        PUSH8   R0, >(parse_hex)               ; [00 F8 03 F8 4B F4 00]
0183        PUSH8   R0, <(parse_hex)               ; [00 F8 03 F8 4B F4 00]
0183        LINK    R0, R0                         ; [00 F8 03 F8 4B F4 00]
0187        PUSH8   R2, >(.start_dump)             ; [FA 01 FA 8D]
0187        PUSH8   R2, <(.start_dump)             ; [FA 01 FA 8D]
0189        JMP     R2                             ; [F2]

0189    .use_prev_addr:                            ; [00]
018A        PUSH8   R2, >(dump_ptr)                ; [FA 04 FA 44]
018A        PUSH8   R2, <(dump_ptr)                ; [FA 04 FA 44]
018C        LD      R1, (R2)            ; Continue from where previous examine finished ; [26]

018C    .start_dump:                               ; [00]
    ; Store current dump pointer to memory
018D        PUSH8   R2, >(dump_ptr)                ; [FA 04 FA 44]
018D        PUSH8   R2, <(dump_ptr)                ; [FA 04 FA 44]
018F        LD      (R2), R1                       ; [39]

    ; Print address header ("0000: ")
018F        PUSH8   R0, >(print_hex16)             ; [00 F8 02 F8 48 F4 00]
018F        PUSH8   R0, <(print_hex16)             ; [00 F8 02 F8 48 F4 00]
018F        LINK    R0, R0                         ; [00 F8 02 F8 48 F4 00]
0193        PUSH8   R1, >(msg_colon)               ; [F9 03 F9 FA]
0193        PUSH8   R1, <(msg_colon)               ; [F9 03 F9 FA]
0195        PUSH8   R0, >(puts)                    ; [F8 01 F8 EB F4 00]
0195        PUSH8   R0, <(puts)                    ; [F8 01 F8 EB F4 00]
0195        LINK    R0, R0                         ; [F8 01 F8 EB F4 00]

    ; Initialize loop counter = 8 in memory
0198        PUSH8   R0, >(8)                       ; [F8 00 F8 08]
0198        PUSH8   R0, <(8)                       ; [F8 00 F8 08]
019A        PUSH8   R2, >(dump_cnt)                ; [FA 04 FA 45]
019A        PUSH8   R2, <(dump_cnt)                ; [FA 04 FA 45]
019C        LD      (R2), R0                       ; [38]

019C    .examine_loop:                             ; [00]
    ; 1. Fetch current pointer from memory and read the word
019D        PUSH8   R0, >(dump_ptr)                ; [F8 04 F8 44]
019D        PUSH8   R0, <(dump_ptr)                ; [F8 04 F8 44]
019F        LD      R2, (R0)            ; R2 = current memory address ; [28]
019F        LD      R1, (R2++)          ; R1 = word at address; R2 is incremented ; [46]

    ; 2. Immediately save advanced pointer back to memory
01A0        LD      (R0), R2                       ; [32]

    ; 3. Print the word followed by a space
01A0        PUSH8   R0, >(print_hex16)             ; [00 F8 02 F8 48 F4 00]
01A0        PUSH8   R0, <(print_hex16)             ; [00 F8 02 F8 48 F4 00]
01A0        LINK    R0, R0                         ; [00 F8 02 F8 48 F4 00]
01A4        PUSH8   R1, >(32)                      ; [F9 00 F9 20]
01A4        PUSH8   R1, <(32)                      ; [F9 00 F9 20]
01A6        XCHG    R0                             ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        XCHG    R2                             ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        XCHG    R3                             ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        LD      R0, 15              ; UART TX MMIO (0x000F) ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6                                               ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6    ._PUTC_WAIT__M76:                          ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        LD      R2, (R0)                       ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        PUSH8   R3, >(._PUTC_SEND__M76)        ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        PUSH8   R3, <(._PUTC_SEND__M76)        ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
01A6        JMP.Z   R3, R2                         ; [BC BE BF 1F 28 00 FB 01 FB AF DE 00 FB 01 FB A8 F3 00 31 BF BE BC]
