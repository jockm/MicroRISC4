; ==============================================================================
; Standard Runtime Library (placed after application code & data)
; ==============================================================================
; ==============================================================================
; FILE: lib/M4R_LIB.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Math & Relational Runtime Subroutine Library for MiniRISC4.
;   Provides 16-bit unsigned multiplication (MULT), restoring integer division (DIV),
;   modulo/remainder (MOD), and unsigned relational comparisons (_CMP_*).
;
; Table of Contents:
;   1. SUBROUTINE: MULT        - 16-bit unsigned binary multiplication
;   2. HELPER:     DIVMOD_CORE - 16-bit binary restoring division engine
;   3. SUBROUTINE: DIV         - 16-bit unsigned integer division
;   4. SUBROUTINE: MOD         - 16-bit unsigned integer remainder / modulo
;   5. RELATIONAL: _CMP_LT     - Unsigned Less-Than comparison (<)
;   6. RELATIONAL: _CMP_LE     - Unsigned Less-Than-or-Equal comparison (<=)
;   7. RELATIONAL: _CMP_GT     - Unsigned Greater-Than comparison (>)
;   8. RELATIONAL: _CMP_GE     - Unsigned Greater-Than-or-Equal comparison (>=)
;
; Calling Conventions & Stack Rules:
;   - Argument Stack (ASP @ 0x0005, Base 0xFAFF):
;       Math routines (MULT, DIV, MOD) receive operands on the Argument Stack.
;       Binary operands (A op B):
;         Top of Stack (first popped)  : Operand B (RHS / Multiplier / Divisor)
;         Second on Stack (next popped): Operand A (LHS / Multiplicand / Dividend)
;       Result is pushed back onto the Argument Stack and returned in R1.
;   - Return Stack (RSP @ 0x0004, Base 0xFEFF):
;       All routines preserve caller return linkage on the Return Stack via
;       RPUSH R0 upon entry, returning via RRET (RPOP R0; JMP R0).
;   - Comparison Helpers (_CMP_*):
;       Operands passed in primary registers: R1 = LHS (A), R2 = RHS (B).
;       Boolean result returned in R1 (1 = True, 0 = False).
;   - Register-Indirect Branching:
;       All branches (JMP, JMP.Z, JMP.M, LINK) are strictly register-indirect.
;       Target addresses are pre-loaded into registers via LOAD16 prior to branching.
; ==============================================================================


; ==============================================================================
; SECTION 1: 16-Bit Binary Multiplication (MULT)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MULT
; Description:
;   Performs 16-bit unsigned multiplication: Product = A * B (modulo 65536).
;   Uses the classic shift-and-add binary multiplication algorithm with an
;   explicit 16-step iteration counter.
;
; Algorithm:
;   1. Pop Multiplier (B) into R2 and Multiplicand (A) into R1 from ASP.
;   2. Clear product accumulator (R3 = 0).
;   3. For each of the 16 bits:
;      a. Test LSB of Multiplier by rotating right (ROT.R R2) into bit 15 (sign bit).
;      b. If bit 15 is 1, jump to _MULT_ADD to add Multiplicand to Accumulator.
;      c. Restore Multiplier bit alignment (ROT.L R2), shift Multiplier right by 1,
;         and shift Multiplicand left by 1.
;      d. Decrement loop counter. Exit early if Multiplier reaches 0.
;   4. Return 16-bit product in R1 and push onto ASP.
;
; Stack Layout:
;   Entry: [ASP]   = Multiplier (B)
;          [ASP+1] = Multiplicand (A)
;   Exit:  [ASP]   = Product (A * B & 0xFFFF)
;
; Registers:
;   R1 = Multiplicand (A) -> Product output
;   R2 = Multiplier (B)
;   R3 = Product Accumulator (caller R3 preserved in shadow_r[3])
;   shadow_r[0] = 16-step loop counter
; ==============================================================================
0BFC    MULT:                                      ; [00]
0BFD        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0BFD        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Pop operands from Argument Stack (0x0005)
0C02        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C02        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C08        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C08        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]

    ; Free R3 to act as product accumulator; preserve caller R3 in hardware shadow
0C0D        XCHG    R3                  ; shadow_r[3] = caller R3 ; [BF]
0C0E        XOR     R3, R3                         ; [9F]

    ; Initialize 16-iteration loop counter in shadow_r[0]
0C0E        XCHG    R0                  ; shadow_r[0] = caller R0 ; [BC]
0C0F        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
0C0F        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
0C11        XCHG    R0                  ; R0 restored; shadow_r[0] = 16 ; [BC]

0C11    _MULT_LOOP:                                ; [00]
    ; Optimization: check if remaining Multiplier bits are zero -> exit early
0C12        PUSH8   R0, >(_MULT_DONE)              ; [F8 0C F8 26]
0C12        PUSH8   R0, <(_MULT_DONE)              ; [F8 0C F8 26]
0C14        JMP.Z   R0, R2              ; If R2 == 0, multiplication complete ; [D2]

    ; Test LSB (bit 0) of Multiplier: rotate right shifts bit 0 into bit 15 (sign bit)
0C14        ROT.R   R2                             ; [C6]
0C15        PUSH8   R0, >(_MULT_ADD)               ; [F8 0C F8 1C]
0C15        PUSH8   R0, <(_MULT_ADD)               ; [F8 0C F8 1C]
0C17        JMP.M   R0, R2              ; If bit 15 is 1 (negative), bit 0 was set -> add ; [E2]

    ; Bit 0 was 0: no addition, proceed with bit shifts
0C17        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0C18        SHIFT.R R2                  ; Multiplier >>= 1 (logical right shift) ; [B6]
0C18        SHIFT.L R1                  ; Multiplicand <<= 1 (logical left shift) ; [B1]
0C19        PUSH8   R0, >(_MULT_DEC)               ; [F8 0C F8 1E]
0C19        PUSH8   R0, <(_MULT_DEC)               ; [F8 0C F8 1E]
0C1B        JMP     R0                  ; Decrement iteration counter ; [F0]

0C1B    _MULT_ADD:                                 ; [00]
0C1C        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0C1C        ADD     R3, R1              ; Accumulator += Multiplicand ; [6D]
0C1D        SHIFT.R R2                  ; Multiplier >>= 1 ; [B6]
0C1D        SHIFT.L R1                  ; Multiplicand <<= 1 ; [B1]

        _MULT_DEC:
0C1E        XCHG    R0                  ; Access loop counter from shadow_r[0] ; [BC]
0C1E        DEC     R0                  ; counter-- ; [CC]
0C1F        PUSH8   R1, >(_MULT_DONE_CTR)          ; [F9 0C F9 25]
0C1F        PUSH8   R1, <(_MULT_DONE_CTR)          ; [F9 0C F9 25]
0C21        JMP.Z   R1, R0              ; If counter == 0, loop finished ; [D4]
0C21        XCHG    R0                  ; Save updated counter back to shadow_r[0] ; [BC]

0C22        PUSH8   R0, >(_MULT_LOOP)              ; [F8 0C F8 12]
0C22        PUSH8   R0, <(_MULT_LOOP)              ; [F8 0C F8 12]
0C24        JMP     R0                             ; [F0]

0C24    _MULT_DONE_CTR:                            ; [00]
0C25        XCHG    R0                  ; Restore shadow_r[0] / caller R0 ; [BC]

0C25    _MULT_DONE:                                ; [00]
0C26        LD      R1, R3              ; R1 = Final 16-bit Product ; [07]
0C26        XCHG    R3                  ; Restore caller R3 from shadow_r[3] ; [BF]
0C27        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C27        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C2C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C2C        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 2: 16-Bit Restoring Division Engine (DIVMOD_CORE)
; ==============================================================================

; ==============================================================================
; HELPER: DIVMOD_CORE
; Description:
;   Core 16-bit unsigned restoring division routine.
;   Computes both quotient and remainder simultaneously using shift-and-subtract.
;
; Inputs:
;   R1 = Dividend (N)
;   R2 = Divisor (D)
; Outputs:
;   R1 = Quotient (N / D)
;   R3 = Remainder (N % D)
;
; Special Cases:
;   Division by Zero: If D == 0, returns Quotient = 0xFFFF, Remainder = Dividend (N).
;
; Registers:
;   R1 = Dividend (shifts left; quotient bits shifted into LSB) -> returns Quotient
;   R2 = Divisor (preserved in shadow_r[2] during loop)
;   R3 = Remainder accumulator -> returns Remainder
;   shadow_r[0] = 16-iteration loop counter
; ==============================================================================
0C32    DIVMOD_CORE:                               ; [00]
0C33        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C33        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Check for divide-by-zero condition (Divisor R2 == 0)
0C38        PUSH8   R0, >(_DIV_ZERO)               ; [00 F8 0C F8 65]
0C38        PUSH8   R0, <(_DIV_ZERO)               ; [00 F8 0C F8 65]
0C3B        JMP.Z   R0, R2              ; If R2 == 0, branch to error handler ; [D2]

0C3B        XOR     R3, R3                         ; [9F]

    ; Preserve Divisor in shadow_r[2] so R2 is available for branch scratch
0C3C        XCHG    R2                             ; [BE]

    ; Initialize 16-bit loop counter in shadow_r[0]
0C3C        XCHG    R0                             ; [BC]
0C3D        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
0C3D        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
0C3F        XCHG    R0                             ; [BC]

0C3F    _DIV_BIT_LOOP:                             ; [00]
0C40        SHIFT.L R3                  ; Remainder <<= 1 ; [B3]

    ; Shift MSB of Dividend into LSB of Remainder
0C40        PUSH8   R2, >(_DIV_CARRY_IN)           ; [00 FA 0C FA 47]
0C40        PUSH8   R2, <(_DIV_CARRY_IN)           ; [00 FA 0C FA 47]
0C43        JMP.M   R2, R1              ; Test bit 15 (MSB) of Dividend ; [E9]

0C43        PUSH8   R2, >(_DIV_SHIFT_CONT)         ; [00 FA 0C FA 48]
0C43        PUSH8   R2, <(_DIV_SHIFT_CONT)         ; [00 FA 0C FA 48]
0C46        JMP     R2                             ; [F2]

0C46    _DIV_CARRY_IN:                             ; [00]
0C47        INC     R3                  ; Remainder |= 1 (MSB shifted out of Dividend was 1) ; [CB]

0C47    _DIV_SHIFT_CONT:                           ; [00]
0C48        SHIFT.L R1                  ; Dividend <<= 1 (shifts quotient bit into LSB) ; [B1]

    ; Compare current Remainder (R3) with Divisor (held in shadow_r[2])
0C48        XCHG    R2                  ; R2 = Divisor, shadow_r[2] = scratch ; [BE]
0C49        XCHG    R0                  ; R0 = loop counter, shadow_r[0] = scratch ; [BC]
0C49        XCHG    R0                  ; Restore R0 ; [BC]

    ; Compute test trial subtraction: difference = Remainder - Divisor
0C4A        XCHG    R0                             ; [BC]
0C4A        LD      R0, R3                         ; [03]
0C4B        SUB     R0, R2              ; R0 = Remainder - Divisor ; [72]
0C4B        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Check if trial subtraction produced a negative result
0C4C        XCHG    R0                  ; R0 = difference ; [BC]
0C4C        PUSH8   R2, >(_DIV_NO_SUB)             ; [00 FA 0C FA 55]
0C4C        PUSH8   R2, <(_DIV_NO_SUB)             ; [00 FA 0C FA 55]
0C4F        JMP.M   R2, R0              ; If negative, cannot subtract -> skip ; [E8]
0C4F        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Successful subtraction: Remainder gets difference, Quotient LSB = 1
0C50        XCHG    R0                             ; [BC]
0C50        LD      R3, R0              ; Remainder = difference (subtraction committed) ; [0C]
0C51        XCHG    R0                             ; [BC]
0C51        INC     R1                  ; Quotient LSB = 1 ; [C9]

0C52        PUSH8   R2, >(_DIV_DEC_LOOP)           ; [FA 0C FA 56]
0C52        PUSH8   R2, <(_DIV_DEC_LOOP)           ; [FA 0C FA 56]
0C54        JMP     R2                             ; [F2]

0C54    _DIV_NO_SUB:                               ; [00]
0C55        XCHG    R0                  ; Restore R0 ; [BC]

0C55    _DIV_DEC_LOOP:                             ; [00]
0C56        XCHG    R2                  ; Restore Divisor back into shadow_r[2] ; [BE]
0C56        XCHG    R0                  ; Access loop counter ; [BC]
0C57        DEC     R0                  ; counter-- ; [CC]
0C57        PUSH8   R2, >(_DIV_EXIT)               ; [00 FA 0C FA 5E]
0C57        PUSH8   R2, <(_DIV_EXIT)               ; [00 FA 0C FA 5E]
0C5A        JMP.Z   R2, R0              ; If counter == 0, division complete ; [D8]
0C5A        XCHG    R0                  ; Save counter back to shadow_r[0] ; [BC]

0C5B        PUSH8   R0, >(_DIV_BIT_LOOP)           ; [F8 0C F8 40]
0C5B        PUSH8   R0, <(_DIV_BIT_LOOP)           ; [F8 0C F8 40]
0C5D        JMP     R0                             ; [F0]

0C5D    _DIV_EXIT:                                 ; [00]
0C5E        XCHG    R0                  ; Restore original R0 ; [BC]
0C5E        XCHG    R2                  ; Restore original R2 (Divisor) ; [BE]
0C5F        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C5F        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _DIV_ZERO:
    ; Divide by zero: Remainder = original Dividend, Quotient = 0xFFFF
0C65        LD      R3, R1              ; Remainder = Dividend ; [0D]
0C65        XOR     R1, R1                         ; [95]
0C66        DEC     R1                  ; R1 = 0xFFFF (standard unsigned error quotient) ; [CD]
0C66        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C66        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 3: 16-Bit Unsigned Integer Division (DIV)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: DIV
; Description:
;   16-bit unsigned integer division: Quotient = Dividend / Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Quotient (N / D)
; Register : R1 = Quotient
; ==============================================================================
0C6C    DIV:                                       ; [00]
0C6D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C6D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C72        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C72        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C78        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C78        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C7D        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 0C F8 33 F4 00]
0C7D        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 0C F8 33 F4 00]
0C7D        LINK    R0, R0                         ; [00 F8 0C F8 33 F4 00]
0C81        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C81        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0C86        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0C86        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 4: 16-Bit Unsigned Integer Modulo (MOD)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MOD
; Description:
;   16-bit unsigned integer remainder: Remainder = Dividend % Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Remainder (N % D)
; Register : R1 = Remainder
; ==============================================================================
0C8C    MOD:                                       ; [00]
0C8D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C92        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C92        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C98        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C98        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C9D        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 0C F8 33 F4 00]
0C9D        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 0C F8 33 F4 00]
0C9D        LINK    R0, R0                         ; [00 F8 0C F8 33 F4 00]
0CA1        LD      R1, R3              ; Move Remainder to return register R1 ; [07]
0CA1        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA1        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CA7        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CA7        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 5: Unsigned Relational Comparisons (_CMP_LT, _CMP_LE, _CMP_GT, _CMP_GE)
; Description:
;   Evaluates 16-bit unsigned inequalities across the entire 0x0000-0xFFFF range.
;   Because MiniRISC4 only supports JMP.M (sign bit is 1) and JMP.Z (zero) on
;   register contents, unsigned comparison must differentiate between numbers
;   with differing MSBs (where bit 15 represents the 0x8000 boundary) and numbers
;   with identical MSBs (where standard subtraction gives the correct magnitude).
;
; Inputs:
;   R1 = Left-Hand Side (LHS / A)
;   R2 = Right-Hand Side (RHS / B)
; Outputs:
;   R1 = 1 if the condition is True
;   R1 = 0 if the condition is False
; ==============================================================================

; ==============================================================================
; SUBROUTINE: _CMP_LT  (Unsigned Less-Than: A < B)
; ==============================================================================
        _CMP_LT:
0CAD        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CAD        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Compare MSBs (bit 15) using XOR
0CB2        XCHG    R0                             ; [BC]
0CB3        LD      R0, R1                         ; [01]
0CB3        XOR     R0, R2              ; If bit 15 is set, operands have opposite signs ; [92]
0CB4        PUSH8   R3, >(_CMP_LT_DIFF_SIGNS)      ; [FB 0C FB BE]
0CB4        PUSH8   R3, <(_CMP_LT_DIFF_SIGNS)      ; [FB 0C FB BE]
0CB6        JMP.M   R3, R0              ; Branch if MSBs are different ; [EC]
0CB6        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: MSBs are identical -> standard subtraction A - B gives correct relation
0CB7        SUB     R1, R2              ; R1 = A - B ; [76]
0CB7        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 0D F8 01]
0CB7        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 0D F8 01]
0CBA        JMP.M   R0, R1              ; If difference is negative, A < B -> True ; [E1]
0CBA        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 0D F8 09]
0CBA        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 0D F8 09]
0CBD        JMP     R0                  ; Else A >= B -> False ; [F0]

0CBD    _CMP_LT_DIFF_SIGNS:                        ; [00]
0CBE        XCHG    R0                  ; Restore R0 ; [BC]
    ; When MSBs differ: the operand with MSB=1 is in range [0x8000..0xFFFF],
    ; while the operand with MSB=0 is in range [0x0000..0x7FFF].
    ; Therefore, if LHS (R1) has bit 15 set, LHS is strictly larger -> False.
0CBE        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 0D F8 09]
0CBE        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 0D F8 09]
0CC1        JMP.M   R0, R1              ; If R1[15] == 1, A > B -> False ; [E1]
0CC1        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 0D F8 01]
0CC1        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 0D F8 01]
0CC4        JMP     R0                  ; Else A < B -> True ; [F0]

; ==============================================================================
; SUBROUTINE: _CMP_LE  (Unsigned Less-Than-or-Equal: A <= B)
; ==============================================================================
0CC4    _CMP_LE:                                   ; [00]
0CC5        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC5        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Check equality (A == B)
0CCA        XCHG    R0                             ; [BC]
0CCB        LD      R0, R1                         ; [01]
0CCB        SUB     R0, R2              ; Test difference A - B ; [72]
0CCC        PUSH8   R3, >(_CMP_LE_EQUAL)           ; [FB 0C FB D8]
0CCC        PUSH8   R3, <(_CMP_LE_EQUAL)           ; [FB 0C FB D8]
0CCE        JMP.Z   R3, R0              ; If A == B, branch to True ; [DC]
0CCE        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: Not equal -> evaluate A < B
0CCF        PUSH8   R0, >(_CMP_LT)                 ; [F8 0C F8 AD F4 00]
0CCF        PUSH8   R0, <(_CMP_LT)                 ; [F8 0C F8 AD F4 00]
0CCF        LINK    R0, R0                         ; [F8 0C F8 AD F4 00]
0CD2        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CD2        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _CMP_LE_EQUAL:
0CD8        XCHG    R0                  ; Restore R0 ; [BC]
0CD8        PUSH8   R1, >(1)                       ; [00 F9 00 F9 01]
0CD8        PUSH8   R1, <(1)                       ; [00 F9 00 F9 01]
0CDB        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CDB        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CDB        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CDB        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CDB        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
