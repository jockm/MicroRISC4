// ==============================================================================
// FILE: lib/sys.a4
// MiniRISC4 OS User-Space Syscall Client Library
// Matches worker_stub.asm 3-class Trap 1 ABI
// ==============================================================================

const u16 SYS_EXIT      = 0x01;
const u16 SYS_PUTC      = 0x02;
const u16 SYS_GETC      = 0x03;
const u16 SYS_KILL      = 0x04;
const u16 SYS_CLOSE     = 0x05;

const u16 SYS_WRITE_CON = 0x10;
const u16 SYS_SPAWN     = 0x11;
const u16 SYS_OPEN      = 0x12;
const u16 SYS_WRITE     = 0x13;
const u16 SYS_OPENDIR   = 0x14;
const u16 SYS_UNLINK    = 0x15;
const u16 SYS_MKDIR     = 0x16;
const u16 SYS_RMDIR     = 0x17;
const u16 SYS_CHDIR     = 0x18;

const u16 SYS_READ      = 0x20;
const u16 SYS_READDIR   = 0x21;
const u16 SYS_PS        = 0x22;
const u16 SYS_GETARGS   = 0x23;

const u16 O_RDONLY      = 0;
const u16 O_WRONLY      = 1;

type DirEntry {
    u16 attr;
    u16 size_lo;
    u16 size_hi;
    u16 name[8];
};

type ProcEntry {
    u16 state;
    u16 exit_code;
    u16 name[8];
};

u16 _sys_p1 = 0;
u16 _sys_p2 = 0;
u16 _sys_p3 = 0;
u16 _sys_r1 = 0;
u16 _sys_r2 = 0;
u16 _sys_i  = 0;
u16 _sys_c  = 0;
u16 _sys_w  = 0;

u16 str_word_len(u16 *s) {
    _sys_p1 = s;
    _sys_i = 0;
    while (true) {
        _sys_w = _sys_p1;
        _sys_c = getbyte(_sys_w, _sys_i);
        if (_sys_c == 0) {
            return (_sys_i >> 1) + 1;
        }
        _sys_i++;
    }
    return 1;
}

void sys_exit(u16 code) {
    _sys_p1 = code;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x01
    }
}

u16 sys_putc(u16 ch) {
    _sys_p1 = ch;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LD0     R2
        LD0     R0
        INC     R0
        TRAP    R0, 0x02
        LOAD16  R0, __sys_r1
        LD      (R0), R1
    }
    return _sys_r1;
}

u16 sys_getc(u16 *out_ch) {
    asm {
        LD0     R1
        LD0     R2
        LD0     R0
        INC     R0
        TRAP    R0, 0x03
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    _sys_w = out_ch;
    _sys_w[0] = _sys_r2;
    return _sys_r1;
}

u16 sys_puts(u16 *s) {
    _sys_p1 = s;
    _sys_p2 = str_word_len(s);
    _sys_p3 = 0;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LOAD16  R0, __sys_p3
        LD      R3, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x10
        LOAD16  R0, __sys_r1
        LD      (R0), R1
    }
    return _sys_r1;
}

u16 sys_close(u16 fd) {
    _sys_p1 = fd;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LD0     R2
        LD0     R0
        INC     R0
        TRAP    R0, 0x05
        LOAD16  R0, __sys_r1
        LD      (R0), R1
    }
    return _sys_r1;
}

u16 sys_opendir(u16 *path, u16 *out_fd) {
    _sys_p1 = path;
    _sys_p2 = str_word_len(path);
    _sys_p3 = out_fd;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LD0     R3
        LD0     R0
        INC     R0
        TRAP    R0, 0x14
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    _sys_w = _sys_p3;
    _sys_w[0] = _sys_r2;
    return _sys_r1;
}

u16 sys_readdir(u16 dir_fd, DirEntry *ent) {
    _sys_p1 = ent;
    _sys_p2 = 11;
    _sys_p3 = dir_fd;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LOAD16  R0, __sys_p3
        LD      R3, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x21
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    return _sys_r1;
}

u16 sys_spawn(u16 *filename, u16 *out_pid) {
    _sys_p1 = filename;
    _sys_p2 = str_word_len(filename);
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LD0     R3
        LD0     R0
        INC     R0
        TRAP    R0, 0x11
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    _sys_w = out_pid;
    _sys_w[0] = _sys_r2;
    return _sys_r1;
}

u16 sys_open(u16 *path, u16 mode, u16 *out_fd) {
    _sys_p1 = path;
    _sys_p2 = str_word_len(path);
    _sys_p3 = mode;
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LOAD16  R0, __sys_p3
        LD      R3, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x12
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    _sys_w = out_fd;
    _sys_w[0] = _sys_r2;
    return _sys_r1;
}

u16 sys_write(u16 fd, u16 *src_buf, u16 byte_len, u16 *out_written) {
    _sys_p1 = src_buf;
    _sys_p2 = (byte_len + 1) >> 1;
    if (_sys_p2 > 64) {
        _sys_p2 = 64;
        byte_len = 128;
    }
    _sys_p3 = (byte_len << 4) | (fd & 0x000F);
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LOAD16  R0, __sys_p3
        LD      R3, (R0)
        LD0     R0
        INC     R0
        TRAP    R0, 0x13
        LOAD16  R0, __sys_r1
        LD      (R0), R1
        LOAD16  R0, __sys_r2
        LD      (R0), R2
    }
    _sys_w = out_written;
    _sys_w[0] = _sys_r2;
    return _sys_r1;
}

u16 sys_unlink(u16 *path) {
    _sys_p1 = path;
    _sys_p2 = str_word_len(path);
    asm {
        LOAD16  R0, __sys_p1
        LD      R1, (R0)
        LOAD16  R0, __sys_p2
        LD      R2, (R0)
        LD0     R3
        LD0     R0
        INC     R0
        TRAP    R0, 0x15
        LOAD16  R0, __sys_r1
        LD      (R0), R1
    }
    return _sys_r1;
}

