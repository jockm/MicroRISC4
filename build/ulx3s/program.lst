0440        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0440        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

0447    .is_space:                                 ; [00]
0448        INC     R3                             ; [CB]
0448        PUSH8   R0, >(.skip_loop)              ; [00 F8 04 F8 30]
0448        PUSH8   R0, <(.skip_loop)              ; [00 F8 04 F8 30]
044B        JMP     R0                             ; [F0]

; ==============================================================================
; SECTION 6: Hexadecimal Parsing Subroutine
; Inputs:  R3 = pointer to hex string
; Outputs: R1 = parsed 16-bit number
;          R3 = advanced past parsed hex digits
; ------------------------------------------------------------------------------
044B    parse_hex:                                 ; [00]
044C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
044C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE BC]
0452        XOR     R1, R1              ; R1 = accumulator = 0 ; [95]

0452    .parse_digit:                              ; [00]
0453        LD      R2, (R3)                       ; [2B]
0453        LD      R2, R2                         ; [0A BC 00 F8 00 F8 FF A8 BC]
0453        XCHG    R0                             ; [0A BC 00 F8 00 F8 FF A8 BC]
0453        PUSH8   R0, >(0x00FF)                  ; [0A BC 00 F8 00 F8 FF A8 BC]
0453        PUSH8   R0, <(0x00FF)                  ; [0A BC 00 F8 00 F8 FF A8 BC]
0453        AND     R2, R0                         ; [0A BC 00 F8 00 F8 FF A8 BC]
0453        XCHG    R0                             ; [0A BC 00 F8 00 F8 FF A8 BC]

    ; Check if char < '0' (48)
0458        PUSH8   R0, >(48)                      ; [F8 00 F8 30]
0458        PUSH8   R0, <(48)                      ; [F8 00 F8 30]
045A        SUB     R2, R0              ; R2 = char - 48 ; [78]
045A        PUSH8   R0, >(.parse_done)             ; [00 F8 04 F8 96]
045A        PUSH8   R0, <(.parse_done)             ; [00 F8 04 F8 96]
045D        JMP.M   R0, R2              ; If R2 < 0, done ; [E2]

    ; Check if char <= '9' (i.e. R2 <= 9)
045D        PUSH8   R0, >(9)                       ; [00 F8 00 F8 09]
045D        PUSH8   R0, <(9)                       ; [00 F8 00 F8 09]
0460        SUB     R0, R2              ; R0 = 9 - R2 ; [72]
0460        XCHG    R1                  ; shadow_r[1] = acc, R1 is free for target ; [BD]
0461        PUSH8   R1, >(.check_upper)            ; [F9 04 F9 6A]
0461        PUSH8   R1, <(.check_upper)            ; [F9 04 F9 6A]
0463        JMP.M   R1, R0              ; If 9 - R2 < 0, jump to .check_upper ; [E4]
0463        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_num:
0464        SHIFT.L R1                             ; [B1]
0464        SHIFT.L R1                             ; [B1]
0465        SHIFT.L R1                             ; [B1]
0465        SHIFT.L R1                             ; [B1]
0466        ADD     R1, R2                         ; [66]
0466        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
0467        PUSH8   R0, >(.parse_digit)            ; [F8 04 F8 53]
0467        PUSH8   R0, <(.parse_digit)            ; [F8 04 F8 53]
0469        JMP     R0                             ; [F0]

0469    .check_upper:                              ; [00]
046A        XCHG    R1                  ; Restore R1 = acc ; [BD]
    ; 'A' is 65 - 48 = 17
046A        PUSH8   R0, >(17)                      ; [00 F8 00 F8 11]
046A        PUSH8   R0, <(17)                      ; [00 F8 00 F8 11]
046D        SUB     R2, R0              ; R2 = char - 'A' ; [78]
046D        PUSH8   R0, >(.parse_done)             ; [00 F8 04 F8 96]
046D        PUSH8   R0, <(.parse_done)             ; [00 F8 04 F8 96]
0470        JMP.M   R0, R2              ; If char < 'A', done ; [E2]

    ; 'F' is 5. Check if R2 <= 5
0470        PUSH8   R0, >(5)                       ; [00 F8 00 F8 05]
0470        PUSH8   R0, <(5)                       ; [00 F8 00 F8 05]
0473        SUB     R0, R2              ; R0 = 5 - R2 ; [72]
0473        XCHG    R1                  ; shadow_r[1] = acc ; [BD]
0474        PUSH8   R1, >(.check_lower)            ; [F9 04 F9 80]
0474        PUSH8   R1, <(.check_lower)            ; [F9 04 F9 80]
0476        JMP.M   R1, R0              ; If 5 - R2 < 0, jump to .check_lower ; [E4]
0476        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_upper:
0477        SHIFT.L R1                             ; [B1]
0477        SHIFT.L R1                             ; [B1]
0478        SHIFT.L R1                             ; [B1]
0478        SHIFT.L R1                             ; [B1]
0479        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
0479        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
047B        ADD     R2, R0              ; R2 = digit value (10..15) ; [68]
047B        ADD     R1, R2                         ; [66]
047C        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
047C        PUSH8   R0, >(.parse_digit)            ; [00 F8 04 F8 53]
047C        PUSH8   R0, <(.parse_digit)            ; [00 F8 04 F8 53]
047F        JMP     R0                             ; [F0]

047F    .check_lower:                              ; [00]
0480        XCHG    R1                  ; Restore R1 = acc ; [BD]
    ; 'a' is 97 - 65 = 32
0480        PUSH8   R0, >(32)                      ; [00 F8 00 F8 20]
0480        PUSH8   R0, <(32)                      ; [00 F8 00 F8 20]
0483        SUB     R2, R0              ; R2 = char - 'a' ; [78]
0483        PUSH8   R0, >(.parse_done)             ; [00 F8 04 F8 96]
0483        PUSH8   R0, <(.parse_done)             ; [00 F8 04 F8 96]
0486        JMP.M   R0, R2              ; If char < 'a', done ; [E2]

    ; 'f' is 5. Check if R2 <= 5
0486        PUSH8   R0, >(5)                       ; [00 F8 00 F8 05]
0486        PUSH8   R0, <(5)                       ; [00 F8 00 F8 05]
0489        SUB     R0, R2              ; R0 = 5 - R2 ; [72]
0489        XCHG    R1                             ; [BD]
048A        PUSH8   R1, >(.parse_done)             ; [F9 04 F9 96]
048A        PUSH8   R1, <(.parse_done)             ; [F9 04 F9 96]
048C        JMP.M   R1, R0              ; If 5 - R2 < 0, invalid hex char -> done ; [E4]
048C        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_lower:
048D        SHIFT.L R1                             ; [B1]
048D        SHIFT.L R1                             ; [B1]
048E        SHIFT.L R1                             ; [B1]
048E        SHIFT.L R1                             ; [B1]
048F        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
048F        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
0491        ADD     R2, R0                         ; [68]
0491        ADD     R1, R2                         ; [66]
0492        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
0492        PUSH8   R0, >(.parse_digit)            ; [00 F8 04 F8 53]
0492        PUSH8   R0, <(.parse_digit)            ; [00 F8 04 F8 53]
0495        JMP     R0                             ; [F0]

0495    .parse_done:                               ; [00]
0496        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]
0496        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE BC BC F0]

; ==============================================================================
; SECTION 7: Static Messages & Buffers
; ==============================================================================
        .align                          ; Guarantees word boundary for Slot 0 packing

        msg_banner:
049D        .asciz "\r\n============================\r\n  MiniRISC4 ASM Monitor\r\n  Commands:\r\n    e <addr>      (Examine)\r\n    c <addr> <val>(Change)\r\n    g <addr>      (Go / Run)\r\n============================\r\n" ; [0D 0A 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 0D 0A 20 20 4D 69 6E 69 52 49 53 43 34 20 41 53 4D 20 4D 6F 6E 69 74 6F 72 0D 0A 20 20 43 6F 6D 6D 61 6E 64 73 3A 0D 0A 20 20 20 20 65 20 3C 61 64 64 72 3E 20 20 20 20 20 20 28 45 78 61 6D 69 6E 65 29 0D 0A 20 20 20 20 63 20 3C 61 64 64 72 3E 20 3C 76 61 6C 3E 28 43 68 61 6E 67 65 29 0D 0A 20 20 20 20 67 20 3C 61 64 64 72 3E 20 20 20 20 20 20 28 47 6F 20 2F 20 52 75 6E 29 0D 0A 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 0D 0A 00]

        msg_prompt:
04FB        .asciz "> "                            ; [3E 20 00]

04FC    msg_colon:                                 ; [00]
