0658        PUSH8   R0, >(_CMP_LE)                 ; [F8 06 F8 25 F4 00]
0658        PUSH8   R0, <(_CMP_LE)                 ; [F8 06 F8 25 F4 00]
0658        LINK    R0, R0                         ; [F8 06 F8 25 F4 00]
