// ==============================================================================
// FILE: mr4src/act4/os/os_main.a4
// Core 0 OS Kernel Entry, Lean Ring Doorbell Arbitrator & Syscall Dispatcher
// ==============================================================================

import "os_uart.a4";
import "os_sd.a4";
import "os_fat32.a4";
import "os_proc.a4";
import "os_shell.a4";

// Syscall IDs matching worker_stub.asm 3-class wire framing
// Class A: Scalar (0x00..0x0F)
const u16 SYS_EXIT      = 0x01;
const u16 SYS_PUTC      = 0x02;
const u16 SYS_GETC      = 0x03;
const u16 SYS_KILL      = 0x04;
const u16 SYS_CLOSE     = 0x05;

// Class B: Buffer Out (0x10..0x1F)
const u16 SYS_WRITE_CON = 0x10;
const u16 SYS_SPAWN     = 0x11;
const u16 SYS_OPEN      = 0x12;
const u16 SYS_WRITE     = 0x13;
const u16 SYS_OPENDIR   = 0x14;
const u16 SYS_UNLINK    = 0x15;
const u16 SYS_MKDIR     = 0x16;
const u16 SYS_RMDIR     = 0x17;
const u16 SYS_CHDIR     = 0x18;
const u16 SYS_RENAME    = 0x19;
const u16 SYS_STAT_PATH = 0x1A;

// Class C: Buffer In (0x20..0x2F)
const u16 SYS_READ      = 0x20;
const u16 SYS_READDIR   = 0x21;
const u16 SYS_PS        = 0x22;
const u16 SYS_GETARGS   = 0x23;
const u16 SYS_STAT_GET  = 0x24;
const u16 SYS_GETCWD    = 0x25;

// Error & Fault Exit Codes
const u16 ERR_OK          = 0x0000;
const u16 ERR_EMPTY       = 0x0001;
const u16 ERR_IO          = 0x0002;
const u16 ERR_EOF         = 0x0003;
const u16 ERR_UNKNOWN     = 0xFFFF;

const u16 FAULT_CODE_MASK = 0xFFF0;
const u16 FAULT_CODE_BASE = 0xFF00;
const u16 FAULT_ALIGN     = 0xFF0F;

const u16 SYS_BUF_WORDS = 64;

u16 sys_buf[SYS_BUF_WORDS];
DirEntry sys_ent;

// Drain remaining words of an unhandled syscall so RX FIFO stays aligned
void drain_fifo(u16 count) {
    u16 dummy = 0;
    while (count > 0) {
        dummy = noc_rx_word();
        count--;
    }
}

// Read a Class B NUL-terminated packed string payload from Lean Ring RX into sys_buf
void read_fifo_str(u16 wlen) {
    u16 i = 0;
    u16 w = 0;
    while (i < wlen) {
        w = noc_rx_word();
        if (i < (SYS_BUF_WORDS - 1)) {
            sys_buf[i] = w;
        }
        i++;
    }
    if (wlen == 0) {
        sys_buf[0] = 0;
    }
    sys_buf[SYS_BUF_WORDS - 1] = 0;
}

void handle_syscall(void) {
    u16 hdr   = noc_rx_word();
    u16 len   = noc_rx_word();
    u16 pid   = hdr >> 8;
    u16 id    = hdr & 0x00FF;
    u16 arg1  = 0;
    u16 arg2  = 0;
    u16 extra = 0;
    u16 wlen  = 0;
    u16 i     = 0;
    u16 ch    = 0;
    u16 fd    = 0;

    // Direct all Lean Ring replies and FAT32 relative paths to the requesting worker core
    noc_dst_core = pid;
    proc_use_cwd(pid);

    if (id == SYS_EXIT) {
        arg1 = noc_rx_word();
        if ((arg1 & FAULT_CODE_MASK) == FAULT_CODE_BASE && pid > 0 && pid < MAX_CORES) {
            uart_puts("\r\n[FAULT] PID ");
            uart_putc(pid + 48);
            uart_puts(" (");
            uart_puts(procs[pid].name);
            uart_puts("): ");
            if (arg1 == FAULT_ALIGN) {
                uart_puts("align fault");
            } else {
                uart_puts("unhandled trap ");
                uart_put_dec16(arg1 & 0x000F);
            }
            uart_puts(" (0x");
            uart_put_hex16(arg1);
            uart_puts(")\r\n");
        }
        if (proc_mark_exited(pid, arg1) != 0) {
            if (sh_script_fd == 0xFFFF) {
                shell_prompt();
            }
        }
        return;                         // No reply expected
    }

    if (id == SYS_PUTC) {
        arg1 = noc_rx_word();
        arg2 = noc_rx_word();
        if (pid < MAX_CORES && proc_con_out[pid] != 0) {
            uart_putc(arg1);
        }
        noc_tx_word(ERR_OK);
        noc_tx_word(0);
        return;
    }

    if (id == SYS_GETC) {
        arg1 = noc_rx_word();
        arg2 = noc_rx_word();
        if (pid != fg_pid) {
            noc_tx_word(ERR_EMPTY);
            noc_tx_word(0);
        } else {
            ch = fg_rx_pop();
            if (ch == 0xFFFF) {
                noc_tx_word(ERR_EMPTY);
                noc_tx_word(0);
            } else {
                noc_tx_word(ERR_OK);
                noc_tx_word(ch);
            }
        }
        return;
    }

    if (id == SYS_KILL) {
        arg1 = noc_rx_word();
        arg2 = noc_rx_word();
        arg2 = proc_kill(arg1);
        noc_dst_core = pid;
        noc_tx_word(arg2);
        noc_tx_word(0);
        return;
    }

    if (id == SYS_CLOSE) {
        arg1 = noc_rx_word();
        arg2 = noc_rx_word();
        fat32_close(arg1);
        noc_tx_word(ERR_OK);
        noc_tx_word(0);
        return;
    }

    if (id == SYS_WRITE_CON) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        if (pid < MAX_CORES && proc_con_out[pid] != 0) {
            uart_puts(sys_buf);
        }
        noc_tx_word(ERR_OK);
        noc_tx_word(wlen);
        return;
    }

    if (id == SYS_SPAWN) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        // Split optional "PATH ARGS..." at first space
        i = 0;
        arg1 = 0;
        while (i < ((SYS_BUF_WORDS << 1) - 2)) {
            ch = getbyte(sys_buf, i);
            if (ch == 0) {
                break;
            }
            if (ch == 32) {
                setbyte(sys_buf, i, 0);
                i++;
                while (getbyte(sys_buf, i) == 32) {
                    i++;
                }
                arg1 = i;
                break;
            }
            i++;
        }
        ch = 0;
        if (pid < MAX_CORES && proc_con_out[pid] != 0) {
            ch = 1;                     // Child inherits console output from parent
        }
        if (arg1 != 0) {
            arg2 = proc_spawn_from_file(pid, sys_buf, sys_buf, arg1, ch);
        } else {
            arg2 = proc_spawn_from_file(pid, sys_buf, 0, 0, ch);
        }
        noc_dst_core = pid;
        if (arg2 == 0) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
        } else {
            noc_tx_word(ERR_OK);
            noc_tx_word(arg2);
        }
        return;
    }

    if (id == SYS_OPEN) {
        extra = noc_rx_word();          // mode: 0 = read, 1 = write/create, 2 = append
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        if (extra == 0) {
            fd = fat32_open(pid, sys_buf);
        } else if (extra == 2) {
            fd = fat32_open_append(pid, sys_buf);
        } else {
            fd = fat32_open_write(pid, sys_buf);
        }
        if (fd == 0xFFFF) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
        } else {
            noc_tx_word(ERR_OK);
            noc_tx_word(fd);
        }
        return;
    }

    if (id == SYS_WRITE) {
        extra = noc_rx_word();          // (byte_len << 4) | (fd & 0x0F)
        wlen  = noc_rx_word();
        i = 0;
        while (i < wlen) {
            arg1 = noc_rx_word();
            if (i < SYS_BUF_WORDS) {
                sys_buf[i] = arg1;
            }
            i++;
        }
        fd   = extra & 0x000F;
        arg2 = extra >> 4;
        if (arg2 == 0 || arg2 > (wlen << 1)) {
            arg2 = wlen << 1;
        }
        if (arg2 > (SYS_BUF_WORDS << 1)) {
            arg2 = SYS_BUF_WORDS << 1;
        }
        arg1 = fat32_write_bytes(fd, sys_buf, arg2);
        if (arg1 == 0 && arg2 > 0) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
        } else {
            noc_tx_word(ERR_OK);
            noc_tx_word(arg1);
        }
        return;
    }

    if (id == SYS_OPENDIR) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        fd = fat32_opendir(pid, sys_buf);
        if (fd == 0xFFFF) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
        } else {
            noc_tx_word(ERR_OK);
            noc_tx_word(fd);
        }
        return;
    }

    if (id == SYS_UNLINK) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        arg2 = fat32_unlink(sys_buf);
        if (arg2 == 0) {
            noc_tx_word(ERR_OK);
        } else {
            noc_tx_word(ERR_IO);
        }
        noc_tx_word(arg2);
        return;
    }

    if (id == SYS_MKDIR) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        arg2 = fat32_mkdir(sys_buf);
        if (arg2 == 0) {
            noc_tx_word(ERR_OK);
        } else {
            noc_tx_word(ERR_IO);
        }
        noc_tx_word(arg2);
        return;
    }

    if (id == SYS_RMDIR) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        arg2 = fat32_rmdir(sys_buf);
        if (arg2 == 0) {
            noc_tx_word(ERR_OK);
        } else {
            noc_tx_word(ERR_IO);
        }
        noc_tx_word(arg2);
        return;
    }

    if (id == SYS_CHDIR) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        arg2 = fat32_chdir_clus(sys_buf);
        if (arg2 == 0) {
            proc_save_cwd(pid);
            noc_tx_word(ERR_OK);
        } else {
            noc_tx_word(ERR_IO);
        }
        noc_tx_word(arg2);
        return;
    }

    if (id == SYS_RENAME) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        // Split "SRC DST" into sys_buf (SRC) and upper half of sys_buf (DST)
        i = 0;
        arg1 = 0;
        while (i < ((SYS_BUF_WORDS << 1) - 2)) {
            ch = getbyte(sys_buf, i);
            if (ch == 0) {
                break;
            }
            if (ch == 32) {
                setbyte(sys_buf, i, 0);
                i++;
                while (getbyte(sys_buf, i) == 32) {
                    i++;
                }
                arg1 = i;
                break;
            }
            i++;
        }
        if (arg1 == 0) {
            noc_tx_word(ERR_IO);
            noc_tx_word(2);
            return;
        }
        i = 0;
        while (i < 63) {
            ch = getbyte(sys_buf, arg1 + i);
            setbyte(&sys_buf[32], i, ch);
            if (ch == 0) {
                break;
            }
            i++;
        }
        setbyte(&sys_buf[32], 63, 0);
        arg2 = fat32_rename(sys_buf, &sys_buf[32]);
        if (arg2 == 0) {
            noc_tx_word(ERR_OK);
        } else {
            noc_tx_word(ERR_IO);
        }
        noc_tx_word(arg2);
        return;
    }

    if (id == SYS_STAT_PATH) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        read_fifo_str(wlen);
        if (pid >= MAX_CORES) {
            noc_tx_word(ERR_IO);
            noc_tx_word(1);
            return;
        }
        arg2 = fat32_stat(sys_buf, &stat_cache[pid]);
        if (arg2 == 0) {
            noc_tx_word(ERR_OK);
            noc_tx_word(stat_cache[pid].size_lo);
        } else {
            noc_tx_word(ERR_IO);
            noc_tx_word(arg2);
        }
        return;
    }

    if (id == SYS_READ) {
        extra = noc_rx_word();          // fd
        wlen  = noc_rx_word();          // max_words
        if (wlen > 64) {
            wlen = 64;
        }
        arg1 = fat32_read_bytes(extra, sys_buf, wlen << 1);
        if (arg1 == 0) {
            noc_tx_word(ERR_EOF);
            noc_tx_word(0);
        } else {
            arg2 = (arg1 + 1) >> 1;     // word count
            noc_tx_word(ERR_OK);
            noc_tx_word(arg2);
            i = 0;
            while (i < arg2) {
                noc_tx_word(sys_buf[i]);
                i++;
            }
        }
        return;
    }

    if (id == SYS_READDIR) {
        extra = noc_rx_word();          // dir_fd
        wlen  = noc_rx_word();          // max_words (11)
        if (fat32_readdir(extra, &sys_ent) != 0) {
            noc_tx_word(ERR_EOF);
            noc_tx_word(0);
        } else {
            noc_tx_word(ERR_OK);
            noc_tx_word(11);
            noc_tx_word(sys_ent.attr);
            noc_tx_word(sys_ent.size_lo);
            noc_tx_word(sys_ent.size_hi);
            i = 0;
            while (i < 8) {
                noc_tx_word(sys_ent.name[i]);
                i++;
            }
        }
        return;
    }

    if (id == SYS_PS) {
        extra = noc_rx_word();          // pid index (0..MAX_CORES-1)
        wlen  = noc_rx_word();          // max_words (10)
        if (extra >= MAX_CORES) {
            noc_tx_word(ERR_EOF);
            noc_tx_word(0);
        } else {
            noc_tx_word(ERR_OK);
            noc_tx_word(10);
            noc_tx_word(procs[extra].state);
            noc_tx_word(procs[extra].exit_code);
            i = 0;
            while (i < 8) {
                noc_tx_word(procs[extra].name[i]);
                i++;
            }
        }
        return;
    }

    if (id == SYS_GETARGS) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();          // max_words
        if (pid >= MAX_CORES || wlen == 0) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
            return;
        }
        if (wlen > PROC_ARG_WORDS) {
            wlen = PROC_ARG_WORDS;
        }
        arg1 = pid * PROC_ARG_WORDS;
        i = 0;
        while (i < wlen) {
            arg2 = proc_args[arg1 + i];
            if ((arg2 & 0x00FF) == 0 || (arg2 >> 8) == 0) {
                i++;
                break;
            }
            i++;
        }
        noc_tx_word(ERR_OK);
        noc_tx_word(i);
        extra = 0;
        while (extra < i) {
            arg2 = proc_args[arg1 + extra];
            if ((extra + 1) == i && (arg2 & 0x00FF) != 0 && (arg2 >> 8) != 0) {
                arg2 = arg2 & 0x00FF;   // Guarantee NUL termination on truncation
            }
            noc_tx_word(arg2);
            extra++;
        }
        return;
    }

    if (id == SYS_STAT_GET) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        if (pid >= MAX_CORES) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
            return;
        }
        noc_tx_word(ERR_OK);
        noc_tx_word(11);
        noc_tx_word(stat_cache[pid].attr);
        noc_tx_word(stat_cache[pid].size_lo);
        noc_tx_word(stat_cache[pid].size_hi);
        i = 0;
        while (i < 8) {
            noc_tx_word(stat_cache[pid].name[i]);
            i++;
        }
        return;
    }

    if (id == SYS_GETCWD) {
        extra = noc_rx_word();
        wlen  = noc_rx_word();
        if (wlen == 0) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
            return;
        }
        if (wlen > SYS_BUF_WORDS) {
            wlen = SYS_BUF_WORDS;
        }
        if (fat32_getcwd_path(sys_buf, wlen << 1) != 0) {
            noc_tx_word(ERR_IO);
            noc_tx_word(0);
            return;
        }
        i = 0;
        while (i < wlen) {
            arg2 = sys_buf[i];
            if ((arg2 & 0x00FF) == 0 || (arg2 >> 8) == 0) {
                i++;
                break;
            }
            i++;
        }
        noc_tx_word(ERR_OK);
        noc_tx_word(i);
        extra = 0;
        while (extra < i) {
            noc_tx_word(sys_buf[extra]);
            extra++;
        }
        return;
    }

    // Unknown syscall: drain payload and return error
    drain_fifo(len);
    noc_tx_word(ERR_UNKNOWN);
    noc_tx_word(0);
}

// Arbitrate next pending worker doorbell round-robin, send "GO" grant, and dispatch
void noc_poll_syscalls(void) {
    u16 tries = 0;
    u16 pid   = 0;
    u16 bit   = 0;

    noc_drain_mbox();
    if (noc_req_mask == 0) {
        return;
    }
    while (tries < (MAX_CORES - 1)) {
        pid = noc_rr_cursor;
        noc_rr_cursor++;
        if (noc_rr_cursor >= MAX_CORES) {
            noc_rr_cursor = 1;
        }
        bit = 1 << pid;
        if ((noc_req_mask & bit) != 0) {
            noc_req_mask = noc_req_mask & (bit ^ 0xFFFF);
            if (procs[pid].state != PROC_FREE) {
                noc_dst_core = pid;
                noc_tx_word(CMD_SYS_GRANT);
                handle_syscall();
                proc_use_cwd(0);
            }
            return;
        }
        tries++;
    }
}

void main(void) {
    proc_init();

    uart_puts("\r\nMicroRISC4 OS v0.1 (Core 0)\r\n");
    if (fat32_mount() == 0) {
        proc_cwd_init_all();
        uart_puts("FAT32 mounted OK\r\n");
    } else {
        uart_puts("FAT32 mount skipped/failed\r\n");
    }
    shell_prompt();

    while (true) {
        noc_poll_syscalls();
        shell_poll();
        shell_script_step();
    }
}
