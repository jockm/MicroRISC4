0AFD        PUSH8   R0, >(_while_start_61)         ; [F8 09 F8 FC]
0AFD        PUSH8   R0, <(_while_start_61)         ; [F8 09 F8 FC]
0AFF        JMP     R0                             ; [F0]
0AFF    _while_exit_62:                            ; [00]
0B00        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0B00        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

