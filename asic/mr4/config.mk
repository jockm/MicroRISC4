# ==============================================================================
# FILE: asic/mr4/config.mk
# OpenROAD-flow-scripts (ORFS) Design Configuration for MiniRISC4 (`mr4_asic_top`)
#
# Usage (via repository Makefile — Docker default across Windows/macOS/Linux):
#   make asic-flow                               # nangate45 public-PDK dry run
#   make asic-flow ASIC_PLATFORM=asap7           # ASAP7 7nm predictive PDK
#   make asic-flow ASIC_PLATFORM=sky130hd        # SkyWater 130nm HD PDK
#
# Direct native ORFS invocation:
#   make -C "$ORFS_ROOT/flow" DESIGN_CONFIG="$PWD/asic/mr4/config.mk"
# ==============================================================================

MR4_ASIC_DIR := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
MR4_REPO_ROOT := $(abspath $(MR4_ASIC_DIR)/../..)

export DESIGN_NICKNAME = mr4_asic_top
export DESIGN_NAME     = mr4_asic_top
export PLATFORM       ?= nangate45

# SystemVerilog generated by `make generate-asic` (use ASIC_MEM_TARGET=flop for
# standalone public-PDK dry runs without external foundry SRAM macros).
export VERILOG_FILES   = $(MR4_REPO_ROOT)/build/asic/mr4_asic_top.sv
export SDC_FILE        = $(MR4_ASIC_DIR)/constraint.sdc

# Standard Yosys `read_verilog -sv` parses ROHD-generated SystemVerilog cleanly
# (verified by `make asic-check`). Uncomment to use Yosys-Slang instead:
# export SYNTH_HDL_FRONTEND ?= slang

# Allow the standalone 1024x16 (16,384-bit) flop-RAM dry run to synthesize into
# real standard-cell flip-flops (ORFS defaults SYNTH_MEMORY_MAX_BITS to 4096).
# For foundry tapeout, switch to ASIC_MEM_TARGET=sram with compiled SRAM macros
# (or pass SYNTH_MOCK_LARGE_MEMORIES=1 for a quick CPU+ROM+UART timing check).
ifeq ($(SYNTH_MOCK_LARGE_MEMORIES),1)
  # Mock memories > 4096 bits (replaces 1024x16 flop RAM so pure CpuCore+ROM+UART Fmax is measured)
  export SYNTH_MEMORY_MAX_BITS ?= 4096
else
  export SYNTH_MEMORY_MAX_BITS ?= 16384
endif

# Floorplan & placement density defaults (conservative for clean first-pass routing)
export CORE_UTILIZATION ?= 40
export CORE_ASPECT_RATIO ?= 1
export CORE_MARGIN      ?= 2
export PLACE_DENSITY_LB_ADDON ?= 0.15

# Platform-specific tuning
ifeq ($(PLATFORM),asap7)
  # ASAP7 uses picoseconds in ORFS (2000 ps = 500 MHz dry-run target; tighten as desired)
  export CLOCK_PERIOD ?= 2000
  export CORE_UTILIZATION = 35
else ifeq ($(PLATFORM),sky130hd)
  # SkyWater 130nm HD uses nanoseconds (20.0 ns = 50 MHz conservative starting point)
  export CLOCK_PERIOD ?= 20.0
  export CORE_UTILIZATION = 35
else ifeq ($(PLATFORM),ihp-sg13g2)
  export CLOCK_PERIOD ?= 20.0
  export CORE_UTILIZATION = 35
else
  # Nangate45 (and default ns-based PDKs): 10.0 ns = 100 MHz
  export CLOCK_PERIOD ?= 10.0
endif

# Optional foundry SRAM macro hooks (populate when switching ASIC_MEM_TARGET=sram
# with compiled foundry Liberty/LEF/GDS views for `mr4_sram_dp_*`).
ifdef MR4_SRAM_LEFS
  export ADDITIONAL_LEFS += $(MR4_SRAM_LEFS)
endif
ifdef MR4_SRAM_LIBS
  export ADDITIONAL_LIBS += $(MR4_SRAM_LIBS)
endif
ifdef MR4_SRAM_GDS
  export ADDITIONAL_GDS  += $(MR4_SRAM_GDS)
endif
