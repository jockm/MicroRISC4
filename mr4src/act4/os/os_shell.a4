// ==============================================================================
// FILE: mr4src/act4/os/os_shell.a4
// Non-Blocking Line Editor & Shell Commands
// ==============================================================================

const u16 LINE_MAX = 64;
u16 sh_line[32];        // 64 bytes packed
u16 sh_len = 0;

u16 sh_cmd[8];          // 16-byte command token
u16 sh_arg[16];         // 32-byte first argument token
u16 sh_arg_idx  = 0;    // Byte offset in sh_line where first arg starts
u16 sh_rest_idx = 0;    // Byte offset in sh_line after first arg
DirEntry sh_ent;

void shell_prompt(void) {
    uart_puts("mr4> ");
}

// Split sh_line into sh_cmd and sh_arg (separated by space)
void shell_tokenize(void) {
    u16 i = 0;
    u16 j = 0;
    u16 ch = 0;

    setbyte(sh_cmd, 0, 0);
    setbyte(sh_arg, 0, 0);

    // Skip leading spaces
    while (getbyte(sh_line, i) == 32) {
        i++;
    }

    // Copy command token
    while (j < 15) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(sh_cmd, j, ch);
        i++;
        j++;
    }
    setbyte(sh_cmd, j, 0);

    // Skip spaces before arg
    while (getbyte(sh_line, i) == 32) {
        i++;
    }
    sh_arg_idx = i;

    // Copy argument token
    j = 0;
    while (j < 31) {
        ch = getbyte(sh_line, i);
        if (ch == 0 || ch == 32) {
            break;
        }
        setbyte(sh_arg, j, ch);
        i++;
        j++;
    }
    setbyte(sh_arg, j, 0);

    // Skip spaces before remaining line payload (e.g. for "write <file> <text>")
    while (getbyte(sh_line, i) == 32) {
        i++;
    }
    sh_rest_idx = i;
}

void shell_cmd_ls(void) {
    u16 fd = fat32_opendir_root(0);
    if (fd == 0xFFFF) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    while (fat32_readdir(fd, &sh_ent) == 0) {
        if ((sh_ent.attr & 0x0010) != 0) {
            uart_puts("<DIR>  ");
        } else {
            uart_puts("       ");
        }
        uart_puts(sh_ent.name);
        uart_nl();
    }
    fat32_close(fd);
}

void shell_cmd_cat(void) {
    u16 wds    = 0;
    u16 nbytes = 0;
    u16 i      = 0;
    u16 ch     = 0;
    u16 prev   = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: cat <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }

    wds = fat32_read_file_root(sh_arg, run_img_buf, RUN_BUF_MAX);
    if (fat32_last_found == 0) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (wds == 0) {
        return;
    }

    nbytes = wds << 1;
    if (fat32_last_size_hi == 0 && fat32_last_size_lo < nbytes) {
        nbytes = fat32_last_size_lo;
    }

    while (i < nbytes) {
        ch = getbyte(run_img_buf, i);
        if (ch == 10 && prev != 13) {
            uart_putc(13);
        }
        uart_putc(ch);
        prev = ch;
        i++;
    }
    if (prev != 10) {
        uart_nl();
    }
}

void shell_cmd_rm(void) {
    u16 err = 0;
    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: rm <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_unlink_root(sh_arg);
    if (err == 0) {
        uart_puts("Removed ");
        uart_puts(sh_arg);
        uart_nl();
    } else if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
    } else {
        uart_puts("Failed to remove: ");
        uart_puts(sh_arg);
        uart_nl();
    }
}

void shell_cmd_write(void) {
    u16 fd = 0;
    u16 i  = sh_rest_idx;
    u16 o  = 0;
    u16 ch = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: write <file> <text>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }

    while (o < 62) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        setbyte(run_img_buf, o, ch);
        o++;
        i++;
    }
    setbyte(run_img_buf, o, 10);    // append '\n'
    o++;

    fd = fat32_open_write_root(0, sh_arg);
    if (fd == 0xFFFF) {
        uart_puts("Failed to create: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (fat32_write_bytes(fd, run_img_buf, o) != o) {
        fat32_close(fd);
        uart_puts("Write error: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    fat32_close(fd);
    uart_puts("Wrote ");
    uart_puts(sh_arg);
    uart_nl();
}

void shell_cmd_stat(void) {
    u16 err  = 0;
    u16 c_lo = 0;
    u16 c_hi = 0;

    if (getbyte(sh_arg, 0) == 0) {
        uart_puts("Usage: stat <file>\r\n");
        return;
    }
    if (fat_mounted == 0) {
        uart_puts("SD/FAT32 not mounted\r\n");
        return;
    }
    err = fat32_stat_root(sh_arg, &sh_ent);
    if (err == 2) {
        uart_puts("File not found: ");
        uart_puts(sh_arg);
        uart_nl();
        return;
    }
    if (err != 0) {
        uart_puts("stat failed\r\n");
        return;
    }
    c_lo = tmp32_lo;
    c_hi = tmp32_hi;
    uart_puts(sh_ent.name);
    uart_puts("  size=");
    if (sh_ent.size_hi != 0) {
        uart_puts("0x");
        uart_put_hex16(sh_ent.size_hi);
        uart_put_hex16(sh_ent.size_lo);
    } else {
        uart_put_dec16(sh_ent.size_lo);
    }
    uart_puts(" bytes  attr=0x");
    uart_put_hex16(sh_ent.attr);
    uart_puts("  clus=0x");
    if (c_hi != 0) {
        uart_put_hex16(c_hi);
    }
    uart_put_hex16(c_lo);
    uart_nl();
}

void shell_cmd_echo(void) {
    u16 i  = sh_arg_idx;
    u16 ch = 0;
    while (true) {
        ch = getbyte(sh_line, i);
        if (ch == 0) {
            break;
        }
        uart_putc(ch);
        i++;
    }
    uart_nl();
}

void shell_cmd_clear(void) {
    uart_putc(27);
    uart_puts("[2J");
    uart_putc(27);
    uart_puts("[H");
}

void shell_exec(void) {
    u16 pid = 0;
    u16 err = 0;

    shell_tokenize();
    if (getbyte(sh_cmd, 0) == 0) {
        return;
    }

    if (str_eq(sh_cmd, "help") == 1) {
        uart_puts("Commands: ps, run <file>, kill <pid>, ls, cat <file>, stat <file>, write <file> <text>, rm <file>, echo <text>, clear\r\n");
    } else if (str_eq(sh_cmd, "ps") == 1) {
        proc_print_ps();
    } else if (str_eq(sh_cmd, "kill") == 1) {
        pid = parse_u16(sh_arg);
        err = proc_kill(pid);
        if (err == 0) {
            uart_puts("Killed PID ");
            uart_putc(pid + 48);
            uart_nl();
        } else {
            uart_puts("kill failed\r\n");
        }
    } else if (str_eq(sh_cmd, "ls") == 1) {
        shell_cmd_ls();
    } else if (str_eq(sh_cmd, "run") == 1) {
        if (getbyte(sh_arg, 0) == 0) {
            uart_puts("Usage: run <file>\r\n");
        } else {
            err = fat32_read_file_root(sh_arg, run_img_buf, RUN_BUF_MAX);
            if (err == 0) {
                uart_puts("Failed to load file: ");
                uart_puts(sh_arg);
                uart_nl();
            } else {
                pid = proc_spawn_from_buf(sh_arg, run_img_buf, err);
                if (pid == 0) {
                    uart_puts("No free worker core\r\n");
                } else {
                    uart_puts("Spawned PID ");
                    uart_putc(pid + 48);
                    uart_puts(" (");
                    uart_put_hex16(err);
                    uart_puts(" words)\r\n");
                }
            }
        }
    } else if (str_eq(sh_cmd, "cat") == 1) {
        shell_cmd_cat();
    } else if (str_eq(sh_cmd, "rm") == 1) {
        shell_cmd_rm();
    } else if (str_eq(sh_cmd, "write") == 1) {
        shell_cmd_write();
    } else if (str_eq(sh_cmd, "stat") == 1) {
        shell_cmd_stat();
    } else if (str_eq(sh_cmd, "echo") == 1) {
        shell_cmd_echo();
    } else if (str_eq(sh_cmd, "clear") == 1) {
        shell_cmd_clear();
    } else {
        uart_puts("Unknown command: ");
        uart_puts(sh_cmd);
        uart_nl();
    }
}

void shell_poll(void) {
    u16 ch = uart_poll_getc();
    if (ch == 0xFFFF) {
        return;
    }

    if (ch == 13 || ch == 10) {
        setbyte(sh_line, sh_len, 0);
        uart_nl();
        shell_exec();
        sh_len = 0;
        shell_prompt();
    } else if (ch == 8 || ch == 127) {
        if (sh_len > 0) {
            sh_len--;
            uart_putc(8);
            uart_putc(32);
            uart_putc(8);
        }
    } else if (sh_len < (LINE_MAX - 1)) {
        setbyte(sh_line, sh_len, ch);
        sh_len++;
        uart_putc(ch);
    }
}
