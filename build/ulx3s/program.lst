0442        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0442        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0442        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0447        XOR     R1, R1              ; R1 = accumulator = 0 ; [95]

        .parse_digit:
0448        LD      R2, (R3)                       ; [2B]
0448        LD      R2, R2                         ; [0A BC 00 F8 00 F8 FF A8 BC]
0448        XCHG    R0                             ; [0A BC 00 F8 00 F8 FF A8 BC]
0448        PUSH8   R0, >(0x00FF)                  ; [0A BC 00 F8 00 F8 FF A8 BC]
0448        PUSH8   R0, <(0x00FF)                  ; [0A BC 00 F8 00 F8 FF A8 BC]
0448        AND     R2, R0                         ; [0A BC 00 F8 00 F8 FF A8 BC]
0448        XCHG    R0                             ; [0A BC 00 F8 00 F8 FF A8 BC]

    ; Check if char < '0' (48)
044D        PUSH8   R0, >(48)                      ; [F8 00 F8 30]
044D        PUSH8   R0, <(48)                      ; [F8 00 F8 30]
044F        SUB     R2, R0              ; R2 = char - 48 ; [78]
044F        PUSH8   R0, >(.parse_done)             ; [00 F8 04 F8 8B]
044F        PUSH8   R0, <(.parse_done)             ; [00 F8 04 F8 8B]
0452        JMP.M   R0, R2              ; If R2 < 0, done ; [E2]

    ; Check if char <= '9' (i.e. R2 <= 9)
0452        PUSH8   R0, >(9)                       ; [00 F8 00 F8 09]
0452        PUSH8   R0, <(9)                       ; [00 F8 00 F8 09]
0455        SUB     R0, R2              ; R0 = 9 - R2 ; [72]
0455        XCHG    R1                  ; shadow_r[1] = acc, R1 is free for target ; [BD]
0456        PUSH8   R1, >(.check_upper)            ; [F9 04 F9 5F]
0456        PUSH8   R1, <(.check_upper)            ; [F9 04 F9 5F]
0458        JMP.M   R1, R0              ; If 9 - R2 < 0, jump to .check_upper ; [E4]
0458        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_num:
0459        SHIFT.L R1                             ; [B1]
0459        SHIFT.L R1                             ; [B1]
045A        SHIFT.L R1                             ; [B1]
045A        SHIFT.L R1                             ; [B1]
045B        ADD     R1, R2                         ; [66]
045B        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
045C        PUSH8   R0, >(.parse_digit)            ; [F8 04 F8 48]
045C        PUSH8   R0, <(.parse_digit)            ; [F8 04 F8 48]
045E        JMP     R0                             ; [F0]

045E    .check_upper:                              ; [00]
045F        XCHG    R1                  ; Restore R1 = acc ; [BD]
    ; 'A' is 65 - 48 = 17
045F        PUSH8   R0, >(17)                      ; [00 F8 00 F8 11]
045F        PUSH8   R0, <(17)                      ; [00 F8 00 F8 11]
0462        SUB     R2, R0              ; R2 = char - 'A' ; [78]
0462        PUSH8   R0, >(.parse_done)             ; [00 F8 04 F8 8B]
0462        PUSH8   R0, <(.parse_done)             ; [00 F8 04 F8 8B]
0465        JMP.M   R0, R2              ; If char < 'A', done ; [E2]

    ; 'F' is 5. Check if R2 <= 5
0465        PUSH8   R0, >(5)                       ; [00 F8 00 F8 05]
0465        PUSH8   R0, <(5)                       ; [00 F8 00 F8 05]
0468        SUB     R0, R2              ; R0 = 5 - R2 ; [72]
0468        XCHG    R1                  ; shadow_r[1] = acc ; [BD]
0469        PUSH8   R1, >(.check_lower)            ; [F9 04 F9 75]
0469        PUSH8   R1, <(.check_lower)            ; [F9 04 F9 75]
046B        JMP.M   R1, R0              ; If 5 - R2 < 0, jump to .check_lower ; [E4]
046B        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_upper:
046C        SHIFT.L R1                             ; [B1]
046C        SHIFT.L R1                             ; [B1]
046D        SHIFT.L R1                             ; [B1]
046D        SHIFT.L R1                             ; [B1]
046E        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
046E        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
0470        ADD     R2, R0              ; R2 = digit value (10..15) ; [68]
0470        ADD     R1, R2                         ; [66]
0471        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
0471        PUSH8   R0, >(.parse_digit)            ; [00 F8 04 F8 48]
0471        PUSH8   R0, <(.parse_digit)            ; [00 F8 04 F8 48]
0474        JMP     R0                             ; [F0]

0474    .check_lower:                              ; [00]
0475        XCHG    R1                  ; Restore R1 = acc ; [BD]
    ; 'a' is 97 - 65 = 32
0475        PUSH8   R0, >(32)                      ; [00 F8 00 F8 20]
0475        PUSH8   R0, <(32)                      ; [00 F8 00 F8 20]
0478        SUB     R2, R0              ; R2 = char - 'a' ; [78]
0478        PUSH8   R0, >(.parse_done)             ; [00 F8 04 F8 8B]
0478        PUSH8   R0, <(.parse_done)             ; [00 F8 04 F8 8B]
047B        JMP.M   R0, R2              ; If char < 'a', done ; [E2]

    ; 'f' is 5. Check if R2 <= 5
047B        PUSH8   R0, >(5)                       ; [00 F8 00 F8 05]
047B        PUSH8   R0, <(5)                       ; [00 F8 00 F8 05]
047E        SUB     R0, R2              ; R0 = 5 - R2 ; [72]
047E        XCHG    R1                             ; [BD]
047F        PUSH8   R1, >(.parse_done)             ; [F9 04 F9 8B]
047F        PUSH8   R1, <(.parse_done)             ; [F9 04 F9 8B]
0481        JMP.M   R1, R0              ; If 5 - R2 < 0, invalid hex char -> done ; [E4]
0481        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_lower:
0482        SHIFT.L R1                             ; [B1]
0482        SHIFT.L R1                             ; [B1]
0483        SHIFT.L R1                             ; [B1]
0483        SHIFT.L R1                             ; [B1]
0484        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
0484        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
0486        ADD     R2, R0                         ; [68]
0486        ADD     R1, R2                         ; [66]
0487        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
0487        PUSH8   R0, >(.parse_digit)            ; [00 F8 04 F8 48]
0487        PUSH8   R0, <(.parse_digit)            ; [00 F8 04 F8 48]
048A        JMP     R0                             ; [F0]

048A    .parse_done:                               ; [00]
048B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
048B        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SECTION 7: Static Messages & Buffers
; ==============================================================================
        .align                          ; Guarantees word boundary for Slot 0 packing

        msg_banner:
0491        .asciz "\r\n============================\r\n  MiniRISC4 ASM Monitor\r\n  Commands:\r\n    e <addr>      (Examine)\r\n    c <addr> <val>(Change)\r\n    g <addr>      (Go / Run)\r\n============================\r\n" ; [0D 0A 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 0D 0A 20 20 4D 69 6E 69 52 49 53 43 34 20 41 53 4D 20 4D 6F 6E 69 74 6F 72 0D 0A 20 20 43 6F 6D 6D 61 6E 64 73 3A 0D 0A 20 20 20 20 65 20 3C 61 64 64 72 3E 20 20 20 20 20 20 28 45 78 61 6D 69 6E 65 29 0D 0A 20 20 20 20 63 20 3C 61 64 64 72 3E 20 3C 76 61 6C 3E 28 43 68 61 6E 67 65 29 0D 0A 20 20 20 20 67 20 3C 61 64 64 72 3E 20 20 20 20 20 20 28 47 6F 20 2F 20 52 75 6E 29 0D 0A 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 0D 0A 00]

        msg_prompt:
04EF        .asciz "> "                            ; [3E 20 00]

04F0    msg_colon:                                 ; [00]
04F1        .asciz ": "                            ; [3A 20 00]

04F2    msg_unknown:                               ; [00]
04F3        .asciz "Unknown command. Use 'e <addr>', 'c <addr> <val>', or 'g <addr>'\r\n" ; [55 6E 6B 6E 6F 77 6E 20 63 6F 6D 6D 61 6E 64 2E 20 55 73 65 20 27 65 20 3C 61 64 64 72 3E 27 2C 20 27 63 20 3C 61 64 64 72 3E 20 3C 76 61 6C 3E 27 2C 20 6F 72 20 27 67 20 3C 61 64 64 72 3E 27 0D 0A 00]

0514    msg_wrote:                                 ; [00]
0515        .asciz "Wrote "                        ; [57 72 6F 74 65 20 00]

0518    msg_to:                                    ; [00]
