0528    msg_returned:                              ; [00]
0529        .asciz "\r\n[Program returned to monitor]\r\n" ; [0D 0A 5B 50 72 6F 67 72 61 6D 20 72 65 74 75 72 6E 65 64 20 74 6F 20 6D 6F 6E 69 74 6F 72 5D 0D 0A 00]

        next_examine_addr:
053A        .word 0x0000                           ; [00 00]

        dump_ptr:
053B        .word 0x0000                           ; [00 00]

        dump_cnt:
053C        .word 0x0000                           ; [00 00]

        line_buffer:
053D        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
0545        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
054D        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
0555        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]

; ==============================================================================
; Runtime Library Inclusion at the Bottom
; ==============================================================================
; ==============================================================================
; FILE: lib/M4R_LIB.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Math & Relational Runtime Subroutine Library for MiniRISC4.
;   Provides 16-bit unsigned multiplication (MULT), restoring integer division (DIV),
;   modulo/remainder (MOD), and unsigned relational comparisons (_CMP_*).
;
; Table of Contents:
;   1. SUBROUTINE: MULT        - 16-bit unsigned binary multiplication
;   2. HELPER:     DIVMOD_CORE - 16-bit binary restoring division engine
;   3. SUBROUTINE: DIV         - 16-bit unsigned integer division
;   4. SUBROUTINE: MOD         - 16-bit unsigned integer remainder / modulo
;   5. RELATIONAL: _CMP_LT     - Unsigned Less-Than comparison (<)
;   6. RELATIONAL: _CMP_LE     - Unsigned Less-Than-or-Equal comparison (<=)
;   7. RELATIONAL: _CMP_GT     - Unsigned Greater-Than comparison (>)
;   8. RELATIONAL: _CMP_GE     - Unsigned Greater-Than-or-Equal comparison (>=)
;
; Calling Conventions & Stack Rules:
;   - Argument Stack (ASP @ 0x0005, Base 0xFAFF):
;       Math routines (MULT, DIV, MOD) receive operands on the Argument Stack.
;       Binary operands (A op B):
;         Top of Stack (first popped)  : Operand B (RHS / Multiplier / Divisor)
;         Second on Stack (next popped): Operand A (LHS / Multiplicand / Dividend)
;       Result is pushed back onto the Argument Stack and returned in R1.
;   - Return Stack (RSP @ 0x0004, Base 0xFEFF):
;       All routines preserve caller return linkage on the Return Stack via
;       RPUSH R0 upon entry, returning via RRET (RPOP R0; JMP R0).
;   - Comparison Helpers (_CMP_*):
;       Operands passed in primary registers: R1 = LHS (A), R2 = RHS (B).
;       Boolean result returned in R1 (1 = True, 0 = False).
;   - Register-Indirect Branching:
;       All branches (JMP, JMP.Z, JMP.M, LINK) are strictly register-indirect.
;       Target addresses are pre-loaded into registers via LOAD16 prior to branching.
; ==============================================================================


; ==============================================================================
; SECTION 1: 16-Bit Binary Multiplication (MULT)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MULT
; Description:
;   Performs 16-bit unsigned multiplication: Product = A * B (modulo 65536).
;   Uses the classic shift-and-add binary multiplication algorithm with an
;   explicit 16-step iteration counter.
;
; Algorithm:
;   1. Pop Multiplier (B) into R2 and Multiplicand (A) into R1 from ASP.
;   2. Clear product accumulator (R3 = 0).
;   3. For each of the 16 bits:
;      a. Test LSB of Multiplier by rotating right (ROT.R R2) into bit 15 (sign bit).
;      b. If bit 15 is 1, jump to _MULT_ADD to add Multiplicand to Accumulator.
;      c. Restore Multiplier bit alignment (ROT.L R2), shift Multiplier right by 1,
;         and shift Multiplicand left by 1.
;      d. Decrement loop counter. Exit early if Multiplier reaches 0.
;   4. Return 16-bit product in R1 and push onto ASP.
;
; Stack Layout:
;   Entry: [ASP]   = Multiplier (B)
;          [ASP+1] = Multiplicand (A)
;   Exit:  [ASP]   = Product (A * B & 0xFFFF)
;
; Registers:
;   R1 = Multiplicand (A) -> Product output
;   R2 = Multiplier (B)
;   R3 = Product Accumulator (caller R3 preserved in shadow_r[3])
;   shadow_r[0] = 16-step loop counter
; ==============================================================================
        MULT:
055D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
055D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Pop operands from Argument Stack (0x0005)
0562        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0562        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0568        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0568        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]

    ; Free R3 to act as product accumulator; preserve caller R3 in hardware shadow
056D        XCHG    R3                  ; shadow_r[3] = caller R3 ; [BF]
056E        XOR     R3, R3                         ; [9F]

    ; Initialize 16-iteration loop counter in shadow_r[0]
056E        XCHG    R0                  ; shadow_r[0] = caller R0 ; [BC]
056F        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
056F        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
0571        XCHG    R0                  ; R0 restored; shadow_r[0] = 16 ; [BC]

0571    _MULT_LOOP:                                ; [00]
    ; Optimization: check if remaining Multiplier bits are zero -> exit early
0572        PUSH8   R0, >(_MULT_DONE)              ; [F8 05 F8 86]
0572        PUSH8   R0, <(_MULT_DONE)              ; [F8 05 F8 86]
0574        JMP.Z   R0, R2              ; If R2 == 0, multiplication complete ; [D2]

    ; Test LSB (bit 0) of Multiplier: rotate right shifts bit 0 into bit 15 (sign bit)
0574        ROT.R   R2                             ; [C6]
0575        PUSH8   R0, >(_MULT_ADD)               ; [F8 05 F8 7C]
0575        PUSH8   R0, <(_MULT_ADD)               ; [F8 05 F8 7C]
0577        JMP.M   R0, R2              ; If bit 15 is 1 (negative), bit 0 was set -> add ; [E2]

    ; Bit 0 was 0: no addition, proceed with bit shifts
0577        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0578        SHIFT.R R2                  ; Multiplier >>= 1 (logical right shift) ; [B6]
0578        SHIFT.L R1                  ; Multiplicand <<= 1 (logical left shift) ; [B1]
0579        PUSH8   R0, >(_MULT_DEC)               ; [F8 05 F8 7E]
0579        PUSH8   R0, <(_MULT_DEC)               ; [F8 05 F8 7E]
057B        JMP     R0                  ; Decrement iteration counter ; [F0]

057B    _MULT_ADD:                                 ; [00]
057C        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
057C        ADD     R3, R1              ; Accumulator += Multiplicand ; [6D]
057D        SHIFT.R R2                  ; Multiplier >>= 1 ; [B6]
057D        SHIFT.L R1                  ; Multiplicand <<= 1 ; [B1]

        _MULT_DEC:
057E        XCHG    R0                  ; Access loop counter from shadow_r[0] ; [BC]
057E        DEC     R0                  ; counter-- ; [CC]
057F        PUSH8   R1, >(_MULT_DONE_CTR)          ; [F9 05 F9 85]
057F        PUSH8   R1, <(_MULT_DONE_CTR)          ; [F9 05 F9 85]
0581        JMP.Z   R1, R0              ; If counter == 0, loop finished ; [D4]
0581        XCHG    R0                  ; Save updated counter back to shadow_r[0] ; [BC]

0582        PUSH8   R0, >(_MULT_LOOP)              ; [F8 05 F8 72]
0582        PUSH8   R0, <(_MULT_LOOP)              ; [F8 05 F8 72]
0584        JMP     R0                             ; [F0]

0584    _MULT_DONE_CTR:                            ; [00]
0585        XCHG    R0                  ; Restore shadow_r[0] / caller R0 ; [BC]

0585    _MULT_DONE:                                ; [00]
0586        LD      R1, R3              ; R1 = Final 16-bit Product ; [07]
0586        XCHG    R3                  ; Restore caller R3 from shadow_r[3] ; [BF]
0587        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0587        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
058C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
058C        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 2: 16-Bit Restoring Division Engine (DIVMOD_CORE)
; ==============================================================================

; ==============================================================================
; HELPER: DIVMOD_CORE
; Description:
;   Core 16-bit unsigned restoring division routine.
;   Computes both quotient and remainder simultaneously using shift-and-subtract.
;
; Inputs:
;   R1 = Dividend (N)
;   R2 = Divisor (D)
; Outputs:
;   R1 = Quotient (N / D)
;   R3 = Remainder (N % D)
;
; Special Cases:
;   Division by Zero: If D == 0, returns Quotient = 0xFFFF, Remainder = Dividend (N).
;
; Registers:
;   R1 = Dividend (shifts left; quotient bits shifted into LSB) -> returns Quotient
;   R2 = Divisor (preserved in shadow_r[2] during loop)
;   R3 = Remainder accumulator -> returns Remainder
;   shadow_r[0] = 16-iteration loop counter
; ==============================================================================
0592    DIVMOD_CORE:                               ; [00]
0593        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0593        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Check for divide-by-zero condition (Divisor R2 == 0)
0598        PUSH8   R0, >(_DIV_ZERO)               ; [00 F8 05 F8 C5]
0598        PUSH8   R0, <(_DIV_ZERO)               ; [00 F8 05 F8 C5]
059B        JMP.Z   R0, R2              ; If R2 == 0, branch to error handler ; [D2]

059B        XOR     R3, R3                         ; [9F]

    ; Preserve Divisor in shadow_r[2] so R2 is available for branch scratch
059C        XCHG    R2                             ; [BE]

    ; Initialize 16-bit loop counter in shadow_r[0]
059C        XCHG    R0                             ; [BC]
059D        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
059D        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
059F        XCHG    R0                             ; [BC]

059F    _DIV_BIT_LOOP:                             ; [00]
05A0        SHIFT.L R3                  ; Remainder <<= 1 ; [B3]

    ; Shift MSB of Dividend into LSB of Remainder
05A0        PUSH8   R2, >(_DIV_CARRY_IN)           ; [00 FA 05 FA A7]
05A0        PUSH8   R2, <(_DIV_CARRY_IN)           ; [00 FA 05 FA A7]
05A3        JMP.M   R2, R1              ; Test bit 15 (MSB) of Dividend ; [E9]

05A3        PUSH8   R2, >(_DIV_SHIFT_CONT)         ; [00 FA 05 FA A8]
05A3        PUSH8   R2, <(_DIV_SHIFT_CONT)         ; [00 FA 05 FA A8]
05A6        JMP     R2                             ; [F2]

05A6    _DIV_CARRY_IN:                             ; [00]
05A7        INC     R3                  ; Remainder |= 1 (MSB shifted out of Dividend was 1) ; [CB]

05A7    _DIV_SHIFT_CONT:                           ; [00]
05A8        SHIFT.L R1                  ; Dividend <<= 1 (shifts quotient bit into LSB) ; [B1]

    ; Compare current Remainder (R3) with Divisor (held in shadow_r[2])
05A8        XCHG    R2                  ; R2 = Divisor, shadow_r[2] = scratch ; [BE]
05A9        XCHG    R0                  ; R0 = loop counter, shadow_r[0] = scratch ; [BC]
05A9        XCHG    R0                  ; Restore R0 ; [BC]

    ; Compute test trial subtraction: difference = Remainder - Divisor
05AA        XCHG    R0                             ; [BC]
05AA        LD      R0, R3                         ; [03]
05AB        SUB     R0, R2              ; R0 = Remainder - Divisor ; [72]
05AB        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Check if trial subtraction produced a negative result
05AC        XCHG    R0                  ; R0 = difference ; [BC]
05AC        PUSH8   R2, >(_DIV_NO_SUB)             ; [00 FA 05 FA B5]
05AC        PUSH8   R2, <(_DIV_NO_SUB)             ; [00 FA 05 FA B5]
05AF        JMP.M   R2, R0              ; If negative, cannot subtract -> skip ; [E8]
05AF        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Successful subtraction: Remainder gets difference, Quotient LSB = 1
05B0        XCHG    R0                             ; [BC]
05B0        LD      R3, R0              ; Remainder = difference (subtraction committed) ; [0C]
05B1        XCHG    R0                             ; [BC]
05B1        INC     R1                  ; Quotient LSB = 1 ; [C9]

05B2        PUSH8   R2, >(_DIV_DEC_LOOP)           ; [FA 05 FA B6]
05B2        PUSH8   R2, <(_DIV_DEC_LOOP)           ; [FA 05 FA B6]
05B4        JMP     R2                             ; [F2]

05B4    _DIV_NO_SUB:                               ; [00]
05B5        XCHG    R0                  ; Restore R0 ; [BC]

05B5    _DIV_DEC_LOOP:                             ; [00]
05B6        XCHG    R2                  ; Restore Divisor back into shadow_r[2] ; [BE]
05B6        XCHG    R0                  ; Access loop counter ; [BC]
05B7        DEC     R0                  ; counter-- ; [CC]
05B7        PUSH8   R2, >(_DIV_EXIT)               ; [00 FA 05 FA BE]
05B7        PUSH8   R2, <(_DIV_EXIT)               ; [00 FA 05 FA BE]
05BA        JMP.Z   R2, R0              ; If counter == 0, division complete ; [D8]
05BA        XCHG    R0                  ; Save counter back to shadow_r[0] ; [BC]

05BB        PUSH8   R0, >(_DIV_BIT_LOOP)           ; [F8 05 F8 A0]
05BB        PUSH8   R0, <(_DIV_BIT_LOOP)           ; [F8 05 F8 A0]
05BD        JMP     R0                             ; [F0]

05BD    _DIV_EXIT:                                 ; [00]
05BE        XCHG    R0                  ; Restore original R0 ; [BC]
05BE        XCHG    R2                  ; Restore original R2 (Divisor) ; [BE]
05BF        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05BF        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _DIV_ZERO:
    ; Divide by zero: Remainder = original Dividend, Quotient = 0xFFFF
05C5        LD      R3, R1              ; Remainder = Dividend ; [0D]
05C5        XOR     R1, R1                         ; [95]
05C6        DEC     R1                  ; R1 = 0xFFFF (standard unsigned error quotient) ; [CD]
05C6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05C6        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 3: 16-Bit Unsigned Integer Division (DIV)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: DIV
; Description:
;   16-bit unsigned integer division: Quotient = Dividend / Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Quotient (N / D)
; Register : R1 = Quotient
; ==============================================================================
05CC    DIV:                                       ; [00]
05CD        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05CD        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05D2        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D2        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05D8        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05D8        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05DD        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 05 F8 93 F4 00]
05DD        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 05 F8 93 F4 00]
05DD        LINK    R0, R0                         ; [00 F8 05 F8 93 F4 00]
05E1        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E1        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
05E6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
05E6        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 4: 16-Bit Unsigned Integer Modulo (MOD)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MOD
; Description:
;   16-bit unsigned integer remainder: Remainder = Dividend % Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Remainder (N % D)
; Register : R1 = Remainder
; ==============================================================================
05EC    MOD:                                       ; [00]
05ED        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05ED        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
05F2        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F2        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
05F8        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05F8        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
05FD        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 05 F8 93 F4 00]
05FD        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 05 F8 93 F4 00]
05FD        LINK    R0, R0                         ; [00 F8 05 F8 93 F4 00]
0601        LD      R1, R3              ; Move Remainder to return register R1 ; [07]
0601        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0601        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0607        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0607        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 5: Unsigned Relational Comparisons (_CMP_LT, _CMP_LE, _CMP_GT, _CMP_GE)
; Description:
;   Evaluates 16-bit unsigned inequalities across the entire 0x0000-0xFFFF range.
;   Because MiniRISC4 only supports JMP.M (sign bit is 1) and JMP.Z (zero) on
;   register contents, unsigned comparison must differentiate between numbers
;   with differing MSBs (where bit 15 represents the 0x8000 boundary) and numbers
;   with identical MSBs (where standard subtraction gives the correct magnitude).
;
; Inputs:
;   R1 = Left-Hand Side (LHS / A)
;   R2 = Right-Hand Side (RHS / B)
; Outputs:
;   R1 = 1 if the condition is True
;   R1 = 0 if the condition is False
; ==============================================================================

; ==============================================================================
; SUBROUTINE: _CMP_LT  (Unsigned Less-Than: A < B)
; ==============================================================================
        _CMP_LT:
060D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
060D        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Compare MSBs (bit 15) using XOR
0612        XCHG    R0                             ; [BC]
0613        LD      R0, R1                         ; [01]
0613        XOR     R0, R2              ; If bit 15 is set, operands have opposite signs ; [92]
0614        PUSH8   R3, >(_CMP_LT_DIFF_SIGNS)      ; [FB 06 FB 1E]
0614        PUSH8   R3, <(_CMP_LT_DIFF_SIGNS)      ; [FB 06 FB 1E]
0616        JMP.M   R3, R0              ; Branch if MSBs are different ; [EC]
0616        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: MSBs are identical -> standard subtraction A - B gives correct relation
0617        SUB     R1, R2              ; R1 = A - B ; [76]
0617        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 06 F8 61]
0617        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 06 F8 61]
061A        JMP.M   R0, R1              ; If difference is negative, A < B -> True ; [E1]
061A        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 06 F8 69]
061A        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 06 F8 69]
061D        JMP     R0                  ; Else A >= B -> False ; [F0]

061D    _CMP_LT_DIFF_SIGNS:                        ; [00]
061E        XCHG    R0                  ; Restore R0 ; [BC]
    ; When MSBs differ: the operand with MSB=1 is in range [0x8000..0xFFFF],
    ; while the operand with MSB=0 is in range [0x0000..0x7FFF].
    ; Therefore, if LHS (R1) has bit 15 set, LHS is strictly larger -> False.
061E        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 06 F8 69]
061E        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 06 F8 69]
0621        JMP.M   R0, R1              ; If R1[15] == 1, A > B -> False ; [E1]
0621        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 06 F8 61]
0621        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 06 F8 61]
0624        JMP     R0                  ; Else A < B -> True ; [F0]

; ==============================================================================
; SUBROUTINE: _CMP_LE  (Unsigned Less-Than-or-Equal: A <= B)
; ==============================================================================
0624    _CMP_LE:                                   ; [00]
0625        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0625        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Check equality (A == B)
062A        XCHG    R0                             ; [BC]
062B        LD      R0, R1                         ; [01]
062B        SUB     R0, R2              ; Test difference A - B ; [72]
062C        PUSH8   R3, >(_CMP_LE_EQUAL)           ; [FB 06 FB 38]
062C        PUSH8   R3, <(_CMP_LE_EQUAL)           ; [FB 06 FB 38]
062E        JMP.Z   R3, R0              ; If A == B, branch to True ; [DC]
062E        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: Not equal -> evaluate A < B
062F        PUSH8   R0, >(_CMP_LT)                 ; [F8 06 F8 0D F4 00]
062F        PUSH8   R0, <(_CMP_LT)                 ; [F8 06 F8 0D F4 00]
062F        LINK    R0, R0                         ; [F8 06 F8 0D F4 00]
0632        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0632        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _CMP_LE_EQUAL:
0638        XCHG    R0                  ; Restore R0 ; [BC]
0638        PUSH8   R1, >(1)                       ; [00 F9 00 F9 01]
0638        PUSH8   R1, <(1)                       ; [00 F9 00 F9 01]
063B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
063B        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SUBROUTINE: _CMP_GT  (Unsigned Greater-Than: A > B)
; Note: A > B is logically equivalent to B < A
; ==============================================================================
        _CMP_GT:
0641        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0641        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
