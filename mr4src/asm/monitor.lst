; SUBROUTINE: skip_spaces
; Inputs/Outputs: R3 = pointer into buffer
; ------------------------------------------------------------------------------
        skip_spaces:
032A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
032A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
032A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
