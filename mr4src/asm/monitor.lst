        .parse_digit:
0351        LD      R2, (R3)                       ; [2B]
0351        LD      R2, R2                         ; [0A BC 00 F8 00 F8 FF A8 BC]
0351        XCHG    R0                             ; [0A BC 00 F8 00 F8 FF A8 BC]
0351        PUSH8   R0, >(0x00FF)                  ; [0A BC 00 F8 00 F8 FF A8 BC]
0351        PUSH8   R0, <(0x00FF)                  ; [0A BC 00 F8 00 F8 FF A8 BC]
0351        AND     R2, R0                         ; [0A BC 00 F8 00 F8 FF A8 BC]
0351        XCHG    R0                             ; [0A BC 00 F8 00 F8 FF A8 BC]

    ; Check if char < '0' (48)
0356        PUSH8   R0, >(48)                      ; [F8 00 F8 30]
0356        PUSH8   R0, <(48)                      ; [F8 00 F8 30]
0358        SUB     R2, R0              ; R2 = char - 48 ; [78]
0358        PUSH8   R0, >(.parse_done)             ; [00 F8 03 F8 94]
0358        PUSH8   R0, <(.parse_done)             ; [00 F8 03 F8 94]
035B        JMP.M   R0, R2              ; If R2 < 0, done ; [E2]

    ; Check if char <= '9' (i.e. R2 <= 9)
035B        PUSH8   R0, >(9)                       ; [00 F8 00 F8 09]
035B        PUSH8   R0, <(9)                       ; [00 F8 00 F8 09]
035E        SUB     R0, R2              ; R0 = 9 - R2 ; [72]
035E        XCHG    R1                  ; shadow_r[1] = acc, R1 is free for target ; [BD]
035F        PUSH8   R1, >(.check_upper)            ; [F9 03 F9 68]
035F        PUSH8   R1, <(.check_upper)            ; [F9 03 F9 68]
0361        JMP.M   R1, R0              ; If 9 - R2 < 0, jump to .check_upper ; [E4]
0361        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_num:
0362        SHIFT.L R1                             ; [B1]
0362        SHIFT.L R1                             ; [B1]
0363        SHIFT.L R1                             ; [B1]
0363        SHIFT.L R1                             ; [B1]
0364        ADD     R1, R2                         ; [66]
0364        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
0365        PUSH8   R0, >(.parse_digit)            ; [F8 03 F8 51]
0365        PUSH8   R0, <(.parse_digit)            ; [F8 03 F8 51]
0367        JMP     R0                             ; [F0]

0367    .check_upper:                              ; [00]
0368        XCHG    R1                  ; Restore R1 = acc ; [BD]
    ; 'A' is 65 - 48 = 17
0368        PUSH8   R0, >(17)                      ; [00 F8 00 F8 11]
0368        PUSH8   R0, <(17)                      ; [00 F8 00 F8 11]
036B        SUB     R2, R0              ; R2 = char - 'A' ; [78]
036B        PUSH8   R0, >(.parse_done)             ; [00 F8 03 F8 94]
036B        PUSH8   R0, <(.parse_done)             ; [00 F8 03 F8 94]
036E        JMP.M   R0, R2              ; If char < 'A', done ; [E2]

    ; 'F' is 5. Check if R2 <= 5
036E        PUSH8   R0, >(5)                       ; [00 F8 00 F8 05]
036E        PUSH8   R0, <(5)                       ; [00 F8 00 F8 05]
0371        SUB     R0, R2              ; R0 = 5 - R2 ; [72]
0371        XCHG    R1                  ; shadow_r[1] = acc ; [BD]
0372        PUSH8   R1, >(.check_lower)            ; [F9 03 F9 7E]
0372        PUSH8   R1, <(.check_lower)            ; [F9 03 F9 7E]
0374        JMP.M   R1, R0              ; If 5 - R2 < 0, jump to .check_lower ; [E4]
0374        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_upper:
0375        SHIFT.L R1                             ; [B1]
0375        SHIFT.L R1                             ; [B1]
0376        SHIFT.L R1                             ; [B1]
0376        SHIFT.L R1                             ; [B1]
0377        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
0377        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
0379        ADD     R2, R0              ; R2 = digit value (10..15) ; [68]
0379        ADD     R1, R2                         ; [66]
037A        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
037A        PUSH8   R0, >(.parse_digit)            ; [00 F8 03 F8 51]
037A        PUSH8   R0, <(.parse_digit)            ; [00 F8 03 F8 51]
037D        JMP     R0                             ; [F0]

037D    .check_lower:                              ; [00]
037E        XCHG    R1                  ; Restore R1 = acc ; [BD]
    ; 'a' is 97 - 65 = 32
037E        PUSH8   R0, >(32)                      ; [00 F8 00 F8 20]
037E        PUSH8   R0, <(32)                      ; [00 F8 00 F8 20]
0381        SUB     R2, R0              ; R2 = char - 'a' ; [78]
0381        PUSH8   R0, >(.parse_done)             ; [00 F8 03 F8 94]
0381        PUSH8   R0, <(.parse_done)             ; [00 F8 03 F8 94]
0384        JMP.M   R0, R2              ; If char < 'a', done ; [E2]

    ; 'f' is 5. Check if R2 <= 5
0384        PUSH8   R0, >(5)                       ; [00 F8 00 F8 05]
0384        PUSH8   R0, <(5)                       ; [00 F8 00 F8 05]
0387        SUB     R0, R2              ; R0 = 5 - R2 ; [72]
0387        XCHG    R1                             ; [BD]
0388        PUSH8   R1, >(.parse_done)             ; [F9 03 F9 94]
0388        PUSH8   R1, <(.parse_done)             ; [F9 03 F9 94]
038A        JMP.M   R1, R0              ; If 5 - R2 < 0, invalid hex char -> done ; [E4]
038A        XCHG    R1                  ; Restore R1 = acc ; [BD]

        .is_lower:
038B        SHIFT.L R1                             ; [B1]
038B        SHIFT.L R1                             ; [B1]
038C        SHIFT.L R1                             ; [B1]
038C        SHIFT.L R1                             ; [B1]
038D        PUSH8   R0, >(10)                      ; [F8 00 F8 0A]
038D        PUSH8   R0, <(10)                      ; [F8 00 F8 0A]
038F        ADD     R2, R0                         ; [68]
038F        ADD     R1, R2                         ; [66]
0390        INC     R3                  ; Advance string pointer (R3 preserved) ; [CB]
0390        PUSH8   R0, >(.parse_digit)            ; [00 F8 03 F8 51]
0390        PUSH8   R0, <(.parse_digit)            ; [00 F8 03 F8 51]
0393        JMP     R0                             ; [F0]

0393    .parse_done:                               ; [00]
0394        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0394        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SECTION 7: Static Messages & Buffers
; ==============================================================================
        .align                          ; Guarantees word boundary for Slot 0 packing

        msg_banner:
039A        .asciz "\r\n============================\r\n  MiniRISC4 ASM Monitor\r\n  Commands:\r\n    e <addr>      (Examine)\r\n    c <addr> <val>(Change)\r\n    g <addr>      (Go / Run)\r\n============================\r\n" ; [0D 0A 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 0D 0A 20 20 4D 69 6E 69 52 49 53 43 34 20 41 53 4D 20 4D 6F 6E 69 74 6F 72 0D 0A 20 20 43 6F 6D 6D 61 6E 64 73 3A 0D 0A 20 20 20 20 65 20 3C 61 64 64 72 3E 20 20 20 20 20 20 28 45 78 61 6D 69 6E 65 29 0D 0A 20 20 20 20 63 20 3C 61 64 64 72 3E 20 3C 76 61 6C 3E 28 43 68 61 6E 67 65 29 0D 0A 20 20 20 20 67 20 3C 61 64 64 72 3E 20 20 20 20 20 20 28 47 6F 20 2F 20 52 75 6E 29 0D 0A 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 3D 0D 0A 00]

        msg_prompt:
03F8        .asciz "> "                            ; [3E 20 00]

03F9    msg_colon:                                 ; [00]
03FA        .asciz ": "                            ; [3A 20 00]

03FB    msg_unknown:                               ; [00]
03FC        .asciz "Unknown command. Use 'e <addr>', 'c <addr> <val>', or 'g <addr>'\r\n" ; [55 6E 6B 6E 6F 77 6E 20 63 6F 6D 6D 61 6E 64 2E 20 55 73 65 20 27 65 20 3C 61 64 64 72 3E 27 2C 20 27 63 20 3C 61 64 64 72 3E 20 3C 76 61 6C 3E 27 2C 20 6F 72 20 27 67 20 3C 61 64 64 72 3E 27 0D 0A 00]

041D    msg_wrote:                                 ; [00]
041E        .asciz "Wrote "                        ; [57 72 6F 74 65 20 00]

0421    msg_to:                                    ; [00]
0422        .asciz " to ["                         ; [20 74 6F 20 5B 00]

        msg_bracket_nl:
0425        .asciz "]\r\n"                         ; [5D 0D 0A 00]

        msg_running:
0427        .asciz "Running at ["                  ; [52 75 6E 6E 69 6E 67 20 61 74 20 5B 00]

042D    msg_run_tail:                              ; [00]
042E        .asciz "]...\r\n"                      ; [5D 2E 2E 2E 0D 0A 00]

0431    msg_returned:                              ; [00]
0432        .asciz "\r\n[Program returned to monitor]\r\n" ; [0D 0A 5B 50 72 6F 67 72 61 6D 20 72 65 74 75 72 6E 65 64 20 74 6F 20 6D 6F 6E 69 74 6F 72 5D 0D 0A 00]

        next_examine_addr:
0443        .word 0x0000                           ; [00 00]

        dump_ptr:
0444        .word 0x0000                           ; [00 00]

        dump_cnt:
0445        .word 0x0000                           ; [00 00]

        line_buffer:
0446        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
044E        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
0456        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]
045E        .word 0, 0, 0, 0, 0, 0, 0, 0           ; [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00]

; ==============================================================================
; Runtime Library Inclusion at the Bottom
; ==============================================================================
; ==============================================================================
; FILE: lib/M4R_LIB.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Math & Relational Runtime Subroutine Library for MiniRISC4.
;   Provides 16-bit unsigned multiplication (MULT), restoring integer division (DIV),
;   modulo/remainder (MOD), and unsigned relational comparisons (_CMP_*).
;
; Table of Contents:
;   1. SUBROUTINE: MULT        - 16-bit unsigned binary multiplication
;   2. HELPER:     DIVMOD_CORE - 16-bit binary restoring division engine
;   3. SUBROUTINE: DIV         - 16-bit unsigned integer division
;   4. SUBROUTINE: MOD         - 16-bit unsigned integer remainder / modulo
;   5. RELATIONAL: _CMP_LT     - Unsigned Less-Than comparison (<)
;   6. RELATIONAL: _CMP_LE     - Unsigned Less-Than-or-Equal comparison (<=)
;   7. RELATIONAL: _CMP_GT     - Unsigned Greater-Than comparison (>)
;   8. RELATIONAL: _CMP_GE     - Unsigned Greater-Than-or-Equal comparison (>=)
;
; Calling Conventions & Stack Rules:
;   - Argument Stack (ASP @ 0x0005, Base 0xFAFF):
;       Math routines (MULT, DIV, MOD) receive operands on the Argument Stack.
;       Binary operands (A op B):
;         Top of Stack (first popped)  : Operand B (RHS / Multiplier / Divisor)
;         Second on Stack (next popped): Operand A (LHS / Multiplicand / Dividend)
;       Result is pushed back onto the Argument Stack and returned in R1.
;   - Return Stack (RSP @ 0x0004, Base 0xFEFF):
;       All routines preserve caller return linkage on the Return Stack via
;       RPUSH R0 upon entry, returning via RRET (RPOP R0; JMP R0).
;   - Comparison Helpers (_CMP_*):
;       Operands passed in primary registers: R1 = LHS (A), R2 = RHS (B).
;       Boolean result returned in R1 (1 = True, 0 = False).
;   - Register-Indirect Branching:
;       All branches (JMP, JMP.Z, JMP.M, LINK) are strictly register-indirect.
;       Target addresses are pre-loaded into registers via LOAD16 prior to branching.
; ==============================================================================


; ==============================================================================
; SECTION 1: 16-Bit Binary Multiplication (MULT)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MULT
; Description:
;   Performs 16-bit unsigned multiplication: Product = A * B (modulo 65536).
;   Uses the classic shift-and-add binary multiplication algorithm with an
;   explicit 16-step iteration counter.
;
; Algorithm:
;   1. Pop Multiplier (B) into R2 and Multiplicand (A) into R1 from ASP.
;   2. Clear product accumulator (R3 = 0).
;   3. For each of the 16 bits:
;      a. Test LSB of Multiplier by rotating right (ROT.R R2) into bit 15 (sign bit).
;      b. If bit 15 is 1, jump to _MULT_ADD to add Multiplicand to Accumulator.
;      c. Restore Multiplier bit alignment (ROT.L R2), shift Multiplier right by 1,
;         and shift Multiplicand left by 1.
;      d. Decrement loop counter. Exit early if Multiplier reaches 0.
;   4. Return 16-bit product in R1 and push onto ASP.
;
; Stack Layout:
;   Entry: [ASP]   = Multiplier (B)
;          [ASP+1] = Multiplicand (A)
;   Exit:  [ASP]   = Product (A * B & 0xFFFF)
;
; Registers:
;   R1 = Multiplicand (A) -> Product output
;   R2 = Multiplier (B)
;   R3 = Product Accumulator (caller R3 preserved in shadow_r[3])
;   shadow_r[0] = 16-step loop counter
; ==============================================================================
        MULT:
0466        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0466        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Pop operands from Argument Stack (0x0005)
046B        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
046B        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0471        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0471        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]

    ; Free R3 to act as product accumulator; preserve caller R3 in hardware shadow
0476        XCHG    R3                  ; shadow_r[3] = caller R3 ; [BF]
0477        XOR     R3, R3                         ; [9F]

    ; Initialize 16-iteration loop counter in shadow_r[0]
0477        XCHG    R0                  ; shadow_r[0] = caller R0 ; [BC]
0478        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
0478        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
047A        XCHG    R0                  ; R0 restored; shadow_r[0] = 16 ; [BC]

047A    _MULT_LOOP:                                ; [00]
    ; Optimization: check if remaining Multiplier bits are zero -> exit early
047B        PUSH8   R0, >(_MULT_DONE)              ; [F8 04 F8 8F]
047B        PUSH8   R0, <(_MULT_DONE)              ; [F8 04 F8 8F]
047D        JMP.Z   R0, R2              ; If R2 == 0, multiplication complete ; [D2]

    ; Test LSB (bit 0) of Multiplier: rotate right shifts bit 0 into bit 15 (sign bit)
047D        ROT.R   R2                             ; [C6]
047E        PUSH8   R0, >(_MULT_ADD)               ; [F8 04 F8 85]
047E        PUSH8   R0, <(_MULT_ADD)               ; [F8 04 F8 85]
0480        JMP.M   R0, R2              ; If bit 15 is 1 (negative), bit 0 was set -> add ; [E2]

    ; Bit 0 was 0: no addition, proceed with bit shifts
0480        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0481        SHIFT.R R2                  ; Multiplier >>= 1 (logical right shift) ; [B6]
0481        SHIFT.L R1                  ; Multiplicand <<= 1 (logical left shift) ; [B1]
0482        PUSH8   R0, >(_MULT_DEC)               ; [F8 04 F8 87]
0482        PUSH8   R0, <(_MULT_DEC)               ; [F8 04 F8 87]
0484        JMP     R0                  ; Decrement iteration counter ; [F0]

0484    _MULT_ADD:                                 ; [00]
0485        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0485        ADD     R3, R1              ; Accumulator += Multiplicand ; [6D]
0486        SHIFT.R R2                  ; Multiplier >>= 1 ; [B6]
0486        SHIFT.L R1                  ; Multiplicand <<= 1 ; [B1]

        _MULT_DEC:
0487        XCHG    R0                  ; Access loop counter from shadow_r[0] ; [BC]
0487        DEC     R0                  ; counter-- ; [CC]
0488        PUSH8   R1, >(_MULT_DONE_CTR)          ; [F9 04 F9 8E]
0488        PUSH8   R1, <(_MULT_DONE_CTR)          ; [F9 04 F9 8E]
048A        JMP.Z   R1, R0              ; If counter == 0, loop finished ; [D4]
048A        XCHG    R0                  ; Save updated counter back to shadow_r[0] ; [BC]

048B        PUSH8   R0, >(_MULT_LOOP)              ; [F8 04 F8 7B]
048B        PUSH8   R0, <(_MULT_LOOP)              ; [F8 04 F8 7B]
048D        JMP     R0                             ; [F0]

048D    _MULT_DONE_CTR:                            ; [00]
048E        XCHG    R0                  ; Restore shadow_r[0] / caller R0 ; [BC]

048E    _MULT_DONE:                                ; [00]
048F        LD      R1, R3              ; R1 = Final 16-bit Product ; [07]
048F        XCHG    R3                  ; Restore caller R3 from shadow_r[3] ; [BF]
0490        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0490        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0495        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0495        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 2: 16-Bit Restoring Division Engine (DIVMOD_CORE)
; ==============================================================================

; ==============================================================================
; HELPER: DIVMOD_CORE
; Description:
;   Core 16-bit unsigned restoring division routine.
;   Computes both quotient and remainder simultaneously using shift-and-subtract.
;
; Inputs:
;   R1 = Dividend (N)
;   R2 = Divisor (D)
; Outputs:
;   R1 = Quotient (N / D)
;   R3 = Remainder (N % D)
;
; Special Cases:
;   Division by Zero: If D == 0, returns Quotient = 0xFFFF, Remainder = Dividend (N).
;
; Registers:
;   R1 = Dividend (shifts left; quotient bits shifted into LSB) -> returns Quotient
;   R2 = Divisor (preserved in shadow_r[2] during loop)
;   R3 = Remainder accumulator -> returns Remainder
;   shadow_r[0] = 16-iteration loop counter
; ==============================================================================
049B    DIVMOD_CORE:                               ; [00]
049C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
049C        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Check for divide-by-zero condition (Divisor R2 == 0)
04A1        PUSH8   R0, >(_DIV_ZERO)               ; [00 F8 04 F8 CE]
04A1        PUSH8   R0, <(_DIV_ZERO)               ; [00 F8 04 F8 CE]
04A4        JMP.Z   R0, R2              ; If R2 == 0, branch to error handler ; [D2]

04A4        XOR     R3, R3                         ; [9F]

    ; Preserve Divisor in shadow_r[2] so R2 is available for branch scratch
04A5        XCHG    R2                             ; [BE]

    ; Initialize 16-bit loop counter in shadow_r[0]
04A5        XCHG    R0                             ; [BC]
04A6        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
04A6        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
04A8        XCHG    R0                             ; [BC]

04A8    _DIV_BIT_LOOP:                             ; [00]
04A9        SHIFT.L R3                  ; Remainder <<= 1 ; [B3]

    ; Shift MSB of Dividend into LSB of Remainder
04A9        PUSH8   R2, >(_DIV_CARRY_IN)           ; [00 FA 04 FA B0]
04A9        PUSH8   R2, <(_DIV_CARRY_IN)           ; [00 FA 04 FA B0]
04AC        JMP.M   R2, R1              ; Test bit 15 (MSB) of Dividend ; [E9]

04AC        PUSH8   R2, >(_DIV_SHIFT_CONT)         ; [00 FA 04 FA B1]
04AC        PUSH8   R2, <(_DIV_SHIFT_CONT)         ; [00 FA 04 FA B1]
04AF        JMP     R2                             ; [F2]

04AF    _DIV_CARRY_IN:                             ; [00]
04B0        INC     R3                  ; Remainder |= 1 (MSB shifted out of Dividend was 1) ; [CB]

04B0    _DIV_SHIFT_CONT:                           ; [00]
04B1        SHIFT.L R1                  ; Dividend <<= 1 (shifts quotient bit into LSB) ; [B1]

    ; Compare current Remainder (R3) with Divisor (held in shadow_r[2])
04B1        XCHG    R2                  ; R2 = Divisor, shadow_r[2] = scratch ; [BE]
04B2        XCHG    R0                  ; R0 = loop counter, shadow_r[0] = scratch ; [BC]
04B2        XCHG    R0                  ; Restore R0 ; [BC]

    ; Compute test trial subtraction: difference = Remainder - Divisor
04B3        XCHG    R0                             ; [BC]
04B3        LD      R0, R3                         ; [03]
04B4        SUB     R0, R2              ; R0 = Remainder - Divisor ; [72]
04B4        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Check if trial subtraction produced a negative result
04B5        XCHG    R0                  ; R0 = difference ; [BC]
04B5        PUSH8   R2, >(_DIV_NO_SUB)             ; [00 FA 04 FA BE]
04B5        PUSH8   R2, <(_DIV_NO_SUB)             ; [00 FA 04 FA BE]
04B8        JMP.M   R2, R0              ; If negative, cannot subtract -> skip ; [E8]
04B8        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Successful subtraction: Remainder gets difference, Quotient LSB = 1
04B9        XCHG    R0                             ; [BC]
04B9        LD      R3, R0              ; Remainder = difference (subtraction committed) ; [0C]
04BA        XCHG    R0                             ; [BC]
04BA        INC     R1                  ; Quotient LSB = 1 ; [C9]

04BB        PUSH8   R2, >(_DIV_DEC_LOOP)           ; [FA 04 FA BF]
04BB        PUSH8   R2, <(_DIV_DEC_LOOP)           ; [FA 04 FA BF]
04BD        JMP     R2                             ; [F2]

04BD    _DIV_NO_SUB:                               ; [00]
04BE        XCHG    R0                  ; Restore R0 ; [BC]

04BE    _DIV_DEC_LOOP:                             ; [00]
04BF        XCHG    R2                  ; Restore Divisor back into shadow_r[2] ; [BE]
04BF        XCHG    R0                  ; Access loop counter ; [BC]
04C0        DEC     R0                  ; counter-- ; [CC]
04C0        PUSH8   R2, >(_DIV_EXIT)               ; [00 FA 04 FA C7]
04C0        PUSH8   R2, <(_DIV_EXIT)               ; [00 FA 04 FA C7]
04C3        JMP.Z   R2, R0              ; If counter == 0, division complete ; [D8]
04C3        XCHG    R0                  ; Save counter back to shadow_r[0] ; [BC]

04C4        PUSH8   R0, >(_DIV_BIT_LOOP)           ; [F8 04 F8 A9]
04C4        PUSH8   R0, <(_DIV_BIT_LOOP)           ; [F8 04 F8 A9]
04C6        JMP     R0                             ; [F0]

04C6    _DIV_EXIT:                                 ; [00]
04C7        XCHG    R0                  ; Restore original R0 ; [BC]
04C7        XCHG    R2                  ; Restore original R2 (Divisor) ; [BE]
04C8        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04C8        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _DIV_ZERO:
    ; Divide by zero: Remainder = original Dividend, Quotient = 0xFFFF
04CE        LD      R3, R1              ; Remainder = Dividend ; [0D]
04CE        XOR     R1, R1                         ; [95]
04CF        DEC     R1                  ; R1 = 0xFFFF (standard unsigned error quotient) ; [CD]
04CF        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04CF        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 3: 16-Bit Unsigned Integer Division (DIV)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: DIV
; Description:
;   16-bit unsigned integer division: Quotient = Dividend / Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Quotient (N / D)
; Register : R1 = Quotient
; ==============================================================================
04D5    DIV:                                       ; [00]
04D6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04D6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04DB        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04DB        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04E1        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E1        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
04E6        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 04 F8 9C F4 00]
04E6        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 04 F8 9C F4 00]
04E6        LINK    R0, R0                         ; [00 F8 04 F8 9C F4 00]
04EA        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EA        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
04EF        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
04EF        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 4: 16-Bit Unsigned Integer Modulo (MOD)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MOD
; Description:
;   16-bit unsigned integer remainder: Remainder = Dividend % Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Remainder (N % D)
; Register : R1 = Remainder
; ==============================================================================
04F5    MOD:                                       ; [00]
04F6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04F6        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
04FB        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
04FB        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0501        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0501        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0506        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 04 F8 9C F4 00]
0506        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 04 F8 9C F4 00]
0506        LINK    R0, R0                         ; [00 F8 04 F8 9C F4 00]
050A        LD      R1, R3              ; Move Remainder to return register R1 ; [07]
050A        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
050A        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0510        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0510        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 5: Unsigned Relational Comparisons (_CMP_LT, _CMP_LE, _CMP_GT, _CMP_GE)
; Description:
;   Evaluates 16-bit unsigned inequalities across the entire 0x0000-0xFFFF range.
;   Because MiniRISC4 only supports JMP.M (sign bit is 1) and JMP.Z (zero) on
;   register contents, unsigned comparison must differentiate between numbers
;   with differing MSBs (where bit 15 represents the 0x8000 boundary) and numbers
;   with identical MSBs (where standard subtraction gives the correct magnitude).
;
; Inputs:
;   R1 = Left-Hand Side (LHS / A)
;   R2 = Right-Hand Side (RHS / B)
; Outputs:
;   R1 = 1 if the condition is True
;   R1 = 0 if the condition is False
; ==============================================================================

; ==============================================================================
; SUBROUTINE: _CMP_LT  (Unsigned Less-Than: A < B)
; ==============================================================================
        _CMP_LT:
0516        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0516        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Compare MSBs (bit 15) using XOR
051B        XCHG    R0                             ; [BC]
051C        LD      R0, R1                         ; [01]
051C        XOR     R0, R2              ; If bit 15 is set, operands have opposite signs ; [92]
051D        PUSH8   R3, >(_CMP_LT_DIFF_SIGNS)      ; [FB 05 FB 27]
051D        PUSH8   R3, <(_CMP_LT_DIFF_SIGNS)      ; [FB 05 FB 27]
051F        JMP.M   R3, R0              ; Branch if MSBs are different ; [EC]
051F        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: MSBs are identical -> standard subtraction A - B gives correct relation
0520        SUB     R1, R2              ; R1 = A - B ; [76]
0520        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 05 F8 6A]
0520        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 05 F8 6A]
0523        JMP.M   R0, R1              ; If difference is negative, A < B -> True ; [E1]
0523        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 05 F8 72]
0523        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 05 F8 72]
0526        JMP     R0                  ; Else A >= B -> False ; [F0]

0526    _CMP_LT_DIFF_SIGNS:                        ; [00]
0527        XCHG    R0                  ; Restore R0 ; [BC]
    ; When MSBs differ: the operand with MSB=1 is in range [0x8000..0xFFFF],
    ; while the operand with MSB=0 is in range [0x0000..0x7FFF].
    ; Therefore, if LHS (R1) has bit 15 set, LHS is strictly larger -> False.
0527        PUSH8   R0, >(_CMP_RET_FALSE)          ; [00 F8 05 F8 72]
0527        PUSH8   R0, <(_CMP_RET_FALSE)          ; [00 F8 05 F8 72]
052A        JMP.M   R0, R1              ; If R1[15] == 1, A > B -> False ; [E1]
052A        PUSH8   R0, >(_CMP_RET_TRUE)           ; [00 F8 05 F8 6A]
052A        PUSH8   R0, <(_CMP_RET_TRUE)           ; [00 F8 05 F8 6A]
052D        JMP     R0                  ; Else A < B -> True ; [F0]

; ==============================================================================
; SUBROUTINE: _CMP_LE  (Unsigned Less-Than-or-Equal: A <= B)
; ==============================================================================
052D    _CMP_LE:                                   ; [00]
052E        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
052E        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Step 1: Check equality (A == B)
0533        XCHG    R0                             ; [BC]
0534        LD      R0, R1                         ; [01]
0534        SUB     R0, R2              ; Test difference A - B ; [72]
0535        PUSH8   R3, >(_CMP_LE_EQUAL)           ; [FB 05 FB 41]
0535        PUSH8   R3, <(_CMP_LE_EQUAL)           ; [FB 05 FB 41]
0537        JMP.Z   R3, R0              ; If A == B, branch to True ; [DC]
0537        XCHG    R0                  ; Restore R0 ; [BC]

    ; Step 2: Not equal -> evaluate A < B
0538        PUSH8   R0, >(_CMP_LT)                 ; [F8 05 F8 16 F4 00]
0538        PUSH8   R0, <(_CMP_LT)                 ; [F8 05 F8 16 F4 00]
0538        LINK    R0, R0                         ; [F8 05 F8 16 F4 00]
053B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
053B        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _CMP_LE_EQUAL:
0541        XCHG    R0                  ; Restore R0 ; [BC]
0541        PUSH8   R1, >(1)                       ; [00 F9 00 F9 01]
0541        PUSH8   R1, <(1)                       ; [00 F9 00 F9 01]
0544        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0544        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

; ==============================================================================
; SUBROUTINE: _CMP_GT  (Unsigned Greater-Than: A > B)
; Note: A > B is logically equivalent to B < A
; ==============================================================================
        _CMP_GT:
054A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
054A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
