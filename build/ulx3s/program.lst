0374        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0374        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; R0 = 9 - R1 (negative if R1 >= 10, i.e. 'A'-'F')
0379        PUSH8   R0, >(9)                       ; [00 F8 00 F8 09]
0379        PUSH8   R0, <(9)                       ; [00 F8 00 F8 09]
037C        SUB     R0, R1                         ; [71]
037C        PUSH8   R3, >(.hex_letter)             ; [00 FB 03 FB 94]
037C        PUSH8   R3, <(.hex_letter)             ; [00 FB 03 FB 94]
037F        JMP.M   R3, R0              ; Jump directly on negative result ; [EC]

    ; Digit '0'-'9': ASCII = R1 + 48
037F        PUSH8   R0, >(48)                      ; [00 F8 00 F8 30]
037F        PUSH8   R0, <(48)                      ; [00 F8 00 F8 30]
