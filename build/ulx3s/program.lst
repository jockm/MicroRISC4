0100        ; 1. Initialize Return Stack Pointer (RSP) at [0x0004] = 0xFEFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        PUSH8   R1, >(RSP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        PUSH8   R1, <(RSP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        LD      R0, 4               ; R0 = 0x0004 (RSP scratchpad address) ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        LD      (R0), R1            ; [0x0004] = 0xFEFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100                                               ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        ; 2. Initialize Argument Stack Pointer (ASP) at [0x0005] = 0xFAFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        PUSH8   R1, >(ASP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        PUSH8   R1, <(ASP_INIT)                ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        INC     R0                  ; R0 = 0x0005 (ASP scratchpad address) ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        LD      (R0), R1            ; [0x0005] = 0xFAFF ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100                                               ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        ; 3. Jump to the main function         ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        PUSH8   R0, >(_main)                   ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        PUSH8   R0, <(_main)                   ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]
0100        JMP     R0                  ; Unconditional register-indirect jump to _main ; [F9 FE F9 FF 14 31 F9 FA F9 FF C8 31 F8 09 F8 B9 F0]

