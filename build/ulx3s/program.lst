; ==============================================================================
; Standard Runtime Library (placed after application code & data)
; ==============================================================================
; ==============================================================================
; FILE: lib/M4R_LIB.asm
; Architecture: MiniRISC4 16-Bit Word-Addressed Processor
; Target Hardware: Lattice ECP5 FPGA (ULX3S) / Verilog Core
; Description:
;   Standard Math & Relational Runtime Subroutine Library for MiniRISC4.
;   Provides 16-bit unsigned multiplication (MULT), restoring integer division (DIV),
;   modulo/remainder (MOD), and unsigned relational comparisons (_CMP_*).
;
; Table of Contents:
;   1. SUBROUTINE: MULT        - 16-bit unsigned binary multiplication
;   2. HELPER:     DIVMOD_CORE - 16-bit binary restoring division engine
;   3. SUBROUTINE: DIV         - 16-bit unsigned integer division
;   4. SUBROUTINE: MOD         - 16-bit unsigned integer remainder / modulo
;   5. RELATIONAL: _CMP_LT     - Unsigned Less-Than comparison (<)
;   6. RELATIONAL: _CMP_LE     - Unsigned Less-Than-or-Equal comparison (<=)
;   7. RELATIONAL: _CMP_GT     - Unsigned Greater-Than comparison (>)
;   8. RELATIONAL: _CMP_GE     - Unsigned Greater-Than-or-Equal comparison (>=)
;
; Calling Conventions & Stack Rules:
;   - Argument Stack (ASP @ 0x0005, Base 0xFAFF):
;       Math routines (MULT, DIV, MOD) receive operands on the Argument Stack.
;       Binary operands (A op B):
;         Top of Stack (first popped)  : Operand B (RHS / Multiplier / Divisor)
;         Second on Stack (next popped): Operand A (LHS / Multiplicand / Dividend)
;       Result is pushed back onto the Argument Stack and returned in R1.
;   - Return Stack (RSP @ 0x0004, Base 0xFEFF):
;       All routines preserve caller return linkage on the Return Stack via
;       RPUSH R0 upon entry, returning via RRET (RPOP R0; JMP R0).
;   - Comparison Helpers (_CMP_*):
;       Operands passed in primary registers: R1 = LHS (A), R2 = RHS (B).
;       Boolean result returned in R1 (1 = True, 0 = False).
;   - Register-Indirect Branching:
;       All branches (JMP, JMP.Z, JMP.M, LINK) are strictly register-indirect.
;       Target addresses are pre-loaded into registers via LOAD16 prior to branching.
; ==============================================================================


; ==============================================================================
; SECTION 1: 16-Bit Binary Multiplication (MULT)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MULT
; Description:
;   Performs 16-bit unsigned multiplication: Product = A * B (modulo 65536).
;   Uses the classic shift-and-add binary multiplication algorithm with an
;   explicit 16-step iteration counter.
;
; Algorithm:
;   1. Pop Multiplier (B) into R2 and Multiplicand (A) into R1 from ASP.
;   2. Clear product accumulator (R3 = 0).
;   3. For each of the 16 bits:
;      a. Test LSB of Multiplier by rotating right (ROT.R R2) into bit 15 (sign bit).
;      b. If bit 15 is 1, jump to _MULT_ADD to add Multiplicand to Accumulator.
;      c. Restore Multiplier bit alignment (ROT.L R2), shift Multiplier right by 1,
;         and shift Multiplicand left by 1.
;      d. Decrement loop counter. Exit early if Multiplier reaches 0.
;   4. Return 16-bit product in R1 and push onto ASP.
;
; Stack Layout:
;   Entry: [ASP]   = Multiplier (B)
;          [ASP+1] = Multiplicand (A)
;   Exit:  [ASP]   = Product (A * B & 0xFFFF)
;
; Registers:
;   R1 = Multiplicand (A) -> Product output
;   R2 = Multiplier (B)
;   R3 = Product Accumulator (caller R3 preserved in shadow_r[3])
;   shadow_r[0] = 16-step loop counter
; ==============================================================================
0C89    MULT:                                      ; [00]
0C8A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0C8A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Pop operands from Argument Stack (0x0005)
0C8F        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C8F        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0C95        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0C95        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]

    ; Free R3 to act as product accumulator; preserve caller R3 in hardware shadow
0C9A        XCHG    R3                  ; shadow_r[3] = caller R3 ; [BF]
0C9B        XOR     R3, R3                         ; [9F]

    ; Initialize 16-iteration loop counter in shadow_r[0]
0C9B        XCHG    R0                  ; shadow_r[0] = caller R0 ; [BC]
0C9C        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
0C9C        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
0C9E        XCHG    R0                  ; R0 restored; shadow_r[0] = 16 ; [BC]

0C9E    _MULT_LOOP:                                ; [00]
    ; Optimization: check if remaining Multiplier bits are zero -> exit early
0C9F        PUSH8   R0, >(_MULT_DONE)              ; [F8 0C F8 B3]
0C9F        PUSH8   R0, <(_MULT_DONE)              ; [F8 0C F8 B3]
0CA1        JMP.Z   R0, R2              ; If R2 == 0, multiplication complete ; [D2]

    ; Test LSB (bit 0) of Multiplier: rotate right shifts bit 0 into bit 15 (sign bit)
0CA1        ROT.R   R2                             ; [C6]
0CA2        PUSH8   R0, >(_MULT_ADD)               ; [F8 0C F8 A9]
0CA2        PUSH8   R0, <(_MULT_ADD)               ; [F8 0C F8 A9]
0CA4        JMP.M   R0, R2              ; If bit 15 is 1 (negative), bit 0 was set -> add ; [E2]

    ; Bit 0 was 0: no addition, proceed with bit shifts
0CA4        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0CA5        SHIFT.R R2                  ; Multiplier >>= 1 (logical right shift) ; [B6]
0CA5        SHIFT.L R1                  ; Multiplicand <<= 1 (logical left shift) ; [B1]
0CA6        PUSH8   R0, >(_MULT_DEC)               ; [F8 0C F8 AB]
0CA6        PUSH8   R0, <(_MULT_DEC)               ; [F8 0C F8 AB]
0CA8        JMP     R0                  ; Decrement iteration counter ; [F0]

0CA8    _MULT_ADD:                                 ; [00]
0CA9        ROT.L   R2                  ; Restore original bit alignment of R2 ; [C2]
0CA9        ADD     R3, R1              ; Accumulator += Multiplicand ; [6D]
0CAA        SHIFT.R R2                  ; Multiplier >>= 1 ; [B6]
0CAA        SHIFT.L R1                  ; Multiplicand <<= 1 ; [B1]

        _MULT_DEC:
0CAB        XCHG    R0                  ; Access loop counter from shadow_r[0] ; [BC]
0CAB        DEC     R0                  ; counter-- ; [CC]
0CAC        PUSH8   R1, >(_MULT_DONE_CTR)          ; [F9 0C F9 B2]
0CAC        PUSH8   R1, <(_MULT_DONE_CTR)          ; [F9 0C F9 B2]
0CAE        JMP.Z   R1, R0              ; If counter == 0, loop finished ; [D4]
0CAE        XCHG    R0                  ; Save updated counter back to shadow_r[0] ; [BC]

0CAF        PUSH8   R0, >(_MULT_LOOP)              ; [F8 0C F8 9F]
0CAF        PUSH8   R0, <(_MULT_LOOP)              ; [F8 0C F8 9F]
0CB1        JMP     R0                             ; [F0]

0CB1    _MULT_DONE_CTR:                            ; [00]
0CB2        XCHG    R0                  ; Restore shadow_r[0] / caller R0 ; [BC]

0CB2    _MULT_DONE:                                ; [00]
0CB3        LD      R1, R3              ; R1 = Final 16-bit Product ; [07]
0CB3        XCHG    R3                  ; Restore caller R3 from shadow_r[3] ; [BF]
0CB4        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB4        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0CB9        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CB9        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 2: 16-Bit Restoring Division Engine (DIVMOD_CORE)
; ==============================================================================

; ==============================================================================
; HELPER: DIVMOD_CORE
; Description:
;   Core 16-bit unsigned restoring division routine.
;   Computes both quotient and remainder simultaneously using shift-and-subtract.
;
; Inputs:
;   R1 = Dividend (N)
;   R2 = Divisor (D)
; Outputs:
;   R1 = Quotient (N / D)
;   R3 = Remainder (N % D)
;
; Special Cases:
;   Division by Zero: If D == 0, returns Quotient = 0xFFFF, Remainder = Dividend (N).
;
; Registers:
;   R1 = Dividend (shifts left; quotient bits shifted into LSB) -> returns Quotient
;   R2 = Divisor (preserved in shadow_r[2] during loop)
;   R3 = Remainder accumulator -> returns Remainder
;   shadow_r[0] = 16-iteration loop counter
; ==============================================================================
0CBF    DIVMOD_CORE:                               ; [00]
0CC0        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CC0        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]

    ; Check for divide-by-zero condition (Divisor R2 == 0)
0CC5        PUSH8   R0, >(_DIV_ZERO)               ; [00 F8 0C F8 F2]
0CC5        PUSH8   R0, <(_DIV_ZERO)               ; [00 F8 0C F8 F2]
0CC8        JMP.Z   R0, R2              ; If R2 == 0, branch to error handler ; [D2]

0CC8        XOR     R3, R3                         ; [9F]

    ; Preserve Divisor in shadow_r[2] so R2 is available for branch scratch
0CC9        XCHG    R2                             ; [BE]

    ; Initialize 16-bit loop counter in shadow_r[0]
0CC9        XCHG    R0                             ; [BC]
0CCA        PUSH8   R0, >(16)                      ; [F8 00 F8 10]
0CCA        PUSH8   R0, <(16)                      ; [F8 00 F8 10]
0CCC        XCHG    R0                             ; [BC]

0CCC    _DIV_BIT_LOOP:                             ; [00]
0CCD        SHIFT.L R3                  ; Remainder <<= 1 ; [B3]

    ; Shift MSB of Dividend into LSB of Remainder
0CCD        PUSH8   R2, >(_DIV_CARRY_IN)           ; [00 FA 0C FA D4]
0CCD        PUSH8   R2, <(_DIV_CARRY_IN)           ; [00 FA 0C FA D4]
0CD0        JMP.M   R2, R1              ; Test bit 15 (MSB) of Dividend ; [E9]

0CD0        PUSH8   R2, >(_DIV_SHIFT_CONT)         ; [00 FA 0C FA D5]
0CD0        PUSH8   R2, <(_DIV_SHIFT_CONT)         ; [00 FA 0C FA D5]
0CD3        JMP     R2                             ; [F2]

0CD3    _DIV_CARRY_IN:                             ; [00]
0CD4        INC     R3                  ; Remainder |= 1 (MSB shifted out of Dividend was 1) ; [CB]

0CD4    _DIV_SHIFT_CONT:                           ; [00]
0CD5        SHIFT.L R1                  ; Dividend <<= 1 (shifts quotient bit into LSB) ; [B1]

    ; Compare current Remainder (R3) with Divisor (held in shadow_r[2])
0CD5        XCHG    R2                  ; R2 = Divisor, shadow_r[2] = scratch ; [BE]
0CD6        XCHG    R0                  ; R0 = loop counter, shadow_r[0] = scratch ; [BC]
0CD6        XCHG    R0                  ; Restore R0 ; [BC]

    ; Compute test trial subtraction: difference = Remainder - Divisor
0CD7        XCHG    R0                             ; [BC]
0CD7        LD      R0, R3                         ; [03]
0CD8        SUB     R0, R2              ; R0 = Remainder - Divisor ; [72]
0CD8        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Check if trial subtraction produced a negative result
0CD9        XCHG    R0                  ; R0 = difference ; [BC]
0CD9        PUSH8   R2, >(_DIV_NO_SUB)             ; [00 FA 0C FA E2]
0CD9        PUSH8   R2, <(_DIV_NO_SUB)             ; [00 FA 0C FA E2]
0CDC        JMP.M   R2, R0              ; If negative, cannot subtract -> skip ; [E8]
0CDC        XCHG    R0                  ; shadow_r[0] = difference, R0 restored ; [BC]

    ; Successful subtraction: Remainder gets difference, Quotient LSB = 1
0CDD        XCHG    R0                             ; [BC]
0CDD        LD      R3, R0              ; Remainder = difference (subtraction committed) ; [0C]
0CDE        XCHG    R0                             ; [BC]
0CDE        INC     R1                  ; Quotient LSB = 1 ; [C9]

0CDF        PUSH8   R2, >(_DIV_DEC_LOOP)           ; [FA 0C FA E3]
0CDF        PUSH8   R2, <(_DIV_DEC_LOOP)           ; [FA 0C FA E3]
0CE1        JMP     R2                             ; [F2]

0CE1    _DIV_NO_SUB:                               ; [00]
0CE2        XCHG    R0                  ; Restore R0 ; [BC]

0CE2    _DIV_DEC_LOOP:                             ; [00]
0CE3        XCHG    R2                  ; Restore Divisor back into shadow_r[2] ; [BE]
0CE3        XCHG    R0                  ; Access loop counter ; [BC]
0CE4        DEC     R0                  ; counter-- ; [CC]
0CE4        PUSH8   R2, >(_DIV_EXIT)               ; [00 FA 0C FA EB]
0CE4        PUSH8   R2, <(_DIV_EXIT)               ; [00 FA 0C FA EB]
0CE7        JMP.Z   R2, R0              ; If counter == 0, division complete ; [D8]
0CE7        XCHG    R0                  ; Save counter back to shadow_r[0] ; [BC]

0CE8        PUSH8   R0, >(_DIV_BIT_LOOP)           ; [F8 0C F8 CD]
0CE8        PUSH8   R0, <(_DIV_BIT_LOOP)           ; [F8 0C F8 CD]
0CEA        JMP     R0                             ; [F0]

0CEA    _DIV_EXIT:                                 ; [00]
0CEB        XCHG    R0                  ; Restore original R0 ; [BC]
0CEB        XCHG    R2                  ; Restore original R2 (Divisor) ; [BE]
0CEC        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CEC        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]

        _DIV_ZERO:
    ; Divide by zero: Remainder = original Dividend, Quotient = 0xFFFF
0CF2        LD      R3, R1              ; Remainder = Dividend ; [0D]
0CF2        XOR     R1, R1                         ; [95]
0CF3        DEC     R1                  ; R1 = 0xFFFF (standard unsigned error quotient) ; [CD]
0CF3        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0CF3        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 3: 16-Bit Unsigned Integer Division (DIV)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: DIV
; Description:
;   16-bit unsigned integer division: Quotient = Dividend / Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Quotient (N / D)
; Register : R1 = Quotient
; ==============================================================================
0CF9    DIV:                                       ; [00]
0CFA        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFA        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0CFF        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0CFF        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D05        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D05        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D0A        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 0C F8 C0 F4 00]
0D0A        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 0C F8 C0 F4 00]
0D0A        LINK    R0, R0                         ; [00 F8 0C F8 C0 F4 00]
0D0E        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D0E        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D13        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        LD      R0, (R3++)                     ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]
0D13        JMP     R0                             ; [BE BF BC 14 08 BC 2E 43 3B BF BE F0]


; ==============================================================================
; SECTION 4: 16-Bit Unsigned Integer Modulo (MOD)
; ==============================================================================

; ==============================================================================
; SUBROUTINE: MOD
; Description:
;   16-bit unsigned integer remainder: Remainder = Dividend % Divisor.
; Stack In : [ASP]   = Divisor (D)
;            [ASP+1] = Dividend (N)
; Stack Out: [ASP]   = Remainder (N % D)
; Register : R1 = Remainder
; ==============================================================================
0D19    MOD:                                       ; [00]
0D1A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        LD      R0, 4                          ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        LD      R2, R0                         ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        XCHG    R0                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        LD      R3, (R2)                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        LD      (--R3), R0                     ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        LD      (R2), R3                       ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        XCHG    R3                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1A        XCHG    R2                             ; [BE BF BC 14 08 BC 2E 5C 3B BF BE]
0D1F        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        LD      R2, (R3++)                     ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D1F        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 4B 3B BF BE]
0D25        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        LD      R1, (R3++)                     ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D25        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 47 3B BF BE]
0D2A        PUSH8   R0, >(DIVMOD_CORE)             ; [00 F8 0C F8 C0 F4 00]
0D2A        PUSH8   R0, <(DIVMOD_CORE)             ; [00 F8 0C F8 C0 F4 00]
0D2A        LINK    R0, R0                         ; [00 F8 0C F8 C0 F4 00]
0D2E        LD      R1, R3              ; Move Remainder to return register R1 ; [07]
0D2E        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        LD      R0, 5                          ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        LD      R2, R0                         ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        XCHG    R0                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        LD      R3, (R2)                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        LD      (--R3), R1                     ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        LD      (R2), R3                       ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        XCHG    R3                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
0D2E        XCHG    R2                             ; [BE BF BC 15 08 BC 2E 5D 3B BF BE]
